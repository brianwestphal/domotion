+class InspectorDomotionAnimatedImageTruthAgent::Transaction final
+    : public GarbageCollected<Transaction> {
+ public:
+  int backend_node_id = 0;
+  String property;
+  int index = 0;
+  String owner_selector_token;
+  int requested_frame_index = 0;
+  String document_nonce;
+  uint64_t navigation_sequence = 0;
+  WeakMember<Node> query_node;
+  WeakMember<Document> document;
+  WeakMember<LocalFrame> frame;
+  WeakMember<ImageResourceContent> content;
+  WeakMember<StyleImage> style_image;
+  WeakMember<Resource> resource;
+  String candidate_facts_sha256;
+  String viewport_sha256;
+  double device_pixel_ratio = 1;
+  int image_set_option_index = -1;
+  String request_id;
+  String request_mode;
+  String credentials_mode;
+  String redirect_sha256;
+  String service_worker_sha256;
+  String cache_sha256;
+  String body_sha256;
+  size_t body_size = 0;
+  String content_logical_id;
+  String resource_logical_id;
+  String exact_sha256;
+  size_t reserved_body_bytes = 0;
+  bool authorized = false;
+
+  String DriftCode(const OwnerResolution& after_owner,
+                   const ResourceResolution& after_resource) const {
+    if (!after_owner.denial_code.empty()) {
+      return after_owner.denial_code;
+    }
+    if (!after_resource.denial_code.empty()) {
+      return after_resource.denial_code;
+    }
+    if (document != after_owner.document || frame != after_owner.frame) {
+      return "navigation-drift";
+    }
+    if (query_node != after_owner.query_node ||
+        content != after_owner.content ||
+        style_image != after_owner.style_image ||
+        candidate_facts_sha256 != after_owner.candidate_facts_sha256 ||
+        viewport_sha256 != after_owner.viewport_sha256 ||
+        device_pixel_ratio != after_owner.device_pixel_ratio ||
+        image_set_option_index != after_owner.image_set_option_index) {
+      return "candidate-drift";
+    }
+    if (resource != after_resource.resource ||
+        request_id != after_resource.request_id) {
+      return "request-drift";
+    }
+    if (request_mode != after_resource.request_mode) {
+      return "request-drift";
+    }
+    if (credentials_mode != after_resource.credentials_mode) {
+      return "credential-mode-mismatch";
+    }
+    if (after_resource.resource &&
+        after_resource.resource->IsCacheValidator()) {
+      return "revalidation-in-flight";
+    }
+    if (redirect_sha256 != after_resource.redirect_sha256) {
+      return "redirect-drift";
+    }
+    if (service_worker_sha256 != after_resource.service_worker_sha256) {
+      return "service-worker-drift";
+    }
+    if (cache_sha256 != after_resource.cache_sha256) {
+      return "cache-entry-drift";
+    }
+    if (body_size != after_resource.body_size) {
+      return "body-length-mismatch";
+    }
+    if (body_sha256 != after_resource.body_sha256) {
+      return "body-digest-mismatch";
+    }
+    return "response-drift";
+  }
+
+  void Trace(Visitor* visitor) const {
+    visitor->Trace(query_node);
+    visitor->Trace(document);
+    visitor->Trace(frame);
+    visitor->Trace(content);
+    visitor->Trace(style_image);
+    visitor->Trace(resource);
+  }
+};
+
+InspectorDomotionAnimatedImageTruthAgent::
+    InspectorDomotionAnimatedImageTruthAgent(InspectedFrames* inspected_frames,
+                                             InspectorNetworkAgent* network,
+                                             const String& session_id)
+    : inspected_frames_(inspected_frames),
+      network_agent_(network),
+      session_id_(session_id) {}
+
+InspectorDomotionAnimatedImageTruthAgent::
+    ~InspectorDomotionAnimatedImageTruthAgent() = default;
+
+void InspectorDomotionAnimatedImageTruthAgent::Trace(Visitor* visitor) const {
+  visitor->Trace(inspected_frames_);
+  visitor->Trace(network_agent_);
+  visitor->Trace(transactions_);
+  visitor->Trace(document_epochs_);
+  InspectorBaseAgent::Trace(visitor);
+}
+
+protocol::Response InspectorDomotionAnimatedImageTruthAgent::begin(
+    int backend_node_id,
+    const String& property,
+    int index,
+    const String& owner_selector_token,
+    int requested_frame_index,
+    const String& limits_fingerprint,
+    String* transaction_id,
+    std::unique_ptr<Dictionary>* record) {
+  if (limits_fingerprint != kLimitsFingerprint) {
+    return protocol::Response::InvalidParams("limits fingerprint mismatch");
+  }
+  if (!IsSafeOwnerSelectorToken(owner_selector_token) ||
+      requested_frame_index < 0) {
+    return protocol::Response::InvalidParams("invalid strict request");
+  }
+  if (transactions_.size() >= kMaximumTransactions) {
+    return protocol::Response::ServerError("body-limit-exceeded");
+  }
+
+  LocalFrame* root = inspected_frames_->Root();
+  if (!root) {
+    return protocol::Response::ServerError("stale-document");
+  }
+  String root_frame_id = IdentifiersFactory::FrameId(root);
+  OwnerResolution owner = ResolveOwner(backend_node_id, property, index);
+  String document_nonce;
+  uint64_t navigation_sequence = 0;
+  if (owner.document) {
+    auto insert = document_epochs_.insert(owner.document, DocumentEpoch());
+    if (insert.is_new_entry) {
+      insert.stored_value->value.nonce = IdentifiersFactory::CreateIdentifier();
+      insert.stored_value->value.navigation_sequence =
+          next_navigation_sequence_++;
+    }
+    document_nonce = insert.stored_value->value.nonce;
+    navigation_sequence = insert.stored_value->value.navigation_sequence;
+  }
+  ResourceResolution resource = ResolveResource(
+      owner, network_agent_->ResourcesDataForDomotionInspector());
+
+  auto* transaction = MakeGarbageCollected<Transaction>();
+  transaction->backend_node_id = backend_node_id;
+  transaction->property = property;
+  transaction->index = index;
+  transaction->owner_selector_token = owner_selector_token;
+  transaction->requested_frame_index = requested_frame_index;
+  transaction->document_nonce = document_nonce;
+  transaction->navigation_sequence = navigation_sequence;
+  transaction->query_node = owner.query_node;
+  transaction->document = owner.document;
+  transaction->frame = owner.frame;
+  transaction->content = owner.content;
+  transaction->style_image = owner.style_image;
+  transaction->resource = resource.resource;
+  transaction->candidate_facts_sha256 = owner.candidate_facts_sha256;
+  transaction->viewport_sha256 = owner.viewport_sha256;
+  transaction->device_pixel_ratio = owner.device_pixel_ratio;
+  transaction->image_set_option_index = owner.image_set_option_index;
+  transaction->request_id = resource.request_id;
+  transaction->request_mode = resource.request_mode;
+  transaction->credentials_mode = resource.credentials_mode;
+  transaction->redirect_sha256 = resource.redirect_sha256;
+  transaction->service_worker_sha256 = resource.service_worker_sha256;
+  transaction->cache_sha256 = resource.cache_sha256;
+  transaction->body_sha256 = resource.body_sha256;
+  transaction->body_size = resource.body_size;
+
+  String denial =
+      !owner.denial_code.empty() ? owner.denial_code : resource.denial_code;
+  if (denial.empty() &&
+      active_body_bytes_ + resource.body_size > kMaximumTransactionBytes) {
+    denial = "body-limit-exceeded";
+  }
+  if (denial.empty()) {
+    transaction->content_logical_id = IdentifiersFactory::CreateIdentifier();
+    transaction->resource_logical_id = IdentifiersFactory::CreateIdentifier();
+    auto base = BuildAuthorizedBase(
+        owner, resource, transaction->content_logical_id,
+        transaction->resource_logical_id, root_frame_id, session_id_,
+        owner_selector_token, requested_frame_index, document_nonce,
+        navigation_sequence);
+    transaction->exact_sha256 = DigestDictionary(*base);
+    transaction->authorized = true;
+    transaction->reserved_body_bytes = resource.body_size;
+    active_body_bytes_ += resource.body_size;
+    *record = FinalizeAuthorizedRecord(*base, transaction->exact_sha256,
+                                       transaction->exact_sha256);
+  } else {
+    *record =
+        BuildDeniedRecord(owner, resource, denial, root_frame_id, session_id_,
+                          owner_selector_token, requested_frame_index,
+                          document_nonce, navigation_sequence);
+    transaction->exact_sha256 = DigestDictionary(**record);
+  }
+
+  *transaction_id = IdentifiersFactory::CreateIdentifier();
+  transactions_.Set(*transaction_id, transaction);
+  return protocol::Response::Success();
+}
+
+protocol::Response InspectorDomotionAnimatedImageTruthAgent::finish(
+    const String& transaction_id,
+    bool* unchanged,
+    std::unique_ptr<Dictionary>* record) {
+  auto found = transactions_.find(transaction_id);
+  if (found == transactions_.end()) {
+    return protocol::Response::InvalidParams("unknown or consumed transaction");
+  }
+  Member<Transaction> transaction = found->value;
+  transactions_.erase(found);
+  if (transaction->reserved_body_bytes <= active_body_bytes_) {
+    active_body_bytes_ -= transaction->reserved_body_bytes;
+  } else {
+    active_body_bytes_ = 0;
+  }
+
+  LocalFrame* root = inspected_frames_->Root();
+  String root_frame_id = root ? IdentifiersFactory::FrameId(root) : String();
+  OwnerResolution owner = ResolveOwner(
+      transaction->backend_node_id, transaction->property, transaction->index);
+  String document_nonce;
+  uint64_t navigation_sequence = 0;
+  if (owner.document) {
+    // An owner can be adopted into a previously unseen document between
+    // begin and finish. Allocate that current document's identity before
+    // emitting the body-free drift denial so its frame/loader/epoch facts
+    // remain source-owned and internally consistent.
+    auto insert = document_epochs_.insert(owner.document, DocumentEpoch());
+    if (insert.is_new_entry) {
+      insert.stored_value->value.nonce =
+          IdentifiersFactory::CreateIdentifier();
+      insert.stored_value->value.navigation_sequence =
+          next_navigation_sequence_++;
+    }
+    document_nonce = insert.stored_value->value.nonce;
+    navigation_sequence = insert.stored_value->value.navigation_sequence;
+  }
+  ResourceResolution resource = ResolveResource(
+      owner, network_agent_->ResourcesDataForDomotionInspector());
+  String denial =
+      !owner.denial_code.empty() ? owner.denial_code : resource.denial_code;
+
+  if (transaction->authorized && denial.empty()) {
+    auto base = BuildAuthorizedBase(
+        owner, resource, transaction->content_logical_id,
+        transaction->resource_logical_id, root_frame_id, session_id_,
+        transaction->owner_selector_token, transaction->requested_frame_index,
+        document_nonce, navigation_sequence);
+    String postflight_sha256 = DigestDictionary(*base);
+    *unchanged = transaction->query_node == owner.query_node &&
+                 transaction->document == owner.document &&
+                 transaction->content == owner.content &&
+                 transaction->style_image == owner.style_image &&
+                 transaction->resource == resource.resource &&
+                 transaction->exact_sha256 == postflight_sha256;
+    if (*unchanged) {
+      *record = FinalizeAuthorizedRecord(*base, transaction->exact_sha256,
+                                         postflight_sha256);
+      return protocol::Response::Success();
+    }
+    denial = transaction->DriftCode(owner, resource);
+  } else if (!transaction->authorized && !denial.empty()) {
+    auto denied = BuildDeniedRecord(
+        owner, resource, denial, root_frame_id, session_id_,
+        transaction->owner_selector_token, transaction->requested_frame_index,
+        document_nonce, navigation_sequence);
+    *unchanged = transaction->exact_sha256 == DigestDictionary(*denied);
+    *record = std::move(denied);
+    return protocol::Response::Success();
+  } else if (denial.empty()) {
+    denial = "response-drift";
+  }
+
+  *unchanged = false;
+  *record = BuildDeniedRecord(owner, resource, denial, root_frame_id,
+                              session_id_, transaction->owner_selector_token,
+                              transaction->requested_frame_index,
+                              document_nonce, navigation_sequence);
+  return protocol::Response::Success();
+}
