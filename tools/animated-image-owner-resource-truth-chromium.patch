+struct ResourceResolution {
+  STACK_ALLOCATED();
+
+ public:
+  Resource* resource = nullptr;
+  const NetworkResourcesData::ResourceData* ledger = nullptr;
+  String request_id;
+  String request_mode;
+  String credentials_mode;
+  String body_sha256;
+  size_t body_size = 0;
+  String redirect_sha256;
+  String response_sha256;
+  String service_worker_controller_version_id;
+  String service_worker_sha256;
+  String cache_sha256;
+  String denial_code;
+};
+
+void AppendRouterSemanticFacts(StringBuilder& facts,
+                               const ServiceWorkerRouterInfo& router) {
+  facts.AppendNumber(
+      router.RuleIdMatched().value_or(std::numeric_limits<uint32_t>::max()));
+  facts.Append('|');
+  if (router.MatchedSourceType()) {
+    facts.Append(ServiceWorkerRouterInfo::GetRouterSourceTypeString(
+        *router.MatchedSourceType()));
+  }
+  facts.Append('|');
+  if (router.ActualSourceType()) {
+    facts.Append(ServiceWorkerRouterInfo::GetRouterSourceTypeString(
+        *router.ActualSourceType()));
+  }
+  facts.Append('|');
+  facts.AppendNumber(router.RouteRuleNum());
+  facts.Append('|');
+  if (router.EvaluationWorkerStatus()) {
+    facts.AppendNumber(static_cast<int>(*router.EvaluationWorkerStatus()));
+  }
+}
+
+String RouterSha256(const ResourceResponse& response) {
+  const ServiceWorkerRouterInfo* router = response.GetServiceWorkerRouterInfo();
+  if (!router) {
+    return String();
+  }
+  StringBuilder facts;
+  AppendRouterSemanticFacts(facts, *router);
+  return DigestString(facts.ToString());
+}
+
+String RouterEpochSha256(const ResourceResponse& response) {
+  const ServiceWorkerRouterInfo* router = response.GetServiceWorkerRouterInfo();
+  if (!router) {
+    return String();
+  }
+  StringBuilder facts;
+  AppendRouterSemanticFacts(facts, *router);
+  facts.Append('|');
+  facts.AppendNumber(router->RouterEvaluationTime().InMicroseconds());
+  facts.Append('|');
+  facts.AppendNumber(router->CacheLookupTime().InMicroseconds());
+  return DigestString(facts.ToString());
+}
+
+ResourceResolution ResolveResource(const OwnerResolution& owner,
+                                   NetworkResourcesData* resources_data) {
+  ResourceResolution result;
+  if (!owner.content) {
+    result.denial_code =
+        owner.denial_code.empty() ? "candidate-pending" : owner.denial_code;
+    return result;
+  }
+  result.resource = owner.content->ResourceForInspector();
+  if (!result.resource) {
+    result.denial_code = "ambiguous-resource";
+    return result;
+  }
+  const ResourceRequestHead& request = result.resource->GetResourceRequest();
+  result.request_mode = RequestModeString(request.GetMode());
+  result.credentials_mode = CredentialsModeString(request.GetCredentialsMode());
+  result.request_id =
+      IdentifiersFactory::SubresourceRequestId(result.resource->InspectorId());
+  const KURL& url = request.Url();
+  const bool is_http = url.ProtocolIsInHttpFamily();
+  const bool is_data = url.ProtocolIsData();
+  const bool is_blob = url.ProtocolIs("blob");
+  if (!is_http && !is_data && !is_blob) {
+    result.denial_code = "unsupported-scheme";
+    return result;
+  }
+  if (is_http) {
+    result.ledger =
+        resources_data ? resources_data->Data(result.request_id) : nullptr;
+    if (!result.ledger) {
+      result.denial_code = "missing-request-ledger";
+      return result;
+    }
+    // An active validator has a request ledger before DidReceiveResponse can
+    // attach its CachedResource. The direct owner -> content -> Resource link
+    // and Resource::IsCacheValidator are authoritative; deny before any body
+    // or response fact is eligible for serialization.
+    if (result.resource->IsCacheValidator()) {
+      result.denial_code = "revalidation-in-flight";
+      return result;
+    }
+    // Failed CORS/access-check loads do not reach the response callback that
+    // attaches CachedResource to the inspector ledger. The direct owner-held
+    // Resource and its ResourceError are authoritative and body-free.
+    if (result.resource->LoadFailedOrCanceled()) {
+      const ResourceError& error = result.resource->GetResourceError();
+      result.denial_code =
+          error.CorsErrorStatus().has_value() || error.IsAccessCheck()
+              ? "cors-denied"
+              : "unsupported-owner";
+      return result;
+    }
+    if (result.ledger->CachedResource() != result.resource) {
+      result.denial_code = "ambiguous-resource";
+      return result;
+    }
+    if (result.ledger->IsContentEvicted()) {
+      result.denial_code = "body-evicted";
+      return result;
+    }
+    if (!result.ledger->LoadingFinishedForInspector()) {
+      result.denial_code = "candidate-pending";
+      return result;
+    }
+  }
+  if (result.resource->RedirectCountForInspector() > kMaximumRedirects) {
+    result.denial_code = "body-limit-exceeded";
+    return result;
+  }
+
+  const ResourceResponse& response = result.resource->GetResponse();
+  if (owner.document && owner.document->Loader()) {
+    WebServiceWorkerNetworkProvider* provider =
+        owner.document->Loader()->GetServiceWorkerNetworkProvider();
+    if (provider &&
+        provider->GetControllerServiceWorkerMode() !=
+            mojom::blink::ControllerServiceWorkerMode::kNoController) {
+      result.service_worker_controller_version_id =
+          String::Number(provider->ControllerServiceWorkerID());
+    }
+  }
+  String mime = response.MimeType();
+  String raw_content_type = response.HttpHeaderField(http_names::kContentType);
+  if (To<ImageResource>(result.resource)->IsMultipartForInspector() ||
+      EqualIgnoringAsciiCase(mime, "multipart/x-mixed-replace") ||
+      raw_content_type.StartsWithIgnoringAsciiCase(
+          "multipart/x-mixed-replace")) {
+    result.denial_code = "multipart-response";
+    return result;
+  }
+  if (response.GetType() == network::mojom::FetchResponseType::kOpaque ||
+      response.GetType() ==
+          network::mojom::FetchResponseType::kOpaqueRedirect) {
+    result.denial_code = "opaque-response";
+    return result;
+  }
+  if (!response.IsCorsSameOrigin()) {
+    result.denial_code = "unsupported-owner";
+    return result;
+  }
+  if (!EqualIgnoringAsciiCase(mime, "image/gif") &&
+      !EqualIgnoringAsciiCase(mime, "image/png") &&
+      !EqualIgnoringAsciiCase(mime, "image/webp")) {
+    result.denial_code = "unsupported-mime";
+    return result;
+  }
+  if (is_http &&
+      (response.HttpStatusCode() < 200 || response.HttpStatusCode() >= 300)) {
+    result.denial_code = "response-drift";
+    return result;
+  }
+  if (owner.content->ErrorOccurred() || !owner.content->IsLoaded() ||
+      !owner.content->GetImage() || !owner.content->IsAnimatedImage()) {
+    result.denial_code = "unsupported-owner";
+    return result;
+  }
+  if (!owner.content->GetImage()->HasSingleSecurityOrigin()) {
+    result.denial_code = "multiple-security-origins";
+    return result;
+  }
+  if (!owner.content->IsCorsSameOrigin()) {
+    result.denial_code = "cors-denied";
+    return result;
+  }
+  scoped_refptr<const SharedBuffer> buffer = owner.content->ResourceBuffer();
+  if (!buffer) {
+    result.denial_code = "body-evicted";
+    return result;
+  }
+  result.body_size = buffer->size();
+  if (result.body_size == 0 || result.body_size > kMaximumResourceBytes) {
+    result.denial_code = "body-limit-exceeded";
+    return result;
+  }
+  DigestValue digest;
+  if (!ComputeDigest(kHashAlgorithmSha256, buffer.get(), digest)) {
+    result.denial_code = "body-digest-mismatch";
+    return result;
+  }
+  result.body_sha256 = String::FromUtf8(base::HexEncodeLower(digest));
+
+  StringBuilder redirects;
+  for (wtf_size_t index = 0;
+       index < result.resource->RedirectCountForInspector(); ++index) {
+    const ResourceResponse& redirect =
+        result.resource->RedirectResponseForInspector(index);
+    redirects.Append(redirect.CurrentRequestUrl().GetString());
+    redirects.Append('|');
+    redirects.Append(redirect.ResponseUrl().GetString());
+    redirects.Append('|');
+    redirects.AppendNumber(redirect.HttpStatusCode());
+    redirects.Append('|');
+    redirects.AppendNumber(
+        redirect.ResponseTime().InMillisecondsFSinceUnixEpochIgnoringNull());
+    redirects.Append('\n');
+  }
+  result.redirect_sha256 = DigestString(redirects.ToString());
+  StringBuilder response_facts;
+  response_facts.Append(response.CurrentRequestUrl().GetString());
+  response_facts.Append('|');
+  response_facts.Append(response.ResponseUrl().GetString());
+  response_facts.Append('|');
+  response_facts.AppendNumber(response.HttpStatusCode());
+  response_facts.Append('|');
+  response_facts.Append(mime);
+  response_facts.Append('|');
+  response_facts.Append(raw_content_type);
+  response_facts.Append('|');
+  response_facts.Append(FetchResponseTypeString(response.GetType()));
+  result.response_sha256 = DigestString(response_facts.ToString());
+  StringBuilder sw;
+  sw.AppendNumber(response.WasFetchedViaServiceWorker());
+  sw.Append('|');
+  sw.Append(ServiceWorkerResponseSourceString(
+      response.GetServiceWorkerResponseSource()));
+  sw.Append('|');
+  sw.Append(result.service_worker_controller_version_id);
+  sw.Append('|');
+  sw.Append(RouterEpochSha256(response));
+  for (const KURL& sw_url : response.UrlListViaServiceWorker()) {
+    sw.Append('|');
+    sw.Append(sw_url.GetString());
+  }
+  sw.Append('|');
+  sw.Append(response.CacheStorageCacheName());
+  result.service_worker_sha256 = DigestString(sw.ToString());
+  StringBuilder cache;
+  cache.AppendNumber(response.WasCached());
+  cache.Append('|');
+  cache.AppendNumber(result.ledger &&
+                     result.ledger->ServedFromMemoryCacheForInspector());
+  cache.Append('|');
+  cache.AppendNumber(
+      result.resource->DomotionMemoryCacheUseCountForInspector());
+  result.cache_sha256 = DigestString(cache.ToString());
+  return result;
+}
+
+std::unique_ptr<Dictionary> BuildRequestIdentity(
+    const OwnerResolution& owner,
+    const ResourceResolution& resource) {
+  if (!resource.resource) {
+    return nullptr;
+  }
+  auto result = Dictionary::create();
+  result->setString("inspectorRequestId", resource.request_id);
+  String loader_id = resource.ledger ? resource.ledger->LoaderId() : String();
+  if (loader_id.empty() && owner.document && owner.document->Loader()) {
+    loader_id = IdentifiersFactory::LoaderId(owner.document->Loader());
+  }
+  result->setString("requestLoaderId", loader_id);
+  String frame_id = resource.ledger ? resource.ledger->FrameId() : String();
+  if (frame_id.empty() && owner.frame) {
+    frame_id = IdentifiersFactory::FrameId(owner.frame);
+  }
+  result->setString("requestFrameId", frame_id);
+  result->setString("requestMode", resource.request_mode);
+  result->setString("credentialsMode", resource.credentials_mode);
+  return result;
+}
+
+std::unique_ptr<Dictionary> BuildDeniedRecord(
+    const OwnerResolution& owner,
+    const ResourceResolution& resource,
+    const String& denial_code,
+    const String& root_frame_id,
+    const String& session_id,
+    const String& owner_selector_token,
+    int requested_frame_index,
+    const String& document_nonce,
+    uint64_t navigation_sequence) {
+  auto record = Dictionary::create();
+  record->setString("protocol", kProtocol);
+  record->setString("outcome", "denied");
+  record->setObject("oracle", BuildOracle(root_frame_id, session_id));
+  record->setObject("strictRequest", BuildStrictRequest(owner_selector_token,
+                                                        requested_frame_index));
+  record->setString("denialCode", denial_code);
+  if (auto document = BuildSafeDocument(owner, root_frame_id, document_nonce,
+                                        navigation_sequence, false)) {
+    record->setObject("document", std::move(document));
+  } else {
+    record->setValue("document", Value::null());
+  }
+  if (auto safe_owner = BuildSafeOwner(owner, false)) {
+    record->setObject("owner", std::move(safe_owner));
+  } else {
+    record->setValue("owner", Value::null());
+  }
+  if (auto request = BuildRequestIdentity(owner, resource)) {
+    record->setObject("requestIdentity", std::move(request));
+  } else {
+    record->setValue("requestIdentity", Value::null());
+  }
+  return record;
+}
+
+std::unique_ptr<Dictionary> BuildAuthorizedBase(
+    const OwnerResolution& owner,
+    const ResourceResolution& resource,
+    const String& content_logical_id,
+    const String& resource_logical_id,
+    const String& root_frame_id,
+    const String& session_id,
+    const String& owner_selector_token,
+    int requested_frame_index,
+    const String& document_nonce,
+    uint64_t navigation_sequence) {
+  const ResourceResponse& response = resource.resource->GetResponse();
+  auto record = Dictionary::create();
+  record->setString("protocol", kProtocol);
+  record->setString("outcome", "authorized");
+  record->setObject("oracle", BuildOracle(root_frame_id, session_id));
+  record->setObject("strictRequest", BuildStrictRequest(owner_selector_token,
+                                                        requested_frame_index));
+  record->setObject("document",
+                    BuildSafeDocument(owner, root_frame_id, document_nonce,
+                                      navigation_sequence, true));
+  record->setObject("owner", BuildSafeOwner(owner, true));
+
+  auto resource_object = Dictionary::create();
+  resource_object->setString("contentLogicalId", content_logical_id);
+  resource_object->setString("resourceLogicalId", resource_logical_id);
+  resource_object->setString("inspectorRequestId", resource.request_id);
+  resource_object->setString(
+      "requestLoaderId",
+      resource.ledger ? resource.ledger->LoaderId()
+                      : IdentifiersFactory::LoaderId(owner.document->Loader()));
+  resource_object->setString("requestFrameId",
+                             resource.ledger
+                                 ? resource.ledger->FrameId()
+                                 : IdentifiersFactory::FrameId(owner.frame));
+  resource_object->setString("requestMode", resource.request_mode);
+  resource_object->setString("credentialsMode", resource.credentials_mode);
+  auto redirect_list = List::create();
+  for (wtf_size_t index = 0;
+       index < resource.resource->RedirectCountForInspector(); ++index) {
+    const ResourceResponse& redirect =
+        resource.resource->RedirectResponseForInspector(index);
+    auto item = Dictionary::create();
+    item->setString("requestUrl", redirect.CurrentRequestUrl().GetString());
+    item->setString("responseUrl", redirect.ResponseUrl().GetString());
+    item->setInteger("status", redirect.HttpStatusCode());
+    item->setDouble(
+        "responseTime",
+        redirect.ResponseTime().InMillisecondsFSinceUnixEpochIgnoringNull());
+    redirect_list->pushValue(std::move(item));
+  }
+  resource_object->setArray("redirects", std::move(redirect_list));
+  resource_object->setString(
+      "currentRequestUrl",
+      resource.resource->GetResourceRequest().Url().GetString());
+  resource_object->setString("responseUrl", response.ResponseUrl().GetString());
+  resource_object->setInteger("status", response.HttpStatusCode());
+  resource_object->setString("mimeType", response.MimeType());
+  SetNullableString(resource_object.get(), "rawContentType",
+                    response.HttpHeaderField(http_names::kContentType));
+  resource_object->setString("fetchResponseType",
+                             FetchResponseTypeString(response.GetType()));
+  resource_object->setBoolean("corsSameOrigin", true);
+  resource_object->setBoolean("singleSecurityOrigin", true);
+  const bool memory_cache =
+      resource.ledger && resource.ledger->ServedFromMemoryCacheForInspector();
+  resource_object->setBoolean("fromDiskCache",
+                              response.WasCached() && !memory_cache);
+  resource_object->setBoolean("fromMemoryCache", memory_cache);
+  resource_object->setDouble(
+      "memoryCacheHitCount",
+      static_cast<double>(
+          resource.resource->DomotionMemoryCacheUseCountForInspector()));
+  resource_object->setBoolean("fromServiceWorker",
+                              response.WasFetchedViaServiceWorker());
+  SetNullableString(resource_object.get(), "serviceWorkerControllerVersionId",
+                    resource.service_worker_controller_version_id);
+  if (response.WasFetchedViaServiceWorker()) {
+    resource_object->setString("serviceWorkerResponseSource",
+                               ServiceWorkerResponseSourceString(
+                                   response.GetServiceWorkerResponseSource()));
+  } else {
+    resource_object->setValue("serviceWorkerResponseSource", Value::null());
+  }
+  String router_sha = RouterSha256(response);
+  SetNullableString(resource_object.get(), "serviceWorkerRouterSha256",
+                    router_sha);
+  auto sw_urls = List::create();
+  for (const KURL& sw_url : response.UrlListViaServiceWorker()) {
+    sw_urls->pushValue(protocol::StringValue::create(sw_url.GetString()));
+  }
+  resource_object->setArray("serviceWorkerUrlList", std::move(sw_urls));
+  SetNullableString(resource_object.get(), "cacheStorageCacheName",
+                    response.CacheStorageCacheName());
+  resource_object->setDouble(
+      "responseTime",
+      response.ResponseTime().InMillisecondsFSinceUnixEpochIgnoringNull());
+  resource_object->setDouble("originalResponseTime",
+                             response.OriginalResponseTime()
+                                 .InMillisecondsFSinceUnixEpochIgnoringNull());
+  resource_object->setDouble(
+      "revalidationCount",
+      static_cast<double>(resource.resource->RevalidationCountForInspector()));
+  if (auto status = resource.resource->LastRevalidationStatusForInspector()) {
+    resource_object->setInteger("lastRevalidationStatus", *status);
+  } else {
+    resource_object->setValue("lastRevalidationStatus", Value::null());
+  }
+  resource_object->setDouble(
+      "networkEncodedDataLength",
+      resource.ledger
+          ? static_cast<double>(
+                resource.ledger->NetworkEncodedDataLengthForInspector())
+          : -1);
+  record->setObject("resource", std::move(resource_object));
+
+  auto body = Dictionary::create();
+  const KURL& url = resource.resource->GetResourceRequest().Url();
+  if (url.ProtocolIsInHttpFamily()) {
+    body->setString("transport", "network-get-response-body");
+    body->setBoolean("base64EncodedByProtocol", true);
+    body->setBoolean("networkLoadingFinished", true);
+  } else if (url.ProtocolIsData()) {
+    body->setString("transport", "data-url");
+    body->setBoolean("base64EncodedByProtocol", false);
+    body->setValue("networkLoadingFinished", Value::null());
+  } else {
+    body->setString("transport", "blob-read");
+    body->setBoolean("base64EncodedByProtocol", false);
+    body->setValue("networkLoadingFinished", Value::null());
+  }
+  body->setDouble("byteLength", static_cast<double>(resource.body_size));
+  body->setString("sha256", resource.body_sha256);
+  record->setObject("body", std::move(body));
+
+  auto epochs = Dictionary::create();
+  epochs->setDouble(
+      "resourceResponseSequence",
+      static_cast<double>(resource.resource->ResponseSequenceForInspector()));
+  record->setObject("epochs", std::move(epochs));
+  return record;
+}
+
+std::unique_ptr<Dictionary> FinalizeAuthorizedRecord(
+    const Dictionary& base,
+    const String& preflight_sha256,
+    const String& postflight_sha256) {
+  auto record = Dictionary::cast(base.clone());
+  Dictionary* epochs = record->getObject("epochs");
+  epochs->setString("preflightSha256", preflight_sha256);
+  epochs->setString("postflightSha256", postflight_sha256);
+  epochs->setDouble("collectedAtMonotonicMs",
+                    base::TimeTicks::Now().since_origin().InMillisecondsF());
+  return record;
+}
