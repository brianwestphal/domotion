+// Private, bounded, evidence-only owner -> encoded ResourceBuffer oracle.
+// DevToolsSession intentionally does not allow this domain to untrusted
+// clients. It changes no loading, decoding, animation, paint, or capture path.
+class CORE_EXPORT InspectorDomotionAnimatedImageTruthAgent final
+    : public InspectorBaseAgent<
+          protocol::DomotionAnimatedImageTruth::Metainfo> {
+ public:
+  InspectorDomotionAnimatedImageTruthAgent(InspectedFrames*,
+                                           InspectorNetworkAgent*,
+                                           const String& session_id);
+  ~InspectorDomotionAnimatedImageTruthAgent() override;
+
+  void Trace(Visitor*) const override;
+
+  protocol::Response begin(
+      int backend_node_id,
+      const String& property,
+      int index,
+      const String& owner_selector_token,
+      int requested_frame_index,
+      const String& limits_fingerprint,
+      String* transaction_id,
+      std::unique_ptr<protocol::DictionaryValue>* record) override;
+  protocol::Response finish(
+      const String& transaction_id,
+      bool* unchanged,
+      std::unique_ptr<protocol::DictionaryValue>* record) override;
+
+ private:
+  class Transaction;
+
+  struct DocumentEpoch {
+    String nonce;
+    uint64_t navigation_sequence = 0;
+  };
+
+  Member<InspectedFrames> inspected_frames_;
+  Member<InspectorNetworkAgent> network_agent_;
+  const String session_id_;
+  HeapHashMap<String, Member<Transaction>> transactions_;
+  HeapHashMap<WeakMember<Document>, DocumentEpoch> document_epochs_;
+  uint64_t next_navigation_sequence_ = 1;
+  size_t active_body_bytes_ = 0;
+};
