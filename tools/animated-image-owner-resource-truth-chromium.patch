+std::unique_ptr<Dictionary> BuildStrictRequest(
+    const String& owner_selector_token,
+    int requested_frame_index) {
+  auto request = Dictionary::create();
+  request->setString("ownerSelectorToken", owner_selector_token);
+  request->setInteger("requestedFrameIndex", requested_frame_index);
+  request->setString("limitsFingerprint", kLimitsFingerprint);
+  return request;
+}
+
+std::unique_ptr<Dictionary> BuildSafeDocument(const OwnerResolution& owner,
+                                              const String& root_frame_id,
+                                              const String& nonce,
+                                              uint64_t navigation_sequence,
+                                              bool authorized) {
+  if (!owner.document || !owner.frame || !owner.document->Loader()) {
+    return nullptr;
+  }
+  auto document = Dictionary::create();
+  document->setString("targetId", root_frame_id);
+  document->setString("frameId", IdentifiersFactory::FrameId(owner.frame));
+  document->setString("documentLoaderId",
+                      IdentifiersFactory::LoaderId(owner.document->Loader()));
+  document->setString("documentNonce", nonce);
+  document->setDouble("navigationSequence",
+                      static_cast<double>(navigation_sequence));
+  if (authorized) {
+    document->setString("url", owner.document->Url().GetString());
+    document->setString(
+        "origin",
+        owner.document->GetExecutionContext()->GetSecurityOrigin()->ToString());
+  }
+  return document;
+}
+
+std::unique_ptr<Dictionary> BuildSafeOwner(const OwnerResolution& owner,
+                                           bool authorized) {
+  if (!owner.base_owner || owner.kind.empty()) {
+    return nullptr;
+  }
+  auto result = Dictionary::create();
+  result->setString("kind", owner.kind);
+  result->setInteger("backendNodeId",
+                     IdentifiersFactory::IntIdForNode(owner.base_owner));
+  auto hosts = List::create();
+  for (int id : owner.shadow_host_backend_node_ids) {
+    hosts->pushValue(protocol::FundamentalValue::create(id));
+  }
+  result->setArray("shadowHostBackendNodeIds", std::move(hosts));
+  auto root_types = List::create();
+  for (const String& type : owner.shadow_root_types) {
+    root_types->pushValue(protocol::StringValue::create(type));
+  }
+  result->setArray("shadowRootTypes", std::move(root_types));
+  if (owner.pseudo) {
+    auto pseudo = Dictionary::create();
+    pseudo->setInteger("backendNodeId",
+                       IdentifiersFactory::IntIdForNode(owner.pseudo));
+    pseudo->setString("type", InspectorDOMAgent::ProtocolPseudoElementType(
+                                  owner.pseudo->GetPseudoIdForStyling()));
+    result->setObject("pseudo", std::move(pseudo));
+  } else {
+    result->setValue("pseudo", Value::null());
+  }
+  auto slot = Dictionary::create();
+  slot->setString("property", owner.property);
+  slot->setInteger("index", owner.index);
+  if (owner.image_set_option_index < 0) {
+    slot->setValue("imageSetOptionIndex", Value::null());
+  } else {
+    slot->setInteger("imageSetOptionIndex", owner.image_set_option_index);
+  }
+  result->setObject("slot", std::move(slot));
+  if (authorized) {
+    SetNullableString(result.get(), "currentSrc", owner.current_src);
+    result->setString("selectedResourceUrl", owner.content->Url().GetString());
+    result->setString("candidateFactsSha256", owner.candidate_facts_sha256);
+    result->setDouble("devicePixelRatio", owner.device_pixel_ratio);
+    result->setString("viewportSha256", owner.viewport_sha256);
+  }
+  return result;
+}
