+bool IsSafeOwnerSelectorToken(const String& token) {
+  if (token.empty() || token.length() > 128) {
+    return false;
+  }
+  for (wtf_size_t index = 0; index < token.length(); ++index) {
+    const UChar character = token[index];
+    if (!((character >= 'A' && character <= 'Z') ||
+          (character >= 'a' && character <= 'z') ||
+          (character >= '0' && character <= '9') || character == '.' ||
+          character == '_' || character == '-')) {
+      return false;
+    }
+  }
+  return true;
+}
+
+String DigestBytes(base::span<const uint8_t> bytes) {
+  DigestValue digest;
+  if (!ComputeDigest(kHashAlgorithmSha256, bytes, digest)) {
+    return String();
+  }
+  return String::FromUtf8(base::HexEncodeLower(digest));
+}
+
+String DigestString(const String& value) {
+  StringUtf8Adaptor utf8(value);
+  return DigestBytes(base::as_byte_span(utf8));
+}
+
+String DigestDictionary(const Dictionary& value) {
+  std::vector<uint8_t> cbor;
+  value.AppendSerialized(&cbor);
+  return DigestBytes(base::span(cbor));
+}
