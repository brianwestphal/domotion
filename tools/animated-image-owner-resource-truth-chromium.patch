+struct OwnerResolution {
+  STACK_ALLOCATED();
+
+ public:
+  Node* query_node = nullptr;
+  Element* base_owner = nullptr;
+  Element* style_owner = nullptr;
+  PseudoElement* pseudo = nullptr;
+  Document* document = nullptr;
+  LocalFrame* frame = nullptr;
+  ImageResourceContent* content = nullptr;
+  StyleImage* style_image = nullptr;
+  String kind;
+  String property;
+  int index = 0;
+  int image_set_option_index = -1;
+  String current_src;
+  String candidate_facts_sha256;
+  String viewport_sha256;
+  double device_pixel_ratio = 1;
+  Vector<int> shadow_host_backend_node_ids;
+  Vector<String> shadow_root_types;
+  String denial_code;
+};
+
+void AppendAttributeFact(StringBuilder& builder,
+                         const Element& element,
+                         const QualifiedName& name) {
+  builder.Append(name.LocalName());
+  builder.Append('=');
+  // SVG URI attributes are animatable and therefore may have a dirty
+  // synchronized value. FastGetAttribute() deliberately DCHECKs for such
+  // attributes; getAttribute(QualifiedName) preserves the namespace and
+  // synchronizes the exact source-owned attribute before hashing it.
+  builder.Append(element.getAttribute(name));
+  builder.Append('\n');
+}
+
+String HtmlCandidateFacts(const HTMLImageElement& image) {
+  StringBuilder builder;
+  AppendAttributeFact(builder, image, html_names::kSrcAttr);
+  AppendAttributeFact(builder, image, html_names::kSrcsetAttr);
+  AppendAttributeFact(builder, image, html_names::kSizesAttr);
+  AppendAttributeFact(builder, image, html_names::kCrossoriginAttr);
+  AppendAttributeFact(builder, image, html_names::kReferrerpolicyAttr);
+  if (const auto* picture = DynamicTo<HTMLPictureElement>(image.parentNode())) {
+    for (Node* child = picture->firstChild(); child;
+         child = child->nextSibling()) {
+      const auto* element = DynamicTo<Element>(child);
+      if (!element) {
+        continue;
+      }
+      builder.Append(element->tagName());
+      builder.Append('\n');
+      AppendAttributeFact(builder, *element, html_names::kSrcAttr);
+      AppendAttributeFact(builder, *element, html_names::kSrcsetAttr);
+      AppendAttributeFact(builder, *element, html_names::kSizesAttr);
+      AppendAttributeFact(builder, *element, html_names::kMediaAttr);
+      AppendAttributeFact(builder, *element, html_names::kTypeAttr);
+    }
+  }
+  return DigestString(builder.ToString());
+}
+
+StyleImage* FillLayerImageAt(const FillLayer& first, int index) {
+  const FillLayer* layer = &first;
+  for (int current = 0; layer && current < index; ++current) {
+    layer = layer->Next();
+  }
+  return layer ? layer->GetImage() : nullptr;
+}
+
+OwnerResolution ResolveOwner(int backend_node_id,
+                             const String& property,
+                             int index) {
+  OwnerResolution result;
+  result.property = property;
+  result.index = index;
+  if (index < 0 || index > 64) {
+    result.denial_code = "unsupported-slot";
+    return result;
+  }
+  result.query_node = DOMNodeIds::NodeForId(backend_node_id);
+  if (!result.query_node) {
+    result.denial_code = "strict-owner-not-found";
+    return result;
+  }
+  if (!result.query_node->isConnected()) {
+    result.denial_code = "owner-detached";
+    return result;
+  }
+  result.style_owner = DynamicTo<Element>(result.query_node);
+  if (!result.style_owner) {
+    result.denial_code = "unsupported-owner";
+    return result;
+  }
+  result.pseudo = DynamicTo<PseudoElement>(result.style_owner);
+  result.base_owner = result.pseudo
+                          ? &result.pseudo->UltimateOriginatingElement()
+                          : result.style_owner;
+  result.document = &result.style_owner->GetDocument();
+  result.frame = result.document->GetFrame();
+  if (!result.frame || !result.document->Loader()) {
+    result.denial_code = "stale-document";
+    return result;
+  }
+
+  for (Node* cursor = result.style_owner; cursor;) {
+    ShadowRoot* root = cursor->ContainingShadowRoot();
+    if (!root) {
+      break;
+    }
+    Element& host = root->host();
+    result.shadow_host_backend_node_ids.push_back(
+        IdentifiersFactory::IntIdForNode(&host));
+    result.shadow_root_types.push_back(ShadowRootTypeString(*root));
+    cursor = &host;
+  }
+
+  if (property == "html-current") {
+    auto* image = DynamicTo<HTMLImageElement>(result.base_owner);
+    if (!image || result.pseudo || index != 0) {
+      result.denial_code = "unsupported-slot";
+      return result;
+    }
+    result.kind = "html-image";
+    result.content = image->CachedImage();
+    result.current_src = image->currentSrc();
+    result.candidate_facts_sha256 = HtmlCandidateFacts(*image);
+  } else if (property == "svg-href") {
+    auto* image = DynamicTo<SVGImageElement>(result.base_owner);
+    if (!image || result.pseudo || index != 0) {
+      result.denial_code = "unsupported-slot";
+      return result;
+    }
+    result.kind = "svg-image";
+    result.content = image->CachedImage();
+    StringBuilder facts;
+    AppendAttributeFact(facts, *image, svg_names::kHrefAttr);
+    AppendAttributeFact(facts, *image, xlink_names::kHrefAttr);
+    result.candidate_facts_sha256 = DigestString(facts.ToString());
+  } else if (property == "input-src") {
+    auto* input = DynamicTo<HTMLInputElement>(result.base_owner);
+    if (!input || result.pseudo || index != 0 ||
+        input->FormControlType() !=
+            mojom::blink::FormControlType::kInputImage) {
+      result.denial_code = "unsupported-slot";
+      return result;
+    }
+    result.kind = "image-input";
+    result.content =
+        input->ImageLoader() ? input->ImageLoader()->GetContent() : nullptr;
+    StringBuilder facts;
+    AppendAttributeFact(facts, *input, html_names::kSrcAttr);
+    AppendAttributeFact(facts, *input, html_names::kCrossoriginAttr);
+    result.candidate_facts_sha256 = DigestString(facts.ToString());
+  } else {
+    result.kind = "css-image";
+    const ComputedStyle* style = result.style_owner->GetComputedStyle();
+    if (!style) {
+      result.denial_code = "candidate-pending";
+      return result;
+    }
+    if (property == "background-image") {
+      result.style_image = FillLayerImageAt(style->BackgroundLayers(), index);
+    } else if (property == "mask-image") {
+      result.style_image = FillLayerImageAt(style->MaskLayers(), index);
+    } else if (property == "content") {
+      ContentData* item = style->GetContentData();
+      for (int current = 0; item && current < index; ++current) {
+        item = item->Next();
+      }
+      if (auto* image = DynamicTo<ImageContentData>(item)) {
+        result.style_image = image->GetImage();
+      }
+    } else if (property == "list-style-image" && index == 0) {
+      result.style_image = style->ListStyleImage();
+    } else if (property == "border-image-source" && index == 0) {
+      result.style_image = style->BorderImageSource();
+    } else {
+      result.denial_code = "unsupported-slot";
+      return result;
+    }
+    if (!result.style_image) {
+      result.denial_code = "candidate-pending";
+      return result;
+    }
+    result.content = result.style_image->CachedImage();
+    if (auto* image_set = DynamicTo<StyleImageSet>(result.style_image)) {
+      result.image_set_option_index =
+          image_set->SelectedOptionIndexForInspector();
+      if (result.image_set_option_index < 0) {
+        result.denial_code = "candidate-pending";
+        return result;
+      }
+    }
+    StringBuilder facts;
+    facts.Append(property);
+    facts.Append('|');
+    facts.AppendNumber(index);
+    facts.Append('|');
+    facts.AppendNumber(result.image_set_option_index);
+    facts.Append('|');
+    facts.Append(result.style_image->IsImageResourceSet() ? "image-set"
+                                                          : "image-resource");
+    result.candidate_facts_sha256 = DigestString(facts.ToString());
+  }
+
+  if (!result.content) {
+    result.denial_code = "candidate-pending";
+    return result;
+  }
+
+  result.device_pixel_ratio = result.frame->DevicePixelRatio();
+  StringBuilder viewport;
+  if (result.frame->View()) {
+    viewport.AppendNumber(result.frame->View()->Size().width());
+    viewport.Append('x');
+    viewport.AppendNumber(result.frame->View()->Size().height());
+  }
+  viewport.Append('@');
+  viewport.AppendNumber(result.device_pixel_ratio);
+  result.viewport_sha256 = DigestString(viewport.ToString());
+  return result;
+}
+
+std::unique_ptr<Dictionary> BuildOracle(const String& root_frame_id,
+                                        const String& session_id) {
+  auto oracle = Dictionary::create();
+  oracle->setString("chromiumRevision", kChromiumRevision);
+  oracle->setString("schemaSha256", kSchemaSha256);
+  oracle->setString("patchSha256", kPatchSha256);
+  oracle->setInteger("rendererProcessId", base::GetCurrentProcId());
+  oracle->setString("rootFrameId", root_frame_id);
+  oracle->setString("sessionId", session_id);
+  return oracle;
+}
