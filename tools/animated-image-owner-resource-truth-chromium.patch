+# Evidence-only private protocol used by the DM-2583 pinned Chromium build.
+# This domain is intentionally not available to untrusted DevTools clients.
+experimental domain DomotionAnimatedImageTruth
+  depends on DOM
+
+  type SlotProperty extends string
+    enum
+      html-current
+      svg-href
+      input-src
+      background-image
+      content
+      list-style-image
+      border-image-source
+      mask-image
+
+  # Starts one bounded owner -> content -> resource truth transaction.
+  command begin
+    parameters
+      DOM.BackendNodeId backendNodeId
+      SlotProperty property
+      integer index
+      string ownerSelectorToken
+      integer requestedFrameIndex
+      string limitsFingerprint
+    returns
+      string transactionId
+      object record
+
+  # Re-resolves the exact owner and slot, consumes the transaction, and returns
+  # only an authorized exact record or a body-free denial record.
+  command finish
+    parameters
+      string transactionId
+    returns
+      boolean unchanged
+      object record
