+enum class SourceKind { kTable, kSection, kCaption, kCell };
+
+bool IsSourceKind(const Element& element, SourceKind kind) {
+  switch (kind) {
+    case SourceKind::kTable:
+      return element.HasTagName(html_names::kTableTag);
+    case SourceKind::kSection:
+      return element.HasTagName(html_names::kTheadTag) ||
+             element.HasTagName(html_names::kTbodyTag) ||
+             element.HasTagName(html_names::kTfootTag);
+    case SourceKind::kCaption:
+      return element.HasTagName(html_names::kCaptionTag);
+    case SourceKind::kCell:
+      return element.HasTagName(html_names::kTdTag) ||
+             element.HasTagName(html_names::kThTag);
+  }
+  return false;
+}
+
+int SourceIndex(const Document& document,
+                SourceKind kind,
+                const LayoutObject* object) {
+  const Node* target = object ? object->GetNode() : nullptr;
+  if (!target)
+    return -1;
+  int source_index = 0;
+  for (Node& node : NodeTraversal::DescendantsOf(document)) {
+    const auto* element = DynamicTo<Element>(node);
+    if (!element || !IsSourceKind(*element, kind))
+      continue;
+    if (&node == target)
+      return source_index;
+    ++source_index;
+  }
+  return -1;
+}
+
+int FragmentOccurrenceIndex(const PhysicalBoxFragment& fragment) {
+  const auto* box = DynamicTo<LayoutBox>(fragment.GetLayoutObject());
+  if (!box)
+    return -1;
+  for (wtf_size_t index = 0; index < box->PhysicalFragmentCount(); ++index) {
+    if (box->GetPhysicalFragment(index) == &fragment)
+      return static_cast<int>(index);
+  }
+  return -1;
+}
+
+void FindTables(const PhysicalBoxFragment& fragment,
+                HeapVector<Member<const PhysicalBoxFragment>>& tables) {
+  if (fragment.IsTable())
+    tables.push_back(&fragment);
+  for (const PhysicalFragmentLink& child : fragment.Children()) {
+    if (const auto* box = DynamicTo<PhysicalBoxFragment>(child.get()))
+      FindTables(*box, tables);
+  }
+}
+
+const PhysicalBoxFragment* FirstSection(const PhysicalBoxFragment& table) {
+  for (const PhysicalFragmentLink& child : table.Children()) {
+    if (child->IsTableSection())
+      return To<PhysicalBoxFragment>(child.get());
+  }
+  return nullptr;
+}
+
+const PhysicalBoxFragment* LastSection(const PhysicalBoxFragment& table) {
+  const auto children = table.Children();
+  for (auto it = children.rbegin(); it != children.rend(); ++it) {
+    if ((*it)->IsTableSection())
+      return To<PhysicalBoxFragment>((*it).get());
+  }
+  return nullptr;
+}
+
+const PhysicalBoxFragment* FirstRow(const PhysicalBoxFragment& section) {
+  for (const PhysicalFragmentLink& child : section.Children()) {
+    if (child->IsTableRow())
+      return To<PhysicalBoxFragment>(child.get());
+  }
+  return nullptr;
+}
+
+const PhysicalBoxFragment* LastRow(const PhysicalBoxFragment& section) {
+  const auto children = section.Children();
+  for (auto it = children.rbegin(); it != children.rend(); ++it) {
+    if ((*it)->IsTableRow())
+      return To<PhysicalBoxFragment>((*it).get());
+  }
+  return nullptr;
+}
+
+bool StartRowFragmented(const PhysicalBoxFragment& section) {
+  const PhysicalBoxFragment* row = FirstRow(section);
+  return row && IsBreakInside(FindPreviousBreakToken(*row));
+}
+
+bool EndRowFragmented(const PhysicalBoxFragment& section) {
+  const PhysicalBoxFragment* row = LastRow(section);
+  if (!row)
+    return false;
+  const auto* token = row->GetBreakToken();
+  return IsBreakInside(token) && !token->IsAtBlockEnd();
+}
