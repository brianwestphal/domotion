+base::DictValue RepeatEligibilityFromRepeatToken(
+    const BlockBreakToken& incoming_repeat_token) {
+  // At this exact source pin Blink creates a repeated break token only after
+  // all seven gates in TableLayoutAlgorithm have passed. Serializing that
+  // source-owned token avoids re-running or approximating the eligibility
+  // decision after layout.
+  CHECK(incoming_repeat_token.IsRepeated());
+  base::DictValue result;
+  result.Set("knownFragmentainerBlockSize", true);
+  result.Set("atMostQuarterFragmentainer", true);
+  result.Set("applicableBreakInsideAvoid", true);
+  result.Set("noBreakInside", true);
+  result.Set("noLateStart", true);
+  result.Set("outsideNestedRepeatableContent", true);
+  result.Set("layoutSideEffectsEnabled", true);
+  return result;
+}
+
+base::ListValue BuildSpanningCells(
+    const Vector<SectionFacts>& section_facts,
+    const Document& document,
+    const TableBorders& borders,
+    wtf_size_t total_rows,
+    wtf_size_t total_columns,
+    HashSet<wtf_size_t>& span_interiors) {
+  base::ListValue result;
+  HashSet<int> seen_cell_sources;
+  const wtf_size_t edges_per_row = borders.EdgesPerRow();
+  for (const SectionFacts& facts : section_facts) {
+    const PhysicalBoxFragment& section = *facts.fragment;
+    const PhysicalBoxFragment* first_row = FirstRow(section);
+    if (!first_row)
+      continue;
+    const auto* first_cell = [&]() -> const PhysicalBoxFragment* {
+      for (const PhysicalFragmentLink& child : first_row->Children()) {
+        if (child->IsTableCell())
+          return To<PhysicalBoxFragment>(child.get());
+      }
+      return nullptr;
+    }();
+    const unsigned first_source_row =
+        first_cell
+            ? To<LayoutTableCell>(first_cell->GetLayoutObject())->RowIndex()
+            : 0;
+    for (const PhysicalFragmentLink& row_link : section.Children()) {
+      if (!row_link->IsTableRow())
+        continue;
+      const auto& row = *To<PhysicalBoxFragment>(row_link.get());
+      for (const PhysicalFragmentLink& cell_link : row.Children()) {
+        if (!cell_link->IsTableCell())
+          continue;
+        const auto& cell_fragment =
+            *To<PhysicalBoxFragment>(cell_link.get());
+        const auto* cell =
+            DynamicTo<LayoutTableCell>(cell_fragment.GetLayoutObject());
+        if (!cell)
+          continue;
+        const int cell_source =
+            SourceIndex(document, SourceKind::kCell, cell);
+        if (seen_cell_sources.Contains(cell_source))
+          continue;
+        seen_cell_sources.insert(cell_source);
+        wtf_size_t row_start =
+            facts.start_row + cell->RowIndex() - first_source_row;
+        wtf_size_t row_end =
+            std::min(total_rows, row_start + cell->ResolvedRowSpan());
+        wtf_size_t column_start = cell_fragment.TableCellColumnIndex();
+        wtf_size_t column_end =
+            std::min(total_columns, column_start + cell->ColSpan());
+        if (row_end <= row_start || column_end <= column_start ||
+            (row_end - row_start == 1 && column_end - column_start == 1)) {
+          continue;
+        }
+
+        base::ListValue interior_indices;
+        for (wtf_size_t row_index = row_start; row_index < row_end;
+             ++row_index) {
+          for (wtf_size_t column_index = column_start + 1;
+               column_index < column_end; ++column_index) {
+            const wtf_size_t edge_index =
+                row_index * edges_per_row + column_index * 2;
+            if (borders.DomotionIsDoNotFill(edge_index) &&
+                span_interiors.insert(edge_index).is_new_entry) {
+              interior_indices.Append(static_cast<int>(edge_index));
+            }
+          }
+        }
+        for (wtf_size_t row_index = row_start + 1; row_index < row_end;
+             ++row_index) {
+          for (wtf_size_t column_index = column_start;
+               column_index < column_end; ++column_index) {
+            const wtf_size_t edge_index =
+                row_index * edges_per_row + column_index * 2 + 1;
+            if (borders.DomotionIsDoNotFill(edge_index) &&
+                span_interiors.insert(edge_index).is_new_entry) {
+              interior_indices.Append(static_cast<int>(edge_index));
+            }
+          }
+        }
+
+        base::DictValue global_rows;
+        global_rows.Set("start", static_cast<int>(row_start));
+        global_rows.Set("endExclusive", static_cast<int>(row_end));
+        base::DictValue span;
+        span.Set("cellSourceIndex", cell_source);
+        span.Set("globalRows", std::move(global_rows));
+        span.Set("globalColumnStart", static_cast<int>(column_start));
+        span.Set("globalColumnEndExclusive", static_cast<int>(column_end));
+        span.Set("interiorCollapsedEdgeIndices",
+                 std::move(interior_indices));
+        result.Append(std::move(span));
+      }
+    }
+  }
+  return result;
+}
+
+base::ListValue BuildCollapsedEdges(
+    const PhysicalBoxFragment& table,
+    const Vector<SectionFacts>& section_facts,
+    const TableBorders& borders,
+    const HashSet<wtf_size_t>& span_interiors) {
+  base::ListValue result;
+  HashSet<wtf_size_t> observed_edges;
+  const wtf_size_t edges_per_row = borders.EdgesPerRow();
+  const wtf_size_t total_row_boundaries =
+      borders.EdgeCount() / edges_per_row;
+  const PhysicalBoxFragment* start_section = FirstSection(table);
+  const PhysicalBoxFragment* end_section = LastSection(table);
+  std::optional<wtf_size_t> previous_painted_row;
+  int paint_order = 0;
+
+  for (const SectionFacts& facts : section_facts) {
+    const PhysicalBoxFragment& section = *facts.fragment;
+    const Vector<LayoutUnit>* row_offsets = section.TableSectionRowOffsets();
+    if (!row_offsets || row_offsets->empty())
+      continue;
+    const bool has_previous_content =
+        start_section == &section && facts.start_row > 0;
+    const bool has_next_content =
+        end_section == &section &&
+        facts.start_row + row_offsets->size() < total_row_boundaries;
+    const wtf_size_t start_edge = facts.start_row * edges_per_row;
+    for (wtf_size_t edge_index = start_edge;
+         edge_index < borders.EdgeCount(); ++edge_index) {
+      CollapsedEdge edge(borders, edge_index);
+      const wtf_size_t table_row = edge.Row();
+      const wtf_size_t fragment_row = table_row - facts.start_row;
+      if (fragment_row >= row_offsets->size()) {
+        previous_painted_row =
+            facts.end_continued ? std::nullopt
+                                : std::optional<wtf_size_t>(table_row - 1);
+        break;
+      }
+      if (observed_edges.Contains(edge_index))
+        continue;
+
+      std::string disposition;
+      bool start_boundary = false;
+      bool end_boundary = false;
+      bool omitted = false;
+      if (span_interiors.Contains(edge_index)) {
+        disposition = "skip-span-interior";
+        omitted = true;
+      } else if (!edge.CanPaint()) {
+        continue;
+      } else if (edge.IsInlineAxis()) {
+        if (previous_painted_row && *previous_painted_row == table_row)
+          continue;
+        const bool is_start_row = fragment_row == 0;
+        const bool is_end_row = fragment_row == row_offsets->size() - 1;
+        start_boundary = is_start_row && has_previous_content;
+        end_boundary = is_end_row && has_next_content;
+        if (is_start_row && facts.start_continued) {
+          disposition = "omit-at-continued-row-start";
+          omitted = true;
+        } else if (is_end_row && facts.end_continued) {
+          disposition = "omit-at-continued-row-end";
+          omitted = true;
+        } else if (start_boundary) {
+          disposition = "paint-half-at-whole-row-start";
+        } else if (end_boundary) {
+          disposition = "paint-half-at-whole-row-end";
+        } else {
+          disposition = "paint-full";
+        }
+      } else {
+        if (fragment_row + 1 >= row_offsets->size())
+          continue;
+        const bool is_start_row = fragment_row == 0;
+        const bool is_end_row =
+            fragment_row + 1 == row_offsets->size() - 1;
+        start_boundary = is_start_row && has_previous_content;
+        end_boundary = is_end_row && has_next_content;
+        disposition = "paint-full";
+      }
+
+      observed_edges.insert(edge_index);
+      const JointWins wins =
+          ComputeJointWins(edge, start_boundary, end_boundary);
+      base::DictValue decision;
+      decision.Set("sourceEdgeIndex", static_cast<int>(edge_index));
+      decision.Set("decisionOrder", static_cast<int>(result.size()));
+      if (omitted) {
+        decision.Set("paintOrder", base::Value());
+      } else {
+        decision.Set("paintOrder", paint_order++);
+      }
+      decision.Set("axis", edge.IsInlineAxis() ? "inline" : "block");
+      decision.Set("globalRowBoundary", static_cast<int>(edge.Row()));
+      decision.Set("globalColumnBoundary", static_cast<int>(edge.Column()));
+      decision.Set("disposition", std::move(disposition));
+      decision.Set(
+          "startJoint",
+          JointDecision(start_boundary || facts.start_continued
+                            ? "absent-at-fragment-boundary"
+                            : (wins.start ? "self" : "neighbor")));
+      decision.Set(
+          "endJoint",
+          JointDecision(end_boundary || facts.end_continued
+                            ? "absent-at-fragment-boundary"
+                            : (wins.end ? "self" : "neighbor")));
+      result.Append(std::move(decision));
+    }
+  }
+
+  Vector<wtf_size_t> missing_interiors;
+  for (wtf_size_t edge_index : span_interiors) {
+    if (!observed_edges.Contains(edge_index))
+      missing_interiors.push_back(edge_index);
+  }
+  std::sort(missing_interiors.begin(), missing_interiors.end());
+  for (wtf_size_t edge_index : missing_interiors) {
+    CollapsedEdge edge(borders, edge_index);
+    base::DictValue decision;
+    decision.Set("sourceEdgeIndex", static_cast<int>(edge_index));
+    decision.Set("decisionOrder", static_cast<int>(result.size()));
+    decision.Set("paintOrder", base::Value());
+    decision.Set("axis", edge.IsInlineAxis() ? "inline" : "block");
+    decision.Set("globalRowBoundary", static_cast<int>(edge.Row()));
+    decision.Set("globalColumnBoundary", static_cast<int>(edge.Column()));
+    decision.Set("disposition", "skip-span-interior");
+    decision.Set("startJoint", JointDecision("neighbor"));
+    decision.Set("endJoint", JointDecision("neighbor"));
+    result.Append(std::move(decision));
+  }
+  return result;
+}
+
+base::DictValue BuildTable(
+    const PhysicalBoxFragment& table,
+    wtf_size_t page_index,
+    const Document& document) {
+  const TableBorders* borders = table.TableCollapsedBorders();
+  const CollapsedTableBordersGeometry* geometry =
+      table.TableCollapsedBordersGeometry();
+  base::DictValue result;
+  if (!borders || !geometry || borders->EdgesPerRow() < 4 ||
+      borders->EdgeCount() < borders->EdgesPerRow()) {
+    return result;
+  }
+  const int occurrence = FragmentOccurrenceIndex(table);
+  const int table_source =
+      SourceIndex(document, SourceKind::kTable, table.GetLayoutObject());
+  const auto* layout_box = DynamicTo<LayoutBox>(table.GetLayoutObject());
+  const wtf_size_t fragment_count =
+      layout_box ? layout_box->PhysicalFragmentCount() : 1;
+  const wtf_size_t total_rows =
+      borders->EdgeCount() / borders->EdgesPerRow() - 1;
+  const wtf_size_t total_columns = borders->EdgesPerRow() / 2 - 1;
+
+  result.Set("physicalTableFragmentId",
+             "table:" + std::to_string(table_source) + ":" +
+                 std::to_string(occurrence));
+  result.Set("tableSourceIndex", table_source);
+  result.Set("occurrenceIndex", occurrence);
+  result.Set("pageIndex", static_cast<int>(page_index));
+  result.Set("firstTableBox", occurrence == 0);
+  result.Set("lastTableBox",
+             occurrence >= 0 && static_cast<wtf_size_t>(occurrence + 1) ==
+                                      fragment_count);
+  const WritingMode writing_mode = table.Style().GetWritingMode();
+  result.Set("writingMode", WritingModeName(writing_mode));
+  result.Set("direction",
+             table.Style().Direction() == TextDirection::kRtl ? "rtl" : "ltr");
+  result.Set("fragmentationAxis",
+             writing_mode == WritingMode::kHorizontalTb ? "physical-y"
+                                                        : "physical-x");
+  result.Set("progression",
+             writing_mode == WritingMode::kVerticalRl ||
+                     writing_mode == WritingMode::kSidewaysRl
+                 ? "negative"
+                 : "positive");
+  result.Set("totalRows", static_cast<int>(total_rows));
+  result.Set("totalColumns", static_cast<int>(total_columns));
+  base::ListValue column_offsets;
+  for (LayoutUnit value : geometry->columns)
+    column_offsets.Append(Number(value));
+  result.Set("globalColumnOffsets", std::move(column_offsets));
+
+  base::ListValue sections;
+  base::ListValue captions;
+  Vector<SectionFacts> section_facts;
+  int section_paint_slot = 0;
+  int table_child_paint_slot = 0;
+  for (const PhysicalFragmentLink& child : table.Children()) {
+    const auto* child_box = DynamicTo<PhysicalBoxFragment>(child.get());
+    if (!child_box)
+      continue;
+    if (child_box->IsTableSection()) {
+      const auto start = child_box->TableSectionStartRowIndex();
+      const Vector<LayoutUnit>* offsets = child_box->TableSectionRowOffsets();
+      if (!start || !offsets || offsets->size() < 2)
+        continue;
+      SectionFacts facts;
+      facts.fragment = child_box;
+      facts.start_row = *start;
+      facts.end_row = std::min(total_rows, *start + offsets->size() - 1);
+      facts.start_continued = StartRowFragmented(*child_box);
+      facts.end_continued = EndRowFragmented(*child_box);
+      section_facts.push_back(facts);
+
+      const std::string tag = SectionTag(*child_box);
+      const int section_occurrence = FragmentOccurrenceIndex(*child_box);
+      const BlockBreakToken* previous = FindPreviousBreakToken(*child_box);
+      const bool repeated = previous && previous->IsRepeated();
+      std::string repeat_role = "body";
+      if (tag == "thead")
+        repeat_role = repeated ? "repeated-header" : "original-header";
+      else if (tag == "tfoot")
+        repeat_role = repeated ? "repeated-footer" : "original-footer";
+      const BlockBreakToken* outgoing = child_box->GetBreakToken();
+      const bool resumed_section =
+          previous && IsBreakInside(previous) && !previous->IsRepeated() &&
+          !repeated;
+      const bool continuing_section =
+          outgoing && IsBreakInside(outgoing) && !outgoing->IsRepeated() &&
+          !repeated;
+
+      base::DictValue global_rows;
+      global_rows.Set("start", static_cast<int>(facts.start_row));
+      global_rows.Set("endExclusive", static_cast<int>(facts.end_row));
+      base::ListValue row_offsets;
+      for (LayoutUnit value : *offsets)
+        row_offsets.Append(Number(value));
+      base::DictValue reserved;
+      reserved.Set("blockStart",
+                   repeated && tag == "thead"
+                       ? Number(borders->TableBorder().block_start)
+                       : 0.0);
+      reserved.Set("blockEnd",
+                   repeated && tag == "tfoot"
+                       ? Number(borders->TableBorder().block_end)
+                       : 0.0);
+      base::DictValue section;
+      const int section_source =
+          SourceIndex(document, SourceKind::kSection,
+                      child_box->GetLayoutObject());
+      section.Set("physicalSectionFragmentId",
+                  "section:" + std::to_string(table_source) + ":" +
+                      std::to_string(section_source) + ":" +
+                      std::to_string(section_occurrence));
+      section.Set("sectionSourceIndex", section_source);
+      section.Set("sectionTag", tag);
+      section.Set("occurrenceIndex", section_occurrence);
+      section.Set("repeatRole", repeat_role);
+      section.Set("sectionPaintSlot", section_paint_slot++);
+      section.Set("tableChildPaintSlot", table_child_paint_slot++);
+      section.Set("globalRows", std::move(global_rows));
+      section.Set("logicalRowOffsets", std::move(row_offsets));
+      if (facts.start_continued) {
+        section.Set("startBreak",
+                    BreakState("continued-row", facts.start_row));
+      } else if (resumed_section) {
+        section.Set("startBreak", BreakState("whole-row", facts.start_row));
+      } else {
+        section.Set("startBreak", BreakState("none", std::nullopt));
+      }
+      if (facts.end_continued) {
+        section.Set("endBreak",
+                    BreakState("continued-row", facts.end_row - 1));
+      } else if (continuing_section) {
+        section.Set("endBreak", BreakState("whole-row", facts.end_row));
+      } else {
+        section.Set("endBreak", BreakState("none", std::nullopt));
+      }
+      if (repeated && (tag == "thead" || tag == "tfoot")) {
+        section.Set("repeatEligibility",
+                    RepeatEligibilityFromRepeatToken(*previous));
+      } else {
+        section.Set("repeatEligibility", base::Value());
+      }
+      section.Set("reservedCollapsedEdgeSpace", std::move(reserved));
+      sections.Append(std::move(section));
+    } else if (child_box->GetLayoutObject()->IsTableCaption()) {
+      const int caption_occurrence = FragmentOccurrenceIndex(*child_box);
+      const int caption_source =
+          SourceIndex(document, SourceKind::kCaption,
+                      child_box->GetLayoutObject());
+      base::DictValue caption;
+      caption.Set("physicalCaptionFragmentId",
+                  "caption:" + std::to_string(table_source) + ":" +
+                      std::to_string(caption_source) + ":" +
+                      std::to_string(caption_occurrence));
+      caption.Set("captionSourceIndex", caption_source);
+      caption.Set("occurrenceIndex", caption_occurrence);
+      caption.Set("tableChildPaintSlot", table_child_paint_slot++);
+      caption.Set("side", child_box->Style().CaptionSide() == ECaptionSide::kTop
+                              ? "block-start"
+                              : "block-end");
+      captions.Append(std::move(caption));
+    }
+  }
+  result.Set("sectionOccurrences", std::move(sections));
+  result.Set("captionOccurrences", std::move(captions));
+  HashSet<wtf_size_t> span_interiors;
+  result.Set("spanningCells",
+             BuildSpanningCells(section_facts, document, *borders,
+                                total_rows, total_columns, span_interiors));
+  result.Set("collapsedEdges",
+             BuildCollapsedEdges(table, section_facts, *borders,
+                                 span_interiors));
+  return result;
+}
