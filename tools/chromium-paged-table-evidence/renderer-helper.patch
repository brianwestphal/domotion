+class CollapsedEdge {
+  STACK_ALLOCATED();
+
+ public:
+  CollapsedEdge(const TableBorders& borders, wtf_size_t edge_index)
+      : borders_(borders),
+        edge_index_(edge_index < borders.EdgeCount() ? edge_index : UINT_MAX) {}
+  CollapsedEdge(const CollapsedEdge& source, int offset)
+      : borders_(source.borders_) {
+    if (offset < 0 && source.edge_index_ < static_cast<wtf_size_t>(-offset)) {
+      edge_index_ = UINT_MAX;
+    } else {
+      edge_index_ = source.edge_index_ + offset;
+      if (edge_index_ >= borders_.EdgeCount())
+        edge_index_ = UINT_MAX;
+    }
+  }
+
+  bool Exists() const { return edge_index_ != UINT_MAX; }
+  bool CanPaint() const { return Exists() && borders_.CanPaint(edge_index_); }
+  bool IsInlineAxis() const {
+    return Exists() && edge_index_ % borders_.EdgesPerRow() % 2 != 0;
+  }
+  wtf_size_t Index() const { return edge_index_; }
+  wtf_size_t Row() const { return edge_index_ / borders_.EdgesPerRow(); }
+  wtf_size_t Column() const {
+    return edge_index_ % borders_.EdgesPerRow() / 2;
+  }
+
+  static int CompareForPaint(const CollapsedEdge& left,
+                             const CollapsedEdge& right) {
+    if (left.edge_index_ == right.edge_index_)
+      return 0;
+    const bool left_paints = left.CanPaint();
+    const bool right_paints = right.CanPaint();
+    if (left_paints && right_paints) {
+      const LayoutUnit left_width = left.borders_.BorderWidth(left.edge_index_);
+      const LayoutUnit right_width = right.borders_.BorderWidth(right.edge_index_);
+      if (left_width > right_width)
+        return 1;
+      if (left_width < right_width)
+        return -1;
+      const EBorderStyle left_style =
+          left.borders_.BorderStyle(left.edge_index_);
+      const EBorderStyle right_style =
+          right.borders_.BorderStyle(right.edge_index_);
+      if (left_style == right_style) {
+        const wtf_size_t left_order =
+            left.borders_.BoxOrder(left.edge_index_);
+        const wtf_size_t right_order =
+            right.borders_.BoxOrder(right.edge_index_);
+        if (left_order < right_order)
+          return 1;
+        if (left_order > right_order)
+          return -1;
+        return 0;
+      }
+      if (right_style == EBorderStyle::kHidden)
+        return 1;
+      if (left_style == EBorderStyle::kHidden)
+        return -1;
+      return left_style > right_style ? 1 : -1;
+    }
+    if (!left_paints && !right_paints)
+      return 0;
+    return left_paints ? 1 : -1;
+  }
+
+  CollapsedEdge BeforeStart() const {
+    return CollapsedEdge(*this, IsInlineAxis() ? -2 : -1);
+  }
+  CollapsedEdge AfterStart() const {
+    return CollapsedEdge(*this, IsInlineAxis() ? 0 : 1);
+  }
+  CollapsedEdge OverStart() const {
+    return CollapsedEdge(*this, IsInlineAxis()
+                                    ? -(static_cast<int>(borders_.EdgesPerRow()) + 1)
+                                    : -static_cast<int>(borders_.EdgesPerRow()));
+  }
+  CollapsedEdge UnderStart() const {
+    return CollapsedEdge(*this, IsInlineAxis() ? -1 : 0);
+  }
+  CollapsedEdge BeforeEnd() const {
+    return CollapsedEdge(*this, IsInlineAxis()
+                                    ? 0
+                                    : static_cast<int>(borders_.EdgesPerRow()) - 1);
+  }
+  CollapsedEdge AfterEnd() const {
+    return CollapsedEdge(*this, IsInlineAxis()
+                                    ? 2
+                                    : static_cast<int>(borders_.EdgesPerRow()) + 1);
+  }
+  CollapsedEdge OverEnd() const {
+    return CollapsedEdge(*this, IsInlineAxis()
+                                    ? -(static_cast<int>(borders_.EdgesPerRow()) - 1)
+                                    : 0);
+  }
+  CollapsedEdge UnderEnd() const {
+    return CollapsedEdge(*this, IsInlineAxis()
+                                    ? 1
+                                    : static_cast<int>(borders_.EdgesPerRow()));
+  }
+  CollapsedEdge Empty() const { return CollapsedEdge(borders_, UINT_MAX); }
+
+ private:
+  const TableBorders& borders_;
+  wtf_size_t edge_index_;
+};
+
+struct JointWins {
+  bool start = false;
+  bool end = false;
+};
+
+JointWins ComputeJointWins(const CollapsedEdge& edge,
+                           bool over_fragmentation_boundary,
+                           bool under_fragmentation_boundary) {
+  JointWins result;
+  CollapsedEdge before = edge.BeforeStart();
+  CollapsedEdge after = edge.AfterStart();
+  CollapsedEdge over =
+      over_fragmentation_boundary ? edge.Empty() : edge.OverStart();
+  CollapsedEdge under =
+      under_fragmentation_boundary && edge.IsInlineAxis()
+          ? edge.Empty()
+          : edge.UnderStart();
+  int inline_compare = CollapsedEdge::CompareForPaint(before, after);
+  int block_compare = CollapsedEdge::CompareForPaint(over, under);
+  int inline_vs_block = CollapsedEdge::CompareForPaint(
+      inline_compare == 1 ? before : after,
+      block_compare == 1 ? over : under);
+  if (edge.IsInlineAxis()) {
+    result.start = inline_vs_block != -1 && inline_compare != 1;
+  } else {
+    result.start = inline_vs_block != 1 && block_compare != 1;
+  }
+
+  const CollapsedEdge before_end = edge.BeforeEnd();
+  const CollapsedEdge after_end = edge.AfterEnd();
+  const CollapsedEdge over_end =
+      over_fragmentation_boundary && edge.IsInlineAxis() ? edge.Empty()
+                                                         : edge.OverEnd();
+  const CollapsedEdge under_end =
+      under_fragmentation_boundary ? edge.Empty() : edge.UnderEnd();
+  inline_compare = CollapsedEdge::CompareForPaint(before_end, after_end);
+  block_compare = CollapsedEdge::CompareForPaint(over_end, under_end);
+  inline_vs_block = CollapsedEdge::CompareForPaint(
+      inline_compare == 1 ? before_end : after_end,
+      block_compare == 1 ? over_end : under_end);
+  if (edge.IsInlineAxis()) {
+    result.end = inline_vs_block != -1 && inline_compare != -1;
+  } else {
+    result.end = inline_vs_block != 1 && block_compare != -1;
+  }
+  return result;
+}
