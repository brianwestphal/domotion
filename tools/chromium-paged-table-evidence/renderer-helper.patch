+String SerializeDomotionPagedTableEvidence(
+    const LocalFrame& frame,
+    const WebPrintParams& print_params) {
+  const Document* document = frame.GetDocument();
+  const LayoutView* layout_view = document ? document->GetLayoutView() : nullptr;
+  if (!document || !layout_view || !document->Printing())
+    return String();
+  base::ListValue pages;
+  const wtf_size_t page_count = PageCount(*layout_view);
+  for (wtf_size_t page_index = 0; page_index < page_count; ++page_index) {
+    const PhysicalBoxFragment* page_area = GetPageArea(*layout_view, page_index);
+    if (!page_area)
+      continue;
+    HeapVector<Member<const PhysicalBoxFragment>> tables;
+    FindTables(*page_area, tables);
+    base::ListValue table_occurrences;
+    for (const PhysicalBoxFragment* table : tables) {
+      base::DictValue table_record =
+          BuildTable(*table, page_index, *document);
+      if (!table_record.empty())
+        table_occurrences.Append(std::move(table_record));
+    }
+    base::DictValue page;
+    page.Set("pageIndex", static_cast<int>(page_index));
+    const AtomicString page_name = page_area->PropagatedPageName();
+    if (page_name.IsNull() || page_name.empty())
+      page.Set("pageName", base::Value());
+    else
+      page.Set("pageName", Utf8(page_name.GetString()));
+    page.Set("emptyKind",
+             tables.empty() && page_index + 1 == page_count
+                 ? "terminal-empty"
+                 : "none");
+    page.Set("tableOccurrences", std::move(table_occurrences));
+    pages.Append(std::move(page));
+  }
+
+  base::DictValue root;
+  root.Set("helperAbi", kHelperAbi);
+  root.Set("sourceRevision", kChromiumRevision);
+  root.Set("capturePhase", "after-PrintBegin-before-PrintEnd");
+  root.Set("logicalFactsDerivedFromPdfVectorOrRaster", false);
+  root.Set("frameToken", frame.GetLocalFrameToken().ToString());
+  root.Set("documentToken", document->Token().ToString());
+  root.Set("documentUrl", Utf8(document->Url().GetString()));
+  root.Set("printParameters", PrintParameters(print_params));
+  root.Set("pages", std::move(pages));
+  std::string json;
+  if (!base::JSONWriter::Write(root, &json))
+    return String();
+  return String::FromUtf8(std::string_view(json));
+}
+
+String SerializeDomotionPrintScreenStateToken(const LocalFrame& frame) {
+  const Document* document = frame.GetDocument();
+  const LayoutView* layout_view = document ? document->GetLayoutView() : nullptr;
+  if (!document || !layout_view)
+    return String();
+  base::DictValue state;
+  state.Set("frameToken", frame.GetLocalFrameToken().ToString());
+  state.Set("documentToken", document->Token().ToString());
+  state.Set("documentUrl", Utf8(document->Url().GetString()));
+  state.Set("printing", document->Printing());
+  state.Set("physicalFragmentCount",
+            static_cast<int>(layout_view->PhysicalFragmentCount()));
+  state.Set("writingMode", WritingModeName(layout_view->StyleRef().GetWritingMode()));
+  state.Set("direction", layout_view->StyleRef().Direction() == TextDirection::kRtl
+                             ? "rtl"
+                             : "ltr");
+  const PhysicalSize size = layout_view->ViewRect().size;
+  state.Set("width", Number(size.width));
+  state.Set("height", Number(size.height));
+  std::string json;
+  if (!base::JSONWriter::Write(state, &json))
+    return String();
+  return String::FromUtf8(std::string_view(json));
+}
