@@ -16,0 +17 @@ class SkCanvas;
+class SkTextBlob;
@@ -56,0 +58,3 @@ public:
+
+    /** Returns whether text-to-path SVG playback supports every run in `blob`. */
+    static bool CanConvertTextBlobToPaths(const SkTextBlob& blob);
diff --git a/src/svg/SkSVGCanvas.cpp b/src/svg/SkSVGCanvas.cpp
index f0f7d9b..f2fa665 100644
--- a/src/svg/SkSVGCanvas.cpp
+++ b/src/svg/SkSVGCanvas.cpp
@@ -12,0 +13 @@
+#include "src/core/SkTextBlobPriv.h"
@@ -18,0 +20,9 @@
+bool SkSVGCanvas::CanConvertTextBlobToPaths(const SkTextBlob& blob) {
+    for (SkTextBlobRunIterator iterator(&blob); !iterator.done(); iterator.next()) {
+        if (iterator.positioning() == SkTextBlobRunIterator::kRSXform_Positioning) {
+            return false;
+        }
+    }
+    return true;
+}
+
