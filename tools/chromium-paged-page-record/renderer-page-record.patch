+
+String SerializeDomotionPagedPagePaintRecord(
+    const LocalFrame& frame,
+    wtf_size_t selection_index,
+    wtf_size_t page_index,
+    const gfx::Rect& page_rect,
+    const cc::PaintRecord& paint_record,
+    bool has_foreign_layer) {
+  const Document* document = frame.GetDocument();
+  const LayoutView* layout_view = document ? document->GetLayoutView() : nullptr;
+  const PhysicalBoxFragment* page_container =
+      layout_view ? GetPageContainer(*layout_view, page_index) : nullptr;
+  if (!document || !layout_view || !page_container || !document->Printing())
+    return String();
+
+  base::ListValue op_types;
+  base::ListValue unsupported;
+  PageRecordBudget budget;
+  if (has_foreign_layer)
+    unsupported.Append("ForeignLayerDisplayItem");
+  const bool has_child_frame = frame.Tree().FirstChild();
+  if (has_child_frame)
+    unsupported.Append("ChildFrame");
+  const bool supported =
+      !has_foreign_layer && !has_child_frame &&
+      PreflightPaintRecord(paint_record, &op_types, &unsupported, &budget);
+  base::DictValue result;
+  result.Set("selectionIndex", static_cast<int>(selection_index));
+  result.Set("pageIndex", static_cast<int>(page_index));
+  result.Set("pageRect", PhysicalRectValue(PhysicalRect(
+                             PhysicalOffset(LayoutUnit(page_rect.x()),
+                                            LayoutUnit(page_rect.y())),
+                             PhysicalSize(LayoutUnit(page_rect.width()),
+                                          LayoutUnit(page_rect.height())))));
+  const PhysicalBoxFragment& page_border_box =
+      GetPageBorderBox(*page_container);
+  const PhysicalBoxFragment& page_area = GetPageArea(page_border_box);
+  const PhysicalOffset page_border_box_offset =
+      GetPageBorderBoxLink(*page_container).offset;
+  const PhysicalOffset page_area_offset =
+      page_border_box.Children()[0].offset;
+  const double target_scale = TargetScaleForPage(*page_container);
+  result.Set("pageContainer", PhysicalRectValue(
+                                  PhysicalRect(PhysicalOffset(),
+                                               page_container->Size())));
+  result.Set("pageBorderBox", TargetRectValue(
+                                  Number(page_border_box_offset.left),
+                                  Number(page_border_box_offset.top),
+                                  page_border_box.Size(), target_scale));
+  result.Set("pageArea", TargetRectValue(
+                             Number(page_border_box_offset.left) +
+                                 Number(page_area_offset.left) * target_scale,
+                             Number(page_border_box_offset.top) +
+                                 Number(page_area_offset.top) * target_scale,
+                             page_area.Size(), target_scale));
+  result.Set("stitchedContentRect",
+             PhysicalRectValue(StitchedPageContentRect(*page_container)));
+  result.Set("targetScale", target_scale);
+  base::DictValue geometry_spaces;
+  geometry_spaces.Set("pageRect", "paint-cull-layout-css-px");
+  geometry_spaces.Set("pageContainer", "page-container-target-css-px");
+  geometry_spaces.Set("pageBorderBox", "page-container-target-css-px");
+  geometry_spaces.Set("pageArea", "page-container-target-css-px");
+  geometry_spaces.Set("fragments", "native-local-explicit-per-fragment");
+  geometry_spaces.Set("stitchedContentRect", "layout-stitched-css-px");
+  result.Set("geometrySpaces", std::move(geometry_spaces));
+  const AtomicString page_name = page_area.PropagatedPageName();
+  result.Set("pageName", page_name.IsNull() || page_name.empty()
+                             ? base::Value()
+                             : base::Value(Utf8(page_name.GetString())));
+  TableRecordBudget table_budget;
+  SourceIndexMap source_indexes(*document, &table_budget);
+  result.Set("collapsedTablePage", BuildPagedTablePage(
+                                       *layout_view, page_index, source_indexes,
+                                       &table_budget));
+  if (table_budget.exceeded)
+    budget.exceeded = true;
+  base::ListValue fragments;
+  int next_fragment_id = 0;
+  AppendFragmentRecord(*page_container, PhysicalOffset(), false, false,
+                       std::string(), page_index, source_indexes,
+                       &next_fragment_id,
+                       &fragments, &budget);
+  result.Set("fragments", std::move(fragments));
+  result.Set("paintOpTypes", std::move(op_types));
+  if (budget.exceeded) {
+    result.Set("status", "unavailable");
+    result.Set("reason", "record-budget-exceeded");
+    result.Set("unsupportedPaintOps", std::move(unsupported));
+  } else if (!supported) {
+    result.Set("status", "unavailable");
+    result.Set("reason", "unsupported-paint");
+    result.Set("unsupportedPaintOps", std::move(unsupported));
+  } else {
+    BoundedMemoryWStream stream;
+    SkSVGCanvas::Options options;
+    options.flags = static_cast<SkSVGCanvas::Flags>(
+        SkSVGCanvas::kConvertTextToPaths_Flag |
+        SkSVGCanvas::kNoPrettyXML_Flag |
+        SkSVGCanvas::kRelativePathEncoding_Flag);
+    std::unique_ptr<SkCanvas> canvas = SkSVGCanvas::Make(
+        SkRect::MakeWH(Number(page_container->Size().width),
+                       Number(page_container->Size().height)), &stream,
+        options);
+    if (!canvas) {
+      result.Set("status", "unavailable");
+      result.Set("reason", "svg-canvas-unavailable");
+    } else {
+      paint_record.Playback(canvas.get());
+      canvas.reset();
+      if (stream.overflowed()) {
+        result.Set("status", "unavailable");
+        result.Set("reason", "page-svg-too-large");
+        result.Set("maximumPageSvgBytes",
+                   static_cast<int>(kMaximumPageSvgBytes));
+        std::string json;
+        if (!base::JSONWriter::Write(result, &json))
+          return String();
+        return String::FromUtf8(std::string_view(json));
+      }
+      sk_sp<SkData> svg_data = stream.DetachAsData();
+      std::string svg(static_cast<const char*>(svg_data->data()),
+                      svg_data->size());
+      result.Set("status", "authenticated");
+      result.Set("vectorPaintSvg", std::move(svg));
+      result.Set("vectorPaintByteLength",
+                 static_cast<int>(svg_data->size()));
+      result.Set("textConvertedToPaths", true);
+      result.Set("pdfOrScreenshotUsedAsInput", false);
+    }
+  }
+  std::string json;
+  if (!base::JSONWriter::Write(result, &json))
+    return String();
+  return String::FromUtf8(std::string_view(json));
+}
+
+String SerializeDomotionPagedPagePaintEnvelope(
+    const LocalFrame& frame,
+    const Vector<String>& page_records) {
+  const Document* document = frame.GetDocument();
+  if (!document)
+    return String();
+  std::string json =
+      R"({"helperAbi":"domotion-paged-page-record-v1","sourceRevision":")";
+  json += kChromiumRevision;
+  json += R"(","capturePhase":"per-page-after-paint-before-record-consumption","pdfOrScreenshotUsedAsInput":false,"frameToken":")";
+  json += frame.GetLocalFrameToken().ToString();
+  json += R"(","documentToken":")";
+  json += document->Token().ToString();
+  json += R"(","documentUrl":)";
+  json += base::GetQuotedJSONString(Utf8(document->Url().GetString()));
+  json += R"(,"printCaptureId":)";
+  json += base::GetQuotedJSONString(frame.GetPrintParams().domotion_print_capture_id);
+  json += R"(,"pages":[)";
+  for (wtf_size_t index = 0; index < page_records.size(); ++index) {
+    if (index)
+      json += ',';
+    json += page_records[index].Utf8();
+  }
+  json += "]}";
+  return String::FromUtf8(std::string_view(json));
+}
