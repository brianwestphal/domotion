+class BoundedMemoryWStream final : public SkWStream {
+ public:
+  bool write(const void* buffer, size_t size) override {
+    if (overflowed_ || size > kMaximumPageSvgBytes - stream_.bytesWritten()) {
+      overflowed_ = true;
+      return false;
+    }
+    return stream_.write(buffer, size);
+  }
+
+  size_t bytesWritten() const override { return stream_.bytesWritten(); }
+  bool overflowed() const { return overflowed_; }
+  sk_sp<SkData> DetachAsData() { return stream_.detachAsData(); }
+
+ private:
+  SkDynamicMemoryWStream stream_;
+  bool overflowed_ = false;
+};
