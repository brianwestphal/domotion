+struct TableRecordBudget {
+  // A conservative cap keeps worst-case materialized JSON comfortably below
+  // the 8 MiB table-sidecar transport limit before final serialization.
+  static constexpr size_t kMaximumWorkUnits = 10'000;
+  size_t work_units = 0;
+  bool exceeded = false;
+
+  bool Consume() {
+    if (exceeded || work_units++ >= kMaximumWorkUnits) {
+      exceeded = true;
+      return false;
+    }
+    return true;
+  }
+};
