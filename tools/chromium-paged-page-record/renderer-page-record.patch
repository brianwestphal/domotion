+class SourceIndexMap {
+  STACK_ALLOCATED();
+
+ public:
+  SourceIndexMap(const Document& document, TableRecordBudget* budget) {
+    int table_index = 0;
+    int section_index = 0;
+    int row_index = 0;
+    int caption_index = 0;
+    int cell_index = 0;
+    for (Node& node : NodeTraversal::DescendantsOf(document)) {
+      if (!budget->Consume())
+        return;
+      const LayoutObject* object = node.GetLayoutObject();
+      if (!object)
+        continue;
+      if (object->IsTable())
+        table_indexes_.insert(object, table_index++);
+      else if (object->IsTableSection())
+        section_indexes_.insert(object, section_index++);
+      else if (object->IsTableRow())
+        row_indexes_.insert(object, row_index++);
+      else if (object->IsTableCaption())
+        caption_indexes_.insert(object, caption_index++);
+      else if (object->IsTableCell())
+        cell_indexes_.insert(object, cell_index++);
+      if (const auto* box = DynamicTo<LayoutBox>(object)) {
+        for (wtf_size_t index = 0; index < box->PhysicalFragmentCount();
+             ++index) {
+          if (!budget->Consume())
+            return;
+          if (const PhysicalBoxFragment* fragment =
+                  box->GetPhysicalFragment(index)) {
+            occurrence_indexes_.insert(fragment, static_cast<int>(index));
+          }
+        }
+      }
+    }
+  }
+
+  int GetOccurrence(const PhysicalBoxFragment& fragment) const {
+    return Lookup(occurrence_indexes_, &fragment);
+  }
+
+  int Get(SourceKind kind, const LayoutObject* object) const {
+    if (!object || !object->GetNode())
+      return -1;
+    switch (kind) {
+      case SourceKind::kTable:
+        return Lookup(table_indexes_, object);
+      case SourceKind::kSection:
+        return Lookup(section_indexes_, object);
+      case SourceKind::kRow:
+        return Lookup(row_indexes_, object);
+      case SourceKind::kCaption:
+        return Lookup(caption_indexes_, object);
+      case SourceKind::kCell:
+        return Lookup(cell_indexes_, object);
+    }
+  }
+
+ private:
+  template <typename T>
+  static int Lookup(const HeapHashMap<Member<const T>, int>& indexes,
+                    const T* value) {
+    auto iterator = indexes.find(value);
+    return iterator == indexes.end() ? -1 : iterator->value;
+  }
+
+  HeapHashMap<Member<const LayoutObject>, int> table_indexes_;
+  HeapHashMap<Member<const LayoutObject>, int> section_indexes_;
+  HeapHashMap<Member<const LayoutObject>, int> row_indexes_;
+  HeapHashMap<Member<const LayoutObject>, int> caption_indexes_;
+  HeapHashMap<Member<const LayoutObject>, int> cell_indexes_;
+  HeapHashMap<Member<const PhysicalBoxFragment>, int> occurrence_indexes_;
+};
+
+void FindTables(const PhysicalBoxFragment& fragment,
+                HeapVector<Member<const PhysicalBoxFragment>>& tables,
+                TableRecordBudget* budget,
+                size_t depth = 0) {
+  if (depth > 256 || !budget->Consume()) {
+    budget->exceeded = true;
+    return;
+  }
+  if (fragment.IsTable())
+    tables.push_back(&fragment);
+  for (const PhysicalFragmentLink& child : fragment.Children()) {
+    if (const auto* box = DynamicTo<PhysicalBoxFragment>(child.get()))
+      FindTables(*box, tables, budget, depth + 1);
+  }
+}
+
+const PhysicalBoxFragment* FirstSection(const PhysicalBoxFragment& table) {
+  for (const PhysicalFragmentLink& child : table.Children()) {
+    if (child->IsTableSection())
+      return To<PhysicalBoxFragment>(child.get());
+  }
+  return nullptr;
+}
+
+const PhysicalBoxFragment* LastSection(const PhysicalBoxFragment& table) {
+  const auto children = table.Children();
+  for (auto it = children.rbegin(); it != children.rend(); ++it) {
+    if ((*it)->IsTableSection())
+      return To<PhysicalBoxFragment>((*it).get());
+  }
+  return nullptr;
+}
+
+const PhysicalBoxFragment* FirstRow(const PhysicalBoxFragment& section) {
+  for (const PhysicalFragmentLink& child : section.Children()) {
+    if (child->IsTableRow())
+      return To<PhysicalBoxFragment>(child.get());
+  }
+  return nullptr;
+}
+
+const PhysicalBoxFragment* LastRow(const PhysicalBoxFragment& section) {
+  const auto children = section.Children();
+  for (auto it = children.rbegin(); it != children.rend(); ++it) {
+    if ((*it)->IsTableRow())
+      return To<PhysicalBoxFragment>((*it).get());
+  }
+  return nullptr;
+}
+
+bool StartRowFragmented(const PhysicalBoxFragment& section) {
+  const PhysicalBoxFragment* row = FirstRow(section);
+  return row && IsBreakInside(FindPreviousBreakToken(*row));
+}
+
+bool EndRowFragmented(const PhysicalBoxFragment& section) {
+  const PhysicalBoxFragment* row = LastRow(section);
+  if (!row)
+    return false;
+  const auto* token = row->GetBreakToken();
+  return IsBreakInside(token) && !token->IsAtBlockEnd();
+}
