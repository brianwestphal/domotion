+
+std::string FragmentKind(const PhysicalBoxFragment& fragment) {
+  if (fragment.IsTable())
+    return "table";
+  if (fragment.IsTableSection())
+    return "section";
+  if (fragment.IsTableRow())
+    return "row";
+  if (fragment.IsTableCell())
+    return "cell";
+  if (fragment.GetLayoutObject() &&
+      fragment.GetLayoutObject()->IsTableCaption()) {
+    return "caption";
+  }
+  switch (fragment.GetBoxType()) {
+    case PhysicalFragment::kPageContainer:
+      return "page-container";
+    case PhysicalFragment::kPageBorderBox:
+      return "page-border-box";
+    case PhysicalFragment::kPageMargin:
+      return "page-margin";
+    case PhysicalFragment::kPageArea:
+      return "page-area";
+    default:
+      return "box";
+  }
+}
+
+struct PageRecordBudget {
+  size_t fragments = 0;
+  size_t inline_items = 0;
+  size_t paint_ops = 0;
+  bool exceeded = false;
+};
+
+void AppendFragmentRecord(const PhysicalBoxFragment& fragment,
+                          const PhysicalOffset& offset_in_parent,
+                          bool parent_is_layout_space,
+                          bool local_is_layout_space,
+                          const std::string& parent_id,
+                          wtf_size_t page_index,
+                          const SourceIndexMap& source_indexes,
+                          int* next_id,
+                          base::ListValue* records,
+                          PageRecordBudget* budget,
+                          size_t depth = 0) {
+  constexpr size_t kMaximumFragmentsPerPage = 20'000;
+  constexpr size_t kMaximumInlineItemsPerPage = 100'000;
+  constexpr size_t kMaximumFragmentDepth = 256;
+  if (budget->exceeded || depth > kMaximumFragmentDepth ||
+      budget->fragments++ >= kMaximumFragmentsPerPage) {
+    budget->exceeded = true;
+    return;
+  }
+  const int sequence = (*next_id)++;
+  const std::string id = "page:" + std::to_string(page_index) +
+                         "/fragment:" + std::to_string(sequence);
+  base::DictValue value;
+  value.Set("occurrenceId", id);
+  value.Set("parentOccurrenceId",
+            parent_id.empty() ? base::Value() : base::Value(parent_id));
+  value.Set("sequence", sequence);
+  const std::string kind = FragmentKind(fragment);
+  value.Set("kind", kind);
+  value.Set("offsetInParentPhysical", PhysicalOffsetValue(offset_in_parent));
+  value.Set("size", PhysicalSizeValue(fragment.Size()));
+  value.Set("scrollableOverflowLocal", PhysicalRectValue(fragment.ScrollableOverflow()));
+  value.Set("parentCoordinateDomain", parent_is_layout_space
+                                                ? "page-border-box-layout"
+                                                : "page-container-target");
+  value.Set("localCoordinateDomain", local_is_layout_space
+                                               ? "page-border-box-layout"
+                                               : "page-container-target");
+  const ComputedStyle& style = fragment.Style();
+  value.Set("writingMode", WritingModeName(style.GetWritingMode()));
+  value.Set("direction",
+            style.Direction() == TextDirection::kRtl ? "rtl" : "ltr");
+  value.Set("effectiveZoom", style.EffectiveZoom());
+  value.Set("breakBefore", static_cast<int>(style.BreakBefore()));
+  value.Set("breakAfter", static_cast<int>(style.BreakAfter()));
+  Node* node = fragment.GetNode();
+  value.Set("backendNodeId",
+            node ? base::Value(static_cast<int>(node->GetDomNodeId()))
+                 : base::Value());
+  std::optional<SourceKind> source_kind;
+  if (kind == "table")
+    source_kind = SourceKind::kTable;
+  else if (kind == "section")
+    source_kind = SourceKind::kSection;
+  else if (kind == "row")
+    source_kind = SourceKind::kRow;
+  else if (kind == "caption")
+    source_kind = SourceKind::kCaption;
+  else if (kind == "cell")
+    source_kind = SourceKind::kCell;
+  if (source_kind) {
+    value.Set("sourceIndex",
+              source_indexes.Get(*source_kind, fragment.GetLayoutObject()));
+    value.Set("sourceOccurrenceIndex",
+              source_indexes.GetOccurrence(fragment));
+  } else {
+    value.Set("sourceIndex", base::Value());
+    value.Set("sourceOccurrenceIndex", base::Value());
+  }
+  const BlockBreakToken* break_token = fragment.GetBreakToken();
+  if (break_token) {
+    base::DictValue token;
+    token.Set("consumedBlockSize", Number(break_token->ConsumedBlockSize()));
+    token.Set("atBlockEnd", break_token->IsAtBlockEnd());
+    token.Set("forcedBreak", break_token->IsForcedBreak());
+    token.Set("breakInside", IsBreakInside(break_token));
+    token.Set("breakBefore", break_token->IsBreakBefore());
+    token.Set("repeated", break_token->IsRepeated());
+    value.Set("breakToken", std::move(token));
+  } else {
+    value.Set("breakToken", base::Value());
+  }
+  base::ListValue inline_items;
+  if (const FragmentItems* items = fragment.Items()) {
+    int item_sequence = 0;
+    for (const FragmentItem& item : items->Items()) {
+      if (budget->inline_items++ >= kMaximumInlineItemsPerPage) {
+        budget->exceeded = true;
+        break;
+      }
+      base::DictValue item_value;
+      item_value.Set("sequence", item_sequence++);
+      item_value.Set("type", static_cast<int>(item.Type()));
+      item_value.Set("generated", item.IsLayoutGeneratedText());
+      item_value.Set("offsetInContainerFragment",
+                     PhysicalOffsetValue(item.OffsetInContainerFragment()));
+      item_value.Set("size", PhysicalSizeValue(item.Size()));
+      Node* item_node = item.GetLayoutObject()
+                            ? item.GetLayoutObject()->GetNode()
+                            : nullptr;
+      item_value.Set("backendNodeId",
+                     item_node
+                         ? base::Value(static_cast<int>(item_node->GetDomNodeId()))
+                         : base::Value());
+      inline_items.Append(std::move(item_value));
+    }
+  }
+  value.Set("inlineItems", std::move(inline_items));
+  records->Append(std::move(value));
+
+  for (const PhysicalFragmentLink& child : fragment.PostLayoutChildren()) {
+    const auto* child_box = DynamicTo<PhysicalBoxFragment>(child.get());
+    if (!child_box)
+      continue;
+    const bool child_local_is_layout =
+        local_is_layout_space ||
+        (depth == 0 &&
+         child_box->GetBoxType() == PhysicalFragment::kPageBorderBox);
+    AppendFragmentRecord(*child_box, child.offset, local_is_layout_space,
+                         child_local_is_layout, id, page_index, source_indexes,
+                         next_id, records, budget, depth + 1);
+  }
+}
+
+bool PreflightPaintRecord(const cc::PaintRecord& record,
+                          base::ListValue* op_types,
+                          base::ListValue* unsupported,
+                          PageRecordBudget* budget,
+                          size_t depth = 0) {
+  constexpr size_t kMaximumPaintOpsPerPage = 100'000;
+  constexpr size_t kMaximumNestedRecordDepth = 256;
+  if (budget->exceeded || depth > kMaximumNestedRecordDepth) {
+    budget->exceeded = true;
+    return false;
+  }
+  bool supported = true;
+  for (const cc::PaintOp& op : record) {
+    if (budget->paint_ops++ >= kMaximumPaintOpsPerPage) {
+      budget->exceeded = true;
+      return false;
+    }
+    const cc::PaintOpType type = op.GetType();
+    const std::string name = cc::PaintOpTypeToString(type);
+    op_types->Append(name);
+    if (op.IsPaintOpWithFlags()) {
+      const cc::PaintFlags& flags =
+          static_cast<const cc::PaintOpWithFlags&>(op).flags;
+      if (flags.getBlendMode() != SkBlendMode::kSrcOver ||
+          flags.getColorFilter() || flags.getImageFilter() ||
+          flags.HasShader() || flags.getPathEffect() || flags.getLooper() ||
+          flags.isDither()) {
+        unsupported->Append(name + ":unsupported-paint-flags");
+        supported = false;
+        continue;
+      }
+    }
+    switch (type) {
+      case cc::PaintOpType::kCustomData:
+      case cc::PaintOpType::kAnnotate:
+      case cc::PaintOpType::kDrawImage:
+      case cc::PaintOpType::kDrawImageRect:
+      case cc::PaintOpType::kDrawArcLite:
+      case cc::PaintOpType::kDrawLineLite:
+      case cc::PaintOpType::kDrawScrollingContents:
+      case cc::PaintOpType::kDrawSkottie:
+      case cc::PaintOpType::kDrawSlug:
+      case cc::PaintOpType::kDrawVertices:
+      case cc::PaintOpType::kSaveLayer:
+      case cc::PaintOpType::kSaveLayerAlpha:
+      case cc::PaintOpType::kSaveLayerFilters:
+        unsupported->Append(name);
+        supported = false;
+        break;
+      case cc::PaintOpType::kDrawRecord:
+        supported &= PreflightPaintRecord(
+            static_cast<const cc::DrawRecordOp&>(op).record, op_types,
+            unsupported, budget, depth + 1);
+        break;
+      case cc::PaintOpType::kClipPath: {
+        const auto& clip = static_cast<const cc::ClipPathOp&>(op);
+        if (clip.op != SkClipOp::kIntersect || clip.path.isInverseFillType()) {
+          unsupported->Append(name + ":unsupported-clip");
+          supported = false;
+        }
+        break;
+      }
+      case cc::PaintOpType::kClipRRect: {
+        const auto& clip = static_cast<const cc::ClipRRectOp&>(op);
+        if (clip.op != SkClipOp::kIntersect || !clip.rrect.isSimple()) {
+          unsupported->Append(name + ":unsupported-clip");
+          supported = false;
+        }
+        break;
+      }
+      case cc::PaintOpType::kClipRect: {
+        const auto& clip = static_cast<const cc::ClipRectOp&>(op);
+        if (clip.op != SkClipOp::kIntersect) {
+          unsupported->Append(name + ":unsupported-clip");
+          supported = false;
+        }
+        break;
+      }
+      case cc::PaintOpType::kDrawColor:
+        {
+          const auto& draw_color = static_cast<const cc::DrawColorOp&>(op);
+          if (draw_color.mode != SkBlendMode::kSrcOver) {
+          unsupported->Append(name + ":unsupported-blend");
+          supported = false;
+          }
+        }
+        break;
+      case cc::PaintOpType::kDrawPath:
+        if (static_cast<const cc::DrawPathOp&>(op).path.isInverseFillType()) {
+          unsupported->Append(name + ":inverse-fill");
+          supported = false;
+        }
+        break;
+      case cc::PaintOpType::kDrawTextBlob: {
+        const auto& text = static_cast<const cc::DrawTextBlobOp&>(op);
+        if (!text.blob) {
+          unsupported->Append(name + ":missing-text-blob");
+          supported = false;
+          break;
+        }
+        if (!SkSVGCanvas::CanConvertTextBlobToPaths(*text.blob)) {
+          unsupported->Append(name + ":rsxform-positioning");
+          supported = false;
+          break;
+        }
+        SkTextBlob::Iter iterator(*text.blob);
+        SkTextBlob::Iter::ExperimentalRun run;
+        while (iterator.experimentalNext(&run)) {
+          SkTypeface* typeface = run.font.getTypeface();
+          if (typeface &&
+              (typeface->getTableSize(SkSetFourByteTag('C', 'O', 'L', 'R')) ||
+               typeface->getTableSize(SkSetFourByteTag('S', 'V', 'G', ' ')) ||
+               typeface->getTableSize(SkSetFourByteTag('C', 'B', 'D', 'T')) ||
+               typeface->getTableSize(SkSetFourByteTag('s', 'b', 'i', 'x')))) {
+            unsupported->Append(name + ":color-glyph-typeface");
+            supported = false;
+            break;
+          }
+          for (int glyph_index = 0; glyph_index < run.count; ++glyph_index) {
+            const SkGlyphID glyph =
+                UNSAFE_BUFFERS(run.glyphs[glyph_index]);
+            if (!run.font.getPath(glyph).has_value() &&
+                !run.font.getBounds(glyph, nullptr).isEmpty()) {
+              unsupported->Append(name + ":ink-glyph-without-outline");
+              supported = false;
+              break;
+            }
+          }
+          if (!supported)
+            break;
+        }
+        break;
+      }
+      case cc::PaintOpType::kConcat:
+      case cc::PaintOpType::kSetMatrix: {
+        const SkM44& matrix = type == cc::PaintOpType::kConcat
+                                  ? static_cast<const cc::ConcatOp&>(op).matrix
+                                  : static_cast<const cc::SetMatrixOp&>(op).matrix;
+        const bool is_2d =
+            matrix.isFinite() && matrix.rc(0, 2) == 0 &&
+            matrix.rc(1, 2) == 0 && matrix.rc(2, 0) == 0 &&
+            matrix.rc(2, 1) == 0 && matrix.rc(2, 2) == 1 &&
+            matrix.rc(2, 3) == 0 && matrix.rc(3, 2) == 0 &&
+            matrix.rc(3, 3) == 1 && !matrix.asM33().hasPerspective();
+        if (!is_2d) {
+          unsupported->Append(name + ":non-affine");
+          supported = false;
+        }
+        break;
+      }
+      case cc::PaintOpType::kDrawArc:
+      case cc::PaintOpType::kDrawDRRect:
+      case cc::PaintOpType::kDrawIRect:
+      case cc::PaintOpType::kDrawLine:
+      case cc::PaintOpType::kDrawOval:
+      case cc::PaintOpType::kDrawRect:
+      case cc::PaintOpType::kDrawRRect:
+      case cc::PaintOpType::kNoop:
+      case cc::PaintOpType::kRestore:
+      case cc::PaintOpType::kSave:
+      case cc::PaintOpType::kSetNodeId:
+        break;
+      case cc::PaintOpType::kRotate:
+        if (!std::isfinite(static_cast<const cc::RotateOp&>(op).degrees)) {
+          unsupported->Append(name + ":non-finite");
+          supported = false;
+        }
+        break;
+      case cc::PaintOpType::kScale: {
+        const auto& scale = static_cast<const cc::ScaleOp&>(op);
+        if (!std::isfinite(scale.sx) || !std::isfinite(scale.sy)) {
+          unsupported->Append(name + ":non-finite");
+          supported = false;
+        }
+        break;
+      }
+      case cc::PaintOpType::kTranslate: {
+        const auto& translate = static_cast<const cc::TranslateOp&>(op);
+        if (!std::isfinite(translate.dx) || !std::isfinite(translate.dy)) {
+          unsupported->Append(name + ":non-finite");
+          supported = false;
+        }
+        break;
+      }
+      default:
+        unsupported->Append(name + ":not-allowlisted");
+        supported = false;
+        break;
+    }
+  }
+  return supported;
+}
