{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Hot Sheet",
          "rules": [
            {
              "id": "review-note",
              "name": "ReviewNote",
              "shortDescription": {
                "text": "AI-authored, line-anchored review note."
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "review-note",
          "ruleIndex": 0,
          "kind": "informational",
          "level": "none",
          "guid": "mtksc68tnhyu5h69",
          "message": {
            "text": "The fan-in dependency removes the five-way release-not-found cascade. release.yml creates the release before invoking this reusable workflow; every platform retains its staged binary and checksum first, and this single job attaches the complete set. A transient attach failure can therefore be retried from retained artifacts without rebuilding or repeating Apple signing and notarization.",
            "markdown": "The fan-in dependency removes the five-way release-not-found cascade. release.yml creates the release before invoking this reusable workflow; every platform retains its staged binary and checksum first, and this single job attaches the complete set. A transient attach failure can therefore be retried from retained artifacts without rebuilding or repeating Apple signing and notarization."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": ".github/workflows/release-helpers.yml"
                },
                "region": {
                  "startLine": 252,
                  "endLine": 276,
                  "snippet": {
                    "text": "  attach-binaries:\n    needs:\n      - macos-glyph-extractor\n      - linux-glyph-extractor\n      - linux-arm64-glyph-extractor\n      - windows-glyph-extractor\n      - windows-arm64-glyph-extractor\n    runs-on: ubuntu-latest\n    steps:\n      - name: Download retained helper assets\n        uses: actions/download-artifact@v4\n        with:\n          pattern: release-helper-*\n          path: ${{ runner.temp }}/release-helpers\n          merge-multiple: true\n      - name: Attach complete helper set to the existing release\n        env:\n          ASSET_DIR: ${{ runner.temp }}/release-helpers\n          GH_TOKEN: ${{ github.token }}\n          GH_REPO: ${{ github.repository }}\n          TAG: ${{ inputs.tag }}\n        run: |\n          set -euo pipefail\n          gh release view \"$TAG\" >/dev/null\n          gh release upload \"$TAG\" \"$ASSET_DIR\"/* --clobber"
                  }
                }
              }
            }
          ],
          "properties": {
            "tags": [
              "rationale"
            ],
            "ext-ai-tool-confidence": 0.99
          },
          "relatedLocations": [
            {
              "id": 0,
              "physicalLocation": {
                "artifactLocation": {
                  "uri": ".github/workflows/release.yml"
                },
                "region": {
                  "startLine": 181
                }
              }
            }
          ],
          "rank": 96,
          "workItemUris": [
            "DM-2664"
          ],
          "partialFingerprints": {
            "prNoteAnchor/v1": "e9ec043b372ede561077fbba1d092b4d"
          }
        }
      ],
      "versionControlProvenance": [
        {
          "repositoryUri": "git@github.com:brianwestphal/domotion.git",
          "revisionId": "75615b0ef05378edd29d68ad8c7e20412e298200",
          "branch": "main"
        }
      ]
    }
