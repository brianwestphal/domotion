          "guid": "msoa4cfntd3in6o5",
          "message": {
            "text": "Sampled-mode fan-out is based on live byte-00 CI timings: the full 351-stack job completed in 2m19s on Linux and 3m21s on macOS; three Windows shards completed in 4m26s–4m43s. Two Windows shards project to about seven minutes, so routine auto mode uses 1/1/2 jobs while exhaustive mode retains 8/6/16, reducing repeated installs and helper builds from 30 runners to four.",
            "markdown": "Sampled-mode fan-out is based on live byte-00 CI timings: the full 351-stack job completed in 2m19s on Linux and 3m21s on macOS; three Windows shards completed in 4m26s–4m43s. Two Windows shards project to about seven minutes, so routine auto mode uses 1/1/2 jobs while exhaustive mode retains 8/6/16, reducing repeated installs and helper builds from 30 runners to four."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": ".github/workflows/font-conformance-synthetic.yml"
                },
                "region": {
                  "startLine": 99,
                  "endLine": 119,
                  "snippet": {
                    "text": "          if [ \"$requested\" = auto ]; then\n            sample=\"${{ inputs.sample_byte }}\"\n            if [ \"$sample\" = all ] || [ \"$sample\" = ALL ]; then\n              macos_n=8\n              linux_n=6\n              windows_n=16\n            else\n              # Measured on byte 00 / 351 stacks: one macOS shard projects to\n              # 5–7m, one Linux shard to ~2m plus setup, and three Windows\n              # shards to 5–8m. More fan-out mostly recompiles helpers.\n              macos_n=1\n              linux_n=1\n              windows_n=3\n            fi\n          elif [[ \"$requested\" =~ ^[1-9][0-9]*$ ]]; then\n            macos_n=\"$requested\"\n            linux_n=\"$requested\"\n            windows_n=\"$requested\"\n          else\n            echo \"::error::shards must be 'auto' or a positive integer (got '$requested')\"\n            exit 2"
                  }
                }
              }
            }
          ],
