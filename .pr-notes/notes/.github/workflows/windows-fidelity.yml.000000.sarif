          "message": {
            "text": "Windows evidence is wired but not yet ratified from an integrated revision. This job deliberately keeps every logical gate armed at DPR 1 and DPR 4, builds the DirectWrite helper, and retains fingerprinted reports; any mismatch must be classified before production changes. The shared dirty worktree was not published because it contains concurrent tickets.",
            "markdown": "Windows evidence is wired but not yet ratified from an integrated revision. This job deliberately keeps every logical gate armed at DPR 1 and DPR 4, builds the DirectWrite helper, and retains fingerprinted reports; any mismatch must be classified before production changes. The shared dirty worktree was not published because it contains concurrent tickets."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": ".github/workflows/windows-fidelity.yml"
                },
                "region": {
                  "startLine": 121,
                  "endLine": 150,
                  "snippet": {
                    "text": "  decoration-geometry:\n    name: Windows decoration geometry\n    runs-on: windows-latest\n    steps:\n      - uses: actions/checkout@v4\n      - uses: actions/setup-node@v4\n        with: { node-version: '${{ env.NODE_VERSION }}', cache: npm }\n      - run: npm ci\n      - name: Install Chromium\n        run: npx playwright install chromium\n      - name: Build the DirectWrite helper\n        shell: pwsh\n        run: ./tools/win32-glyph-extractor/build.ps1\n      - name: Exact decoration geometry at DPR 1\n        run: >\n          node --import tsx tools/decoration-oracle.ts\n          --device-scale-factor 1\n          --json tests/output/decoration-windows-dpr1.json\n      - name: Exact decoration geometry at DPR 4\n        run: >\n          node --import tsx tools/decoration-oracle.ts\n          --device-scale-factor 4\n          --json tests/output/decoration-windows-dpr4.json\n      - name: Upload fingerprinted decoration evidence\n        if: always()\n        uses: actions/upload-artifact@v4\n        with:\n          name: decoration-geometry-windows\n          path: tests/output/decoration-windows-dpr*.json\n          if-no-files-found: error"
                  }
                }
              }
            }
          ],
