          "guid": "mt6nrzsztaenzsp5",
          "message": {
            "text": "The line-origin oracle passed 7 of 7 source-logical cases with all eight destructive mutations active, and the focused headless E2E suites passed 7 of 7. This matrix runs the same logical report on macOS, Linux, and Windows and requires all three before the named release gate; it adds neither headed execution nor a line-origin visual tolerance.",
            "markdown": "The line-origin oracle passed 7 of 7 source-logical cases with all eight destructive mutations active, and the focused headless E2E suites passed 7 of 7. This matrix runs the same logical report on macOS, Linux, and Windows and requires all three before the named release gate; it adds neither headed execution nor a line-origin visual tolerance."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": ".github/workflows/text-transform-parity.yml"
                },
                "region": {
                  "startLine": 88,
                  "endLine": 108,
                  "snippet": {
                    "text": "      - name: Prove pinned-source line-origin semantics\n        run: npm run transform:text-baseline-protocol -- --json tests/output/text-affine-line-origin-${{ runner.os }}.json\n      - name: Run exact fragment and final-ink legs\n        run: npm run transform:text-parity-gate -- --dpr 1,2 --json tests/output/text-transform-parity-${{ runner.os }}.json\n      - name: Upload fingerprinted report\n        if: always()\n        uses: actions/upload-artifact@v4\n        with:\n          name: transformed-text-${{ runner.os }}\n          path: |\n            tests/output/text-transform-parity-${{ runner.os }}.json\n            tests/output/text-affine-line-origin-${{ runner.os }}.json\n          if-no-files-found: error\n          retention-days: 30\n\n  line-origin-release-gate:\n    name: Structured line-origin release gate\n    needs: parity\n    runs-on: ubuntu-latest\n    steps:\n      - run: echo \"Pinned-source line-origin semantics passed on macOS, Linux, and Windows.\""
                  }
                }
              }
            }
          ],
