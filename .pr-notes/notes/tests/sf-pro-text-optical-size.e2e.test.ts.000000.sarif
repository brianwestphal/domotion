                  "startLine": 61,
                  "endLine": 69,
                  "snippet": {
                    "text": "  it('renders \"SF Pro Text\" diacritics at the Text optical size, not the default master', async () => {\n    // Single-quoted names so the inner quotes don't terminate the double-quoted\n    // `style=\"…\"` attribute (which would silently fall back to Times).\n    const textMaxY = await embeddedRingMaxY(env!.browser, `'SF Pro Text','Arial Unicode MS',sans-serif`);\n    const displayMaxY = await embeddedRingMaxY(env!.browser, `system-ui,sans-serif`);\n    // Compare the two cuts from the SAME installed SFNS build. Absolute glyph\n    // coordinates and even the size of the gap vary by macOS's bundled SFNS\n    // revision (observed gaps: 156 units locally, 16 on the CI runner). The\n    // load-bearing invariant is directional: the explicit Text cut's ring is"
                  }
                }
              }
            }
