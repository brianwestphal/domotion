          "guid": "msqu3kck8weq0x2y",
          "message": {
            "text": "The seven-key expectation mirrors Blink settings, not only CSS-authored generic keywords. standard is the script-keyed implicit terminal in FontFallbackList, and the live probe deliberately measures it alongside serif/sans/fixed/cursive/fantasy/math for every script.",
            "markdown": "The seven-key expectation mirrors Blink settings, not only CSS-authored generic keywords. `standard` is the script-keyed implicit terminal in `FontFallbackList`, and the live probe deliberately measures it alongside serif/sans/fixed/cursive/fantasy/math for every script."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "tests/generic-font-probe.e2e.test.ts"
                },
                "region": {
                  "startLine": 21,
                  "endLine": 30,
                  "snippet": {
                    "text": "    expect(result).not.toBeNull();\n    expect([...result!.common.keys()]).toEqual([\n      \"standard\", \"serif\", \"sans-serif\", \"monospace\", \"cursive\", \"fantasy\", \"math\",\n    ]);\n    for (const script of [\n      \"KATAKANA_OR_HIRAGANA\", \"HANGUL\", \"SIMPLIFIED_HAN\", \"TRADITIONAL_HAN\",\n    ]) {\n      expect([...result!.byScript.get(script)!.keys()])\n        .toEqual([\"standard\", \"serif\", \"sans-serif\", \"monospace\", \"cursive\", \"fantasy\", \"math\"]);\n    }"
                  }
                }
              }
            }
          ],
