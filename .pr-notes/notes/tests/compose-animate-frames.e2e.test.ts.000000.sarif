          "guid": "msnwsbpumcg9xwzr",
          "message": {
            "text": "A real Chromium document pauses every generated animation at 999 ms, 1000 ms, and 1001 ms. The assertions prove that the outgoing frame and overlay disappear exactly at the 1000 ms boundary and only the incoming frame remains opaque; the focused E2E suite passed all 7 tests.",
            "markdown": "A real Chromium document pauses every generated animation at 999 ms, 1000 ms, and 1001 ms. The assertions prove that the outgoing frame and overlay disappear exactly at the 1000 ms boundary and only the incoming frame remains opaque; the focused E2E suite passed all 7 tests."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "tests/compose-animate-frames.e2e.test.ts"
                },
                "region": {
                  "startLine": 46,
                  "endLine": 87,
                  "snippet": {
                    "text": "  it(\"renders exact frame/overlay boundaries without ghost layers (DM-1994)\", async () => {\n    const { browser } = env!;\n    const svg = generateAnimatedSvg({\n      width: 300,\n      height: 120,\n      frames: [\n        {\n          svgContent: '<rect width=\"300\" height=\"120\" fill=\"red\"/>',\n          duration: 1000,\n          transition: { type: \"cut\", duration: 0 },\n          overlays: [{\n            kind: \"svg\", innerSvg: '<rect width=\"20\" height=\"20\"/>',\n            x: 0, y: 0, width: 20, height: 20, animId: \"boundary\", endAt: 1000,\n          }],\n        },\n        {\n          svgContent: '<rect width=\"300\" height=\"120\" fill=\"blue\"/>',\n          duration: 1000,\n          transition: { type: \"cut\", duration: 0 },\n        },\n      ],\n    });\n    const page = await browser.newPage({ viewport: { width: 300, height: 120 } });\n    try {\n      await page.setContent(svg);\n      const sample = async (time: number) => page.evaluate((at) => {\n        for (const animation of document.getAnimations()) {\n          animation.pause();\n          animation.currentTime = at;\n        }\n        const opacity = (selector: string) =>\n          Number.parseFloat(getComputedStyle(document.querySelector(selector)!).opacity);\n        return { outgoing: opacity(\".f-0\"), incoming: opacity(\".f-1\"), overlay: opacity(\".ov-0-boundary\") };\n      }, time);\n\n      expect(await sample(999)).toEqual({ outgoing: 1, incoming: 0, overlay: 1 });\n      expect(await sample(1000)).toEqual({ outgoing: 0, incoming: 1, overlay: 0 });\n      expect(await sample(1001)).toEqual({ outgoing: 0, incoming: 1, overlay: 0 });\n    } finally {\n      await page.close();\n    }\n  });"
                  }
                }
              }
            }
          ],
          "properties": {
