          "guid": "msqvej4u137li35p",
          "message": {
            "text": "The release copy names the bounded transition families instead of advertising arbitrary animation code. This keeps the headline compelling while preserving the security/viewer contract: custom recipes lower only to opacity, transform, clip-path, and the existing shine overlay, with explicit reduced-motion and loop policies.",
            "markdown": "The release copy names the bounded transition families instead of advertising arbitrary animation code. This keeps the headline compelling while preserving the security/viewer contract: custom recipes lower only to opacity, transform, clip-path, and the existing shine overlay, with explicit reduced-motion and loop policies."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "README.md"
                },
                "region": {
                  "startLine": 92,
                  "endLine": 98,
                  "snippet": {
                    "text": "Transitions are not limited to fixed presets. Parameterized `push`, `reveal`,\n`zoom`, and `shine` forms control direction/angle, distance, origin, radius, and\nhighlight styling. A strict `custom` recipe can safely combine incoming/outgoing\nopacity, translate, scale, reveal clip, and shine channels—plus explicit reduced-\nmotion and loop behavior—without accepting raw CSS or script.\n\n### Templates — animated SVGs from a few flags"
                  }
                }
              }
            }
          ],
