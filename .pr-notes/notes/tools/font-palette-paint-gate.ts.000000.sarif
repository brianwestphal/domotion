        {
          "ruleId": "review-note",
          "ruleIndex": 0,
          "kind": "informational",
          "level": "none",
          "guid": "mt5kpjcnp7ml6amj",
          "message": {
            "text": "The native content gate deliberately avoids a whole-image percentage and an adjustable antialiasing envelope. Fully opaque samples must stay inside the two source CPAL endpoint channels; source-constant channels stay exact and source-varying channels remain active. The local pinned-Chromium DPR1/2 run was source-exact: the retained COLRv0 audit passed and all 10 COLRv1 rows passed, including exact missing/mismatched-rule collapse and three distinct active palettes.",
            "markdown": "The native content gate deliberately avoids a whole-image percentage and an adjustable antialiasing envelope. Fully opaque samples must stay inside the two source CPAL endpoint channels; source-constant channels stay exact and source-varying channels remain active. The local pinned-Chromium DPR1/2 run was source-exact: the retained COLRv0 audit passed and all 10 COLRv1 rows passed, including exact missing/mismatched-rule collapse and three distinct active palettes."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "tools/font-palette-paint-gate.ts"
                },
                "region": {
                  "startLine": 112,
                  "endLine": 127,
                  "snippet": {
                    "text": "export function adjudicateColrv1Row(\n  row: Omit<Colrv1PaintRow, \"pass\" | \"blockers\">,\n  expectedEndpoints: [Color, Color],\n): Colrv1PaintRow {\n  const blockers: string[] = [];\n  if (!row.isCustomFont) blockers.push(\"not-custom-font\");\n  if (row.paintedGlyphCount !== 1) blockers.push(\"glyph-count\");\n  if (row.opaquePixelCount === 0) blockers.push(\"no-opaque-paint\");\n  for (let channel = 0; channel < 3; channel += 1) {\n    const low = Math.min(expectedEndpoints[0][channel], expectedEndpoints[1][channel]);\n    const high = Math.max(expectedEndpoints[0][channel], expectedEndpoints[1][channel]);\n    if (row.channelMin[channel] < low || row.channelMax[channel] > high) blockers.push(`channel-${channel}-outside-source`);\n    if (low === high && (row.channelMin[channel] !== low || row.channelMax[channel] !== high)) blockers.push(`channel-${channel}-constant`);\n    if (low !== high && row.channelMin[channel] === row.channelMax[channel]) blockers.push(`channel-${channel}-inert`);\n  }\n  return { ...row, pass: blockers.length === 0, blockers };"
                  }
                }
              }
            }
          ],
