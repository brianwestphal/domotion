          "guid": "mt157h1r0bxc6jst",
          "message": {
            "text": "The joined record preserves the CDP observability boundary instead of attributing helper glyph IDs to Chromium. Blink stores glyph data in ShapeResultRun, while public CDP exposes painted faces and DOM geometry; therefore glyph equivalence is asserted only when the concrete PostScript face agrees, and a different face remains explicitly non-comparable.",
            "markdown": "The joined record preserves the CDP observability boundary instead of attributing helper glyph IDs to Chromium. Blink stores glyph data in ShapeResultRun, while public CDP exposes painted faces and DOM geometry; therefore glyph equivalence is asserted only when the concrete PostScript face agrees, and a different face remains explicitly non-comparable."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "tools/unified-shaping-oracle.ts"
                },
                "region": {
                  "startLine": 45,
                  "endLine": 60,
                  "snippet": {
                    "text": "export function joinShapingEvidence(record: ExactRecord, paintedFaces: PaintedFace[], paintedOrigins: PaintedOrigin[], faceObservation: FaceObservation = \"matched\"): Record<string, unknown> {\n  const localPostscriptName = record.face.localPostscriptName;\n  const faceAgreement = localPostscriptName != null\n    && paintedFaces.some((face) => normalizeFace(face.postScriptName) === normalizeFace(localPostscriptName));\n  return {\n    environment: record.environment,\n    input: record.input,\n    chrome: {\n      paintedFaces,\n      paintedOrigins,\n      glyphIds: { status: \"not-exposed-by-cdp\", owner: \"Blink ShapeResultRun / HarfBuzzRunGlyphData\" },\n    },\n    helper: { ...record.face, fallbackRuns: record.fallbackRuns },\n    glyphs: record.glyphs,\n    comparison: { faceAgreement, faceObservation, glyphIds: faceAgreement ? \"source-equivalent-same-face\" : \"not-compared-across-different-faces\", paintedOrigins: \"recorded-not-inferred-from-pixels\" },\n  };"
                  }
                }
              }
            }
          ],
          "properties": {
            "tags": [
              "rationale"
            ],
            "ext-ai-tool-confidence": 0.98
          },
          "rank": 95,
          "workItemUris": [
            "DM-2341"
          ],
          "partialFingerprints": {
            "prNoteAnchor/v1": "c4616355670019f6db883c21f43afe28"
          }
        },
        {
          "ruleId": "review-note",
          "ruleIndex": 0,
          "kind": "informational",
          "level": "none",
          "guid": "mt157h74por0ms2g",
          "message": {
            "text": "Protected system faces are resolved by an oracle-only candidate walk, never by adding production routing rules. Every candidate is forced through style/layout before CDP inspection, accepted only on exact normalized PostScript agreement, and exhausted failures remain visibly classified as CSS-unaddressable. The final macOS run matched 672/687 records; the 15 explicit non-matches were limited to SF Mono and SF Compact protected/named-instance keys.",
            "markdown": "Protected system faces are resolved by an oracle-only candidate walk, never by adding production routing rules. Every candidate is forced through style/layout before CDP inspection, accepted only on exact normalized PostScript agreement, and exhausted failures remain visibly classified as CSS-unaddressable. The final macOS run matched 672/687 records; the 15 explicit non-matches were limited to SF Mono and SF Compact protected/named-instance keys."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "tools/unified-shaping-oracle.ts"
                },
                "region": {
                  "startLine": 123,
                  "endLine": 151,
                  "snippet": {
                    "text": "        const targetPostscript = exactRecord.face.localPostscriptName;\n        let faceObservation: FaceObservation = \"matched\";\n        if (targetPostscript != null && !fonts.some((font) => normalizeFace(font.postScriptName) === normalizeFace(targetPostscript))) {\n          const inferredFamily = targetPostscript.replace(/^\\./, \"\").replace(/-(?:Regular|Italic|Light|Medium|Bold).*$/i, \"\");\n          const keyFamily = exactRecord.face.key.replace(/^(?:sysfb|winfam):/, \"\").replace(/-(?:regular|italic|light|medium|bold).*$/i, \"\").replaceAll(\"-\", \" \");\n          const candidates = [...new Set([inferredFamily, keyFamily, \"system-ui\", \"-apple-system\", \"ui-monospace\", \"sans-serif\", \"serif\", \"monospace\"])]\n            .flatMap((family) => [300, 400, 500, 700].map((weight) => ({ family, weight, style: /italic/i.test(targetPostscript) ? \"italic\" : \"normal\" })));\n          let winner: { selector: string; nodeId: number; fonts: typeof fonts } | undefined;\n          for (let candidateIndex = 0; candidateIndex < candidates.length; candidateIndex++) {\n            const candidate = candidates[candidateIndex];\n            const id = `candidate-${index}-${candidateIndex}`;\n            const generic = new Set([\"system-ui\", \"-apple-system\", \"ui-monospace\", \"sans-serif\", \"serif\", \"monospace\"]).has(candidate.family);\n            const cssFamily = generic ? candidate.family : `\"${candidate.family}\"`;\n            await page.evaluate(`(() => { const source=document.querySelector(${JSON.stringify(selector)}); const span=source.cloneNode(true); span.id=${JSON.stringify(id)}; span.style.fontFamily=${JSON.stringify(cssFamily)}; span.style.fontWeight=${JSON.stringify(String(candidate.weight))}; span.style.fontStyle=${JSON.stringify(candidate.style)}; document.body.append(span); })()`);\n            await page.evaluate((candidateSelector) => document.querySelector(candidateSelector)?.getBoundingClientRect(), `#${id}`);\n            const candidateNode = await cdp.send(\"DOM.querySelector\", { nodeId: root.nodeId, selector: `#${id}` });\n            const candidateFonts = await cdp.send(\"CSS.getPlatformFontsForNode\", { nodeId: candidateNode.nodeId });\n            if (candidateFonts.fonts.some((font) => normalizeFace(font.postScriptName) === normalizeFace(targetPostscript))) {\n              winner = { selector: `#${id}`, nodeId: candidateNode.nodeId, fonts: candidateFonts.fonts };\n              break;\n            }\n          }\n          if (winner != null) {\n            selector = winner.selector;\n            nodeId = winner.nodeId;\n            fonts = winner.fonts;\n          } else {\n            faceObservation = \"css-unaddressable-after-candidate-walk\";\n          }"
                  }
                }
              }
            }
          ],
          "properties": {
