          "message": {
            "text": "The progress prefix exposes both the current stack ordinal and the shard's assigned total. A canceled CI job now identifies its completed stack prefix directly, rather than leaving reviewers to count repeated stack headers around thousands of per-batch codepoint lines.",
            "markdown": "The progress prefix exposes both the current stack ordinal and the shard's assigned total. A canceled CI job now identifies its completed stack prefix directly, rather than leaving reviewers to count repeated stack headers around thousands of per-batch codepoint lines."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "tools/font-conformance.ts"
                },
                "region": {
                  "startLine": 1337,
                  "endLine": 1346,
                  "snippet": {
                    "text": "    for (const [stackIndex, spec] of stacks.entries()) {\n      let rs = prepareStack(spec, opts.lang);\n      if (rs == null) {\n        skippedStacks++;\n        process.stdout.write(`  SKIP (no resolvable primary): ${spec.fontFamily}\\n`);\n        continue;\n      }\n      process.stdout.write(\n        `  stack ${stackIndex + 1}/${stacks.length}: ${spec.fontFamily} @${spec.fontSize}px/${spec.fontWeight}/${spec.fontStyle}`\n        + ` lang=${spec.lang ?? opts.lang} → chain [${rs.chain.join(\", \")}]\\n`,"
                  }
                }
              }
            }
          ],
