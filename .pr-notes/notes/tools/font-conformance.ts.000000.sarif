          "guid": "mso770stxt6ytdxf",
          "message": {
            "text": "The oracle now initializes Domotion from the same Chromium context it measures. This prevents a loaded CI runner’s runtime generic-family state from being compared against unrelated static assumptions; an unstable probe is a harness error rather than a plausible but invalid baseline.",
            "markdown": "The oracle now initializes Domotion from the same Chromium context it measures. This prevents a loaded CI runner’s runtime generic-family state from being compared against unrelated static assumptions; an unstable probe is a harness error rather than a plausible but invalid baseline."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "tools/font-conformance.ts"
                },
                "region": {
                  "startLine": 851,
                  "endLine": 866,
                  "snippet": {
                    "text": "  static async create(browser: Browser, concurrency: number, lang: string): Promise<ChromeOracle> {\n    const ctx = await browser.newContext({ viewport: { width: 1200, height: 800 } });\n    // Resolve settings-backed families from the exact Chromium context whose\n    // answers this oracle compares. Browser launch shape and Playwright's\n    // Page.setFontFamilies override are runtime inputs to Blink, not constants\n    // that can be transcribed from the Chromium checkout.\n    const generics = await probeSessionGenericFamilies(ctx);\n    if (generics == null) {\n      throw new Error(\"oracle: Chromium session-family probe did not stabilize\");\n    }\n    setSessionGenericFamilyOverrides(generics);\n    const page = await ctx.newPage();\n    const cdp = await ctx.newCDPSession(page);\n    await cdp.send(\"DOM.enable\");\n    await cdp.send(\"CSS.enable\");\n    return new ChromeOracle(page, cdp, concurrency, lang);"
                  }
                }
              }
            }
          ],
