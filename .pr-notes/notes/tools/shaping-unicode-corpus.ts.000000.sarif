          "message": {
            "text": "Canonical SHA-256 identities make representative sampling and shard ownership independent of extraction/filesystem order. Mismatch reduction groups only logical signatures and retains a raw example; it never alters the underlying report or exit code, so reduction cannot become an allowlist.",
            "markdown": "Canonical SHA-256 identities make representative sampling and shard ownership independent of extraction/filesystem order. Mismatch reduction groups only logical signatures and retains a raw example; it never alters the underlying report or exit code, so reduction cannot become an allowlist."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "tools/shaping-unicode-corpus.ts"
                },
                "region": {
                  "startLine": 17,
                  "endLine": 31,
                  "snippet": {
                    "text": "export function selectCorpusRuns(runs: CorpusRun[], mode: CorpusMode, shardIndex: number, shardCount: number, representativeLimit = 4096): CorpusRun[] {\n  if (!Number.isInteger(shardIndex) || !Number.isInteger(shardCount) || shardCount < 1 || shardIndex < 0 || shardIndex >= shardCount) throw new Error(\"invalid shard i/n\");\n  const ordered = [...runs].sort((a, b) => runIdentity(a).localeCompare(runIdentity(b)));\n  const population = mode === \"representative\" ? ordered.slice(0, representativeLimit) : ordered;\n  return population.filter((run) => Number.parseInt(runIdentity(run).slice(0, 8), 16) % shardCount === shardIndex);\n}\n\nexport function reduceMismatches(rows: Array<Record<string, unknown>>) {\n  const groups = new Map<string, { signature: string; count: number; example: Record<string, unknown> }>();\n  for (const row of rows) {\n    const signature = [row.verdict, row.fontFamily, row.chromeGlyphs, row.ourGlyphs, row.maxDelta].join(\"|\");\n    const hit = groups.get(signature);\n    if (hit == null) groups.set(signature, { signature, count: 1, example: row }); else hit.count++;\n  }\n  return [...groups.values()].sort((a, b) => b.count - a.count || a.signature.localeCompare(b.signature));"
                  }
                }
              }
            }
          ],
          "properties": {
            "tags": [
              "rationale"
            ],
