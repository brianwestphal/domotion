          "message": {
            "text": "The production browser gate now rejects face-only or fixture-fitted agreement. Eleven DM-2387 rows require exact nonempty glyph, cluster, advance, offset, and source-span records plus selected-face glyph counts equal to Chromium CDP; enabled routes cannot report legacy assignment; canonical text cannot be substituted; and paired bare/explicit Thai circle inputs must yield distinct glyph signatures. The 29-case Chromium run completed evidence-complete with every control true.",
            "markdown": "The production browser gate now rejects face-only or fixture-fitted agreement. Eleven DM-2387 rows require exact nonempty glyph, cluster, advance, offset, and source-span records plus selected-face glyph counts equal to Chromium CDP; enabled routes cannot report legacy assignment; canonical text cannot be substituted; and paired bare/explicit Thai circle inputs must yield distinct glyph signatures. The 29-case Chromium run completed evidence-complete with every control true."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
