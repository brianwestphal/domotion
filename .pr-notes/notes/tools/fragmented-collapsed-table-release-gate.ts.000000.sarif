{"version":"2.1.0","$schema":"https://json.schemastore.org/sarif-2.1.0.json","runs":[{"tool":{"driver":{"name":"Glassbox","rules":[{"id":"mt6wtablegate1","shortDescription":{"text":"Keep fragmented-table logical and ink evidence independent"}}]}},"results":[{"ruleId":"mt6wtablegate1","level":"note","message":{"text":"The release gate intentionally requires three screen-logical reports, three public-print fail-closed reports, and three native final-ink reports as separate inputs. This prevents a green raster envelope from promoting missing fragment, repeat-occurrence, or print-fragment ownership. The workflow uses explicitly headless Chromium and leaves the reviewed border envelopes unchanged."},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"tools/fragmented-collapsed-table-release-gate.ts"},"region":{"startLine":1}}}]}]}]}
