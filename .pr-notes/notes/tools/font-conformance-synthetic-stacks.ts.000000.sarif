          "guid": "msmz38m5ry70a84i",
          "message": {
            "text": "Quoted literal arms use a fixed Menlo continuation so walking past the generic-spelled family is observable. The case-variant is quoted too: the live Chromium probe disproved the bare-case draft because CSS parses bare Serif case-insensitively as the generic keyword; \"Serif\", Menlo reaches the literal-family path this axis is meant to guard.",
            "markdown": "Quoted literal arms use a fixed Menlo continuation so walking past the generic-spelled family is observable. The case-variant is quoted too: the live Chromium probe disproved the bare-case draft because CSS parses bare `Serif` case-insensitively as the generic keyword; `\"Serif\", Menlo` reaches the literal-family path this axis is meant to guard."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "tools/font-conformance-synthetic-stacks.ts"
                },
                "region": {
                  "startLine": 213,
                  "endLine": 228,
                  "snippet": {
                    "text": "/** Spellings whose distinction Blink preserves through computed style. */\nexport const FAMILY_SPELLINGS = [\"keyword\", \"quoted\", \"case-variant\"] as const;\nexport type FamilySpelling = typeof FAMILY_SPELLINGS[number];\n\n/** The union of Playwright's script-keyed generic-family tables on macOS and Windows. */\nexport const LANGUAGES: readonly (string | null)[] = [\n  null, \"ja\", \"ko\", \"zh-Hans\", \"zh-Hant\", \"ru\", \"ar\", \"el\",\n];\n\nfunction familyForSpelling(generic: string, spelling: FamilySpelling): string {\n  if (spelling === \"keyword\") return generic;\n  const literal = spelling === \"quoted\"\n    ? generic\n    : `${generic[0].toUpperCase()}${generic.slice(1)}`;\n  // A continuation makes walking past an unavailable literal observable.\n  return `\"${literal}\", Menlo`;"
                  }
                }
              }
            }
          ],
