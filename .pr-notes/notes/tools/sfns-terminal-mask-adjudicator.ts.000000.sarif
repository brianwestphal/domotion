          "guid": "mt7dsx1qrqxjesdb",
          "message": {
            "text": "Only the first four serialized record bytes are normalized because they are the process-local SkTypefaceID; every source-owned record field and all remaining bytes stay exact. This is the narrowest normalization that permits independent processes without weakening the byte-for-byte contract.",
            "markdown": "Only the first four serialized record bytes are normalized because they are the process-local SkTypefaceID; every source-owned record field and all remaining bytes stay exact. This is the narrowest normalization that permits independent processes without weakening the byte-for-byte contract."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "tools/sfns-terminal-mask-adjudicator.ts"
                },
                "region": {
                  "startLine": 213,
                  "endLine": 232,
                  "snippet": {
                    "text": "function recordWithoutRuntimeTypeface(\n  rec: SfnsRecEvidence | SfnsValidationRec,\n): unknown {\n  const bytes = decodeBase64(rec.bytesBase64);\n  if (bytes == null || bytes.length < 4) {\n    return { invalidBase64: true, byteLength: rec.byteLength };\n  }\n  bytes.fill(0, 0, 4);\n  return {\n    byteLength: rec.byteLength,\n    bytesBase64: bytes.toString(\"base64\"),\n    sha256: shaBytes(bytes),\n    dump: rec.dump,\n    textSize: rec.textSize,\n    maskFormat: rec.maskFormat,\n    flags: rec.flags,\n    hinting: rec.hinting,\n    luminanceColor: rec.luminanceColor,\n    singleMatrix: rec.singleMatrix,\n  };"
                  }
                }
              }
            }
          ],
          "properties": {
            "tags": [
              "rationale"
            ],
            "ext-ai-tool-confidence": 0.98
          },
