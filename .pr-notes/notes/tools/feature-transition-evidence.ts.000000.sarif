          "guid": "mtim9coa7wh53h07",
          "message": {
            "text": "Transition evidence is parsed as syntax instead of checked with a source substring. A path-only manifest let an unrelated test satisfy a claim, and a substring check would merely move that loophole to comments or fixtures; exact literal it/test titles make the named assertion reviewable and rename-sensitive while still supporting .skip, .only, and .each.",
            "markdown": "Transition evidence is parsed as syntax instead of checked with a source substring. A path-only manifest let an unrelated test satisfy a claim, and a substring check would merely move that loophole to comments or fixtures; exact literal `it`/`test` titles make the named assertion reviewable and rename-sensitive while still supporting `.skip`, `.only`, and `.each`."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "tools/feature-transition-evidence.ts"
                },
                "region": {
                  "startLine": 17,
                  "endLine": 47,
                  "snippet": {
                    "text": "/**\n * Return the literal titles declared by Vitest/Jest-style `it` and `test`\n * calls. Parsing the source prevents a title copied into a comment, fixture, or\n * unrelated string from masquerading as an assertion.\n */\nexport function declaredTestTitles(source: string, fileName = \"test.ts\"): Set<string> {\n  const file = ts.createSourceFile(fileName, source, ts.ScriptTarget.Latest, true,\n    fileName.endsWith(\"x\") ? ts.ScriptKind.TSX : ts.ScriptKind.TS);\n  const titles = new Set<string>();\n\n  const rootCallName = (expr: ts.Expression): string | null => {\n    if (ts.isIdentifier(expr)) return expr.text;\n    if (ts.isPropertyAccessExpression(expr)) return rootCallName(expr.expression);\n    if (ts.isCallExpression(expr)) return rootCallName(expr.expression);\n    return null;\n  };\n\n  const visit = (node: ts.Node): void => {\n    if (ts.isCallExpression(node)) {\n      const root = rootCallName(node.expression);\n      const title = node.arguments[0];\n      if ((root === \"it\" || root === \"test\")\n        && title != null\n        && (ts.isStringLiteral(title) || ts.isNoSubstitutionTemplateLiteral(title))) {\n        titles.add(title.text);\n      }\n    }\n    ts.forEachChild(node, visit);\n  };\n  visit(file);\n  return titles;"
                  }
                }
              }
            }
          ],
