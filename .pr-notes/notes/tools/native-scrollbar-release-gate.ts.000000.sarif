          "guid": "mt455q1vhrmlgff9",
          "message": {
            "text": "The release adjudicator intentionally rejects every observational gap route and every non-captured paint row. DM-2481 proves ownership but does not paint custom parts or native strips; accepting its 23 observational passes here would convert explicit unknowns into a false release claim. DM-2482 and DM-2483 must change the producer facts, never this condition.",
            "markdown": "The release adjudicator intentionally rejects every observational gap route and every non-captured paint row. DM-2481 proves ownership but does not paint custom parts or native strips; accepting its 23 observational passes here would convert explicit unknowns into a false release claim. DM-2482 and DM-2483 must change the producer facts, never this condition."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "tools/native-scrollbar-release-gate.ts"
                },
                "region": {
                  "startLine": 273,
                  "endLine": 289,
                  "snippet": {
                    "text": "\n  if (row.expectedRoute === \"custom-vector\") {\n    const sourceClasses = Object.entries(row.sourcePixels.markers)\n      .filter(([, bounds]) => bounds != null).map(([name]) => name).sort();\n    const generatedClasses = Object.entries(row.generatedPixels.markers)\n      .filter(([, bounds]) => bounds != null).map(([name]) => name).sort();\n    if (sourceClasses.join(\"|\") !== generatedClasses.join(\"|\")) {\n      blockers.push(`${key}: custom marker classification differs (${sourceClasses} vs ${generatedClasses})`);\n    }\n    for (const name of sourceClasses) {\n      const source = row.sourcePixels.markers[name];\n      const generated = row.generatedPixels.markers[name];\n      if (source != null && generated != null && boundsDelta(source, generated) > 1) {\n        blockers.push(`${key}: ${name} bound delta exceeds 1 device pixel`);\n      }\n    }\n  }"
                  }
                }
              }
            }
