                  "snippet": {
                    "text": "    const svg = `<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"${PAGE_WIDTH}\" height=\"${height}\" viewBox=\"0 0 ${PAGE_WIDTH} ${height}\">${inner}</svg>`;\n    const svgPage = await context.newPage();\n    await svgPage.setContent(`<style>html,body{margin:0;background:transparent}img{display:block;width:${PAGE_WIDTH}px;height:${height}px}</style><img>`, { waitUntil: \"load\" });\n    await svgPage.locator(\"img\").evaluate((img, src) => { (img as HTMLImageElement).src = `data:image/svg+xml;base64,${src}`; }, Buffer.from(svg).toString(\"base64\"));"
                  }
