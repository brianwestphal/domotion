        {
          "ruleId": "review-note",
          "ruleIndex": 0,
          "kind": "informational",
          "level": "none",
          "guid": "mtv4m4bcdlzlcj1p",
          "message": {
            "text": "Page pseudo-fragment geometry comes from the container-to-border-to-area fragment links, never the CSS-box-only OffsetFromOwnerLayoutBox API. A live four-page helper smoke exposed the invalid call as a DCHECK, and the corrected link-owned offsets now pass with source restoration and authenticated vector paint on every page.",
            "markdown": "Page pseudo-fragment geometry comes from the container-to-border-to-area fragment links, never the CSS-box-only OffsetFromOwnerLayoutBox API. A live four-page helper smoke exposed the invalid call as a DCHECK, and the corrected link-owned offsets now pass with source restoration and authenticated vector paint on every page."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "tools/chromium-paged-page-record/renderer-page-record.patch"
                },
                "region": {
                  "startLine": 1883,
                  "endLine": 1896,
                  "snippet": {
                    "text": "+  const PhysicalBoxFragment& page_area = GetPageArea(page_border_box);\n+  const PhysicalOffset page_border_box_offset =\n+      GetPageBorderBoxLink(*page_container).offset;\n+  const PhysicalOffset page_area_offset =\n+      page_border_box_offset + page_border_box.Children()[0].offset;\n+  result.Set(\"pageContainer\", PhysicalRectValue(\n+                                  PhysicalRect(PhysicalOffset(),\n+                                               page_container->Size())));\n+  result.Set(\"pageBorderBox\", PhysicalRectValue(\n+                                  PhysicalRect(page_border_box_offset,\n+                                               page_border_box.Size())));\n+  result.Set(\"pageArea\", PhysicalRectValue(\n+                             PhysicalRect(page_area_offset,\n+                                          page_area.Size())));"
                  }
                }
              }
            }
          ],
