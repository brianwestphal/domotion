          "guid": "mtv4m3xcnv83jyf7",
          "message": {
            "text": "The helper captures the finalized inner PaintRecord before the same record is consumed by the outer print canvas. That boundary preserves page-specific lifecycle, transform, clip, linked-destination, and paint results while the print fragment tree is still alive; neither PDF nor screenshot bytes participate.",
            "markdown": "The helper captures the finalized inner PaintRecord before the same record is consumed by the outer print canvas. That boundary preserves page-specific lifecycle, transform, clip, linked-destination, and paint results while the print fragment tree is still alive; neither PDF nor screenshot bytes participate."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "tools/chromium-paged-page-record/renderer-page-record.patch"
                },
                "region": {
                  "startLine": 622,
                  "endLine": 632,
                  "snippet": {
                    "text": "+    PaintRecord record =\n+        builder.EndRecording(property_tree_state.Unalias());\n+    if (domotion_paged_page_record_enabled_) {\n+      domotion_paged_page_records_.push_back(\n+          SerializeDomotionPagedPagePaintRecord(\n+              *GetFrame(), domotion_paged_page_records_.size(), page_index,\n+              page_rect, record));\n+    }\n+    context.DrawRecord(std::move(record));\n     context.Restore();\n   }"
                  }
                }
              }
            }
          ],
          "properties": {
            "tags": [
              "rationale"
            ],
            "ext-ai-tool-confidence": 0.99
          },
          "rank": 99,
          "workItemUris": [
            "DM-2710"
          ],
          "partialFingerprints": {
            "prNoteAnchor/v1": "af7903ab77c33f14be9b9f79305503de"
          }
        },
        {
          "ruleId": "review-note",
          "ruleIndex": 0,
          "kind": "informational",
          "level": "warning",
          "guid": "mtv4m44ihhide1rh",
          "message": {
            "text": "SkSVGCanvas is accepted only behind recursive nested-record preflight. Known lossy constructs, non-SrcOver flags, filters, inverse paths, unsupported clips, and perspective matrices make the page unavailable before replay; extending the allowlist requires a source-level exactness test.",
            "markdown": "SkSVGCanvas is accepted only behind recursive nested-record preflight. Known lossy constructs, non-SrcOver flags, filters, inverse paths, unsupported clips, and perspective matrices make the page unavailable before replay; extending the allowlist requires a source-level exactness test."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "tools/chromium-paged-page-record/renderer-page-record.patch"
                },
                "region": {
                  "startLine": 1783,
                  "endLine": 1854,
                  "snippet": {
                    "text": "+bool PreflightPaintRecord(const cc::PaintRecord& record,\n+                          base::ListValue* op_types,\n+                          base::ListValue* unsupported) {\n+  bool supported = true;\n+  for (const cc::PaintOp& op : record) {\n+    const cc::PaintOpType type = op.GetType();\n+    const std::string name = cc::PaintOpTypeToString(type);\n+    op_types->Append(name);\n+    if (op.IsPaintOpWithFlags()) {\n+      const cc::PaintFlags& flags =\n+          static_cast<const cc::PaintOpWithFlags&>(op).flags;\n+      if (flags.getBlendMode() != SkBlendMode::kSrcOver ||\n+          flags.getColorFilter() || flags.getImageFilter()) {\n+        unsupported->Append(name + \":unsupported-paint-flags\");\n+        supported = false;\n+        continue;\n+      }\n+    }\n+    switch (type) {\n+      case cc::PaintOpType::kCustomData:\n+      case cc::PaintOpType::kDrawScrollingContents:\n+      case cc::PaintOpType::kDrawSkottie:\n+      case cc::PaintOpType::kDrawSlug:\n+      case cc::PaintOpType::kDrawVertices:\n+      case cc::PaintOpType::kSaveLayerFilters:\n+        unsupported->Append(name);\n+        supported = false;\n+        break;\n+      case cc::PaintOpType::kDrawRecord:\n+        supported &= PreflightPaintRecord(\n+            static_cast<const cc::DrawRecordOp&>(op).record, op_types,\n+            unsupported);\n+        break;\n+      case cc::PaintOpType::kClipPath: {\n+        const auto& clip = static_cast<const cc::ClipPathOp&>(op);\n+        if (clip.op != SkClipOp::kIntersect || clip.path.isInverseFillType()) {\n+          unsupported->Append(name + \":unsupported-clip\");\n+          supported = false;\n+        }\n+        break;\n+      }\n+      case cc::PaintOpType::kDrawPath:\n+        if (static_cast<const cc::DrawPathOp&>(op).path.isInverseFillType()) {\n+          unsupported->Append(name + \":inverse-fill\");\n+          supported = false;\n+        }\n+        break;\n+      case cc::PaintOpType::kConcat:\n+      case cc::PaintOpType::kSetMatrix: {\n+        const SkM44& matrix = type == cc::PaintOpType::kConcat\n+                                  ? static_cast<const cc::ConcatOp&>(op).matrix\n+                                  : static_cast<const cc::SetMatrixOp&>(op).matrix;\n+        const bool is_2d =\n+            matrix.isFinite() && matrix.rc(0, 2) == 0 &&\n+            matrix.rc(1, 2) == 0 && matrix.rc(2, 0) == 0 &&\n+            matrix.rc(2, 1) == 0 && matrix.rc(2, 2) == 1 &&\n+            matrix.rc(2, 3) == 0 && matrix.rc(3, 2) == 0 &&\n+            matrix.rc(3, 3) == 1 && !matrix.asM33().hasPerspective();\n+        if (!is_2d) {\n+          unsupported->Append(name + \":non-affine\");\n+          supported = false;\n+        }\n+        break;\n+      }\n+      default:\n+        break;\n+    }\n+  }\n+  return supported;\n+}\n+\n+}  // namespace"
                  }
                }
              }
            }
          ],
          "properties": {
