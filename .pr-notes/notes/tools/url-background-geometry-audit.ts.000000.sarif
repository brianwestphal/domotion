          "message": {
            "text": "Every native producer persists the exact source PNG, generated PNG/SVG, and restart mutation pair with byte count and SHA-256. The workflow uploads those platform-local surfaces together with the Chromium, Playwright, source, OS/runner, viewport, and DPR fingerprint instead of sharing a screenshot baseline across operating systems.",
            "markdown": "Every native producer persists the exact source PNG, generated PNG/SVG, and restart mutation pair with byte count and SHA-256. The workflow uploads those platform-local surfaces together with the Chromium, Playwright, source, OS/runner, viewport, and DPR fingerprint instead of sharing a screenshot baseline across operating systems."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "tools/url-background-geometry-audit.ts"
                },
                "region": {
                  "startLine": 758,
                  "endLine": 774,
                  "snippet": {
                    "text": "function persistArtifact(\n  root: string | undefined,\n  relativePath: string,\n  role: EvidenceArtifact[\"role\"],\n  contents: Buffer | string,\n): EvidenceArtifact | null {\n  if (root == null) return null;\n  const path = join(root, relativePath);\n  mkdirSync(dirname(path), { recursive: true });\n  writeFileSync(path, contents);\n  return {\n    role,\n    path: relativePath.replaceAll(\"\\\\\", \"/\"),\n    bytes: Buffer.byteLength(contents),\n    sha256: sha256(contents),\n  };\n}"
                  }
                }
              }
            }
          ],
