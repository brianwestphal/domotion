          "guid": "msuerxk3oxsy3fua",
          "message": {
            "text": "The workflow status is the synchronization boundary, not the watch subprocess. A failed matrix can make gh run watch return while the always-running aggregate is still queued; polling to completed prevents the artifact retry budget from being consumed by runner-capacity delay.",
            "markdown": "The workflow status is the synchronization boundary, not the watch subprocess. A failed matrix can make gh run watch return while the always-running aggregate is still queued; polling to completed prevents the artifact retry budget from being consumed by runner-capacity delay."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "tools/run-ci-visual-tests.mjs"
                },
                "region": {
                  "startLine": 164,
                  "endLine": 181,
                  "snippet": {
                    "text": "\n  // A failing matrix job can make `gh run watch --exit-status` return while the\n  // workflow's `if: always()` aggregate is still queued. Artifact retries at\n  // that point race runner capacity rather than artifact finalization and used\n  // to expire after six minutes on otherwise healthy all-platform sweeps.\n  process.stdout.write(\"\\nConfirming the aggregate has finished…\\n\");\n  try {\n    await waitForRunCompletion(\n      () => JSON.parse(sh(\"gh\", [\"run\", \"view\", String(runId), \"--json\", \"status,conclusion\"])),\n      {\n        onProgress: (state) => process.stdout.write(`  workflow ${state?.status ?? \"unknown\"}; aggregate/artifacts not final yet\\n`),\n      },\n    );\n  } catch (error) {\n    die(`${error.message} (see ${url})`);\n  }\n}\n"
                  }
                }
              }
            }
          ],
          "properties": {
            "tags": [
              "rationale"
            ],
            "ext-ai-tool-confidence": 0.99
