          "guid": "mt5whzmgjt4u4j7j",
          "message": {
            "text": "The headless ownership mask is decoded from the exact installed Playwright table, not encoded as platform counts. The report also hashes that source and the full-Chrome binary, then separately authenticates each process command and raw profile checkpoint, so a stale answer table or wrong browser channel cannot pass.",
            "markdown": "The headless ownership mask is decoded from the exact installed Playwright table, not encoded as platform counts. The report also hashes that source and the full-Chrome binary, then separately authenticates each process command and raw profile checkpoint, so a stale answer table or wrong browser channel cannot pass."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "tools/generic-profile-target-oracle.ts"
                },
                "region": {
                  "startLine": 302,
                  "endLine": 323,
                  "snippet": {
                    "text": "export function derivePlaywrightOverlayMask(platformKey: PlaywrightOverlayMask[\"platformKey\"], sourceTable: Record<string, unknown>): PlaywrightOverlayMask {\n  const entry = asObject(sourceTable[platformKey], `Playwright platformToFontFamilies.${platformKey}`);\n  const fields: PlaywrightOverlayField[] = [];\n  const add = (script: Script, familiesValue: unknown): void => {\n    const families = asObject(familiesValue, `${platformKey}/${script}.fontFamilies`);\n    for (const [protocolKey, requestedFamily] of Object.entries(families)) {\n      if (!isProtocolKey(protocolKey) || typeof requestedFamily !== \"string\") continue;\n      fields.push({ script, generic: GENERIC_FROM_PROTOCOL[protocolKey], requestedFamily });\n    }\n  };\n  add(\"Zyyy\", entry.fontFamilies);\n  if (Array.isArray(entry.forScripts)) {\n    for (const itemValue of entry.forScripts) {\n      const item = asObject(itemValue, `${platformKey}.forScripts[]`);\n      const script = String(item.script ?? \"\").toLowerCase();\n      if (script === \"jpan\") add(\"Jpan\", item.fontFamilies);\n      if (script === \"deva\") add(\"Deva\", item.fontFamilies);\n    }\n  }\n  const unique = new Map(fields.map((field) => [key(field), field]));\n  if (unique.size !== fields.length) throw new Error(`duplicate Playwright overlay fields for ${platformKey}`);\n  return { platformKey, fields, sourceFieldCount: fields.length };"
                  }
                }
              }
            }
          ],
