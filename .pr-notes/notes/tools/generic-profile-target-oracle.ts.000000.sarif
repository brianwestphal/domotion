          "guid": "mt5whzsmqyrg2iy0",
          "message": {
            "text": "Restoring the quoted -webkit-locale after all:initial is necessary to exercise Japanese and Devanagari Settings keys. Blink maps lang through this inherited presentation property; without the explicit restoration these rows silently query the document script and a nominal 21-field result is logically unauthenticated. DM-2551 owns the broader production-probe correction and DM-2550 owns the hidden macOS Hebrew face that it exposes.",
            "markdown": "Restoring the quoted -webkit-locale after all:initial is necessary to exercise Japanese and Devanagari Settings keys. Blink maps lang through this inherited presentation property; without the explicit restoration these rows silently query the document script and a nominal 21-field result is logically unauthenticated. DM-2551 owns the broader production-probe correction and DM-2550 owns the hidden macOS Hebrew face that it exposes."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "tools/generic-profile-target-oracle.ts"
                },
                "region": {
                  "startLine": 388,
                  "endLine": 399,
                  "snippet": {
                    "text": "      span.style.cssText = \"all:initial;display:block;font-size:32px;line-height:normal\";\n      if (generic !== \"standard\") span.style.fontFamily = generic === \"fixed\" ? \"monospace\" : generic === \"sansserif\" ? \"sans-serif\" : generic;\n      if (script === \"Jpan\") {\n        span.lang = \"ja\";\n        span.style.setProperty(\"-webkit-locale\", '\"ja\"');\n      }\n      if (script === \"Deva\") {\n        span.lang = \"hi\";\n        span.style.setProperty(\"-webkit-locale\", '\"hi\"');\n      }\n      span.textContent = script === \"Jpan\" ? \"日\" : script === \"Deva\" ? \"अ\" : \"A\";\n      root.appendChild(span);"
                  }
                }
              }
            }
