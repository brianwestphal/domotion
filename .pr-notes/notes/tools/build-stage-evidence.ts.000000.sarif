          "message": {
            "text": "Missing, malformed, and failed oracle reports stay negative evidence. The collector stamps the actual process result, while legacy reports use only their own explicit verdict/row fields; no absent report or visual score can become a pass.",
            "markdown": "Missing, malformed, and failed oracle reports stay negative evidence. The collector stamps the actual process result, while legacy reports use only their own explicit verdict/row fields; no absent report or visual score can become a pass."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "tools/build-stage-evidence.ts"
                },
                "region": {
                  "startLine": 25,
                  "endLine": 43,
                  "snippet": {
                    "text": "  const reportFile = `${area.id}.json`;\n  const path = resolve(reportsDir, reportFile);\n  if (!existsSync(path)) return { area: area.id, oracle: area.oracle, status: \"missing\", note: \"No stage report was attached by this run.\" };\n  try {\n    const value = JSON.parse(readFileSync(path, \"utf8\")) as {\n      rows?: Array<{ pass?: boolean }>; records?: unknown[]; failures?: unknown[];\n      pass?: boolean; verdict?: string; mismatches?: number; pairs?: number; evidenceOracle?: string; evidencePassed?: boolean;\n    };\n    const rows = Array.isArray(value.rows) ? value.rows : undefined;\n    const totalRows = rows?.length ?? value.records?.length ?? value.pairs;\n    const passedRows = rows != null ? rows.filter((row) => row.pass === true).length\n      : value.verdict === \"exact-logical-agreement\" && totalRows != null ? totalRows : undefined;\n    const inferredPass = value.pass === true || value.verdict === \"exact-logical-agreement\"\n      || (totalRows != null && totalRows > 0 && passedRows === totalRows && (value.mismatches ?? 0) === 0)\n      || (Array.isArray(value.failures) && value.failures.length === 0);\n    const passed = value.evidencePassed ?? inferredPass;\n    return { area: area.id, oracle: value.evidenceOracle ?? area.oracle, status: passed ? \"passed\" : \"failed\", passedRows, totalRows, reportFile };\n  } catch (error) {\n    return { area: area.id, oracle: area.oracle, status: \"failed\", reportFile, note: `Unreadable report: ${String(error)}` };"
                  }
                }
              }
            }
          ],
