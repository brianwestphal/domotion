        {
          "ruleId": "review-note",
          "ruleIndex": 0,
          "kind": "informational",
          "level": "none",
          "guid": "mt4z2tyhmlkk036m",
          "message": {
            "text": "The classifier deliberately separates Backdrop Roots from ordinary stacking, isolation, transform, overflow, fixed, and sticky containers. That distinction follows the pinned Blink effect-tree predicates, so the investigation cannot bless a viewport crop merely because its final pixels happen to resemble Chromium.",
            "markdown": "The classifier deliberately separates Backdrop Roots from ordinary stacking, isolation, transform, overflow, fixed, and sticky containers. That distinction follows the pinned Blink effect-tree predicates, so the investigation cannot bless a viewport crop merely because its final pixels happen to resemble Chromium."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "tools/backdrop-source-surface-audit.ts"
                },
                "region": {
                  "startLine": 88,
                  "endLine": 110,
                  "snippet": {
                    "text": "export function backdropRootReasons(style: BackdropStyleFacts): BackdropRootReason[] {\n  const reasons: BackdropRootReason[] = [];\n  if (style.isDocumentRoot) reasons.push(\"document-root\");\n  const opacity = Number(style.opacity);\n  if (Number.isFinite(opacity) && opacity < 1) reasons.push(\"opacity\");\n  if (active(style.filter, \"none\")) reasons.push(\"filter\");\n  if (active(style.backdropFilter, \"none\")) reasons.push(\"backdrop-filter\");\n  if (active(style.clipPath, \"none\")) reasons.push(\"clip-path\");\n  if (active(style.maskImage, \"none\") || active(style.maskBorderSource, \"none\")) reasons.push(\"mask\");\n  if (active(style.mixBlendMode, \"normal\")) reasons.push(\"mix-blend-mode\");\n  const willChange = new Set(style.willChange.split(\",\").map((part) => part.trim()).filter(Boolean));\n  if ([\"opacity\", \"filter\", \"backdrop-filter\", \"clip-path\", \"mask\", \"mask-image\", \"mask-border\", \"mix-blend-mode\"]\n    .some((property) => willChange.has(property))) reasons.push(\"will-change\");\n  // Deliberate negatives: an ordinary stacking context, isolation:isolate,\n  // transforms, scrolling/overflow, and fixed/sticky positioning are not\n  // Backdrop Roots. They can still create other property-tree nodes.\n  return reasons;\n}\n\nexport function nearestBackdropRoot(chain: readonly BackdropStyleFacts[]): {\n  id: string;\n  reasons: BackdropRootReason[];\n} | null {"
                  }
                }
              }
            }
