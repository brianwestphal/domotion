          "message": {
            "text": "Workflow YAML is now parsed and pre-runner context references are checked before GitHub sees them. This catches runner.os in job metadata while still allowing runner context inside allocated steps. The focused regression suite passes 9/9 and the repository scan covers all 58 workflows; CI invokes the same checker after npm ci.",
            "markdown": "Workflow YAML is now parsed and pre-runner context references are checked before GitHub sees them. This catches runner.os in job metadata while still allowing runner context inside allocated steps. The focused regression suite passes 9/9 and the repository scan covers all 58 workflows; CI invokes the same checker after npm ci."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "tools/check-github-workflows.mjs"
                },
                "region": {
                  "startLine": 22,
                  "endLine": 37,
                  "snippet": {
                    "text": "// These fields are evaluated while GitHub expands/routes a job, before a runner\n// exists. Keep the sets aligned with the official context-availability table:\n// https://docs.github.com/actions/reference/workflows-and-actions/contexts#context-availability\nconst JOB_FIELD_CONTEXTS = new Map([\n  [\"concurrency\", new Set([\"github\", \"inputs\", \"matrix\", \"needs\", \"strategy\", \"vars\"])],\n  [\"continue-on-error\", new Set([\"github\", \"inputs\", \"matrix\", \"needs\", \"strategy\", \"vars\"])],\n  [\"defaults\", new Set([\"env\", \"github\", \"inputs\", \"matrix\", \"needs\", \"strategy\", \"vars\"])],\n  [\"env\", new Set([\"github\", \"inputs\", \"matrix\", \"needs\", \"secrets\", \"strategy\", \"vars\"])],\n  [\"if\", new Set([\"github\", \"inputs\", \"needs\", \"vars\"])],\n  [\"name\", new Set([\"github\", \"inputs\", \"matrix\", \"needs\", \"strategy\", \"vars\"])],\n  [\"runs-on\", new Set([\"github\", \"inputs\", \"matrix\", \"needs\", \"strategy\", \"vars\"])],\n  [\"secrets\", new Set([\"github\", \"inputs\", \"matrix\", \"needs\", \"secrets\", \"strategy\", \"vars\"])],\n  [\"strategy\", new Set([\"github\", \"inputs\", \"needs\", \"vars\"])],\n  [\"timeout-minutes\", new Set([\"github\", \"inputs\", \"matrix\", \"needs\", \"strategy\", \"vars\"])],\n  [\"with\", new Set([\"github\", \"inputs\", \"matrix\", \"needs\", \"strategy\", \"vars\"])],\n]);"
                  }
                }
              }
            }
          ],
