          "message": {
            "text": "The oracle must remove Playwright’s default scrollbar suppression or every paint row becomes a false negative. The initial controlled run with the default intact observed zero custom marker pixels even though Chromium reserved the authored 16px/14px gutters; removing only --hide-scrollbars exposed 3,608 source marker pixels in the both-axis row while the generated SVG remained at zero.",
            "markdown": "The oracle must remove Playwright’s default scrollbar suppression or every paint row becomes a false negative. The initial controlled run with the default intact observed zero custom marker pixels even though Chromium reserved the authored 16px/14px gutters; removing only --hide-scrollbars exposed 3,608 source marker pixels in the both-axis row while the generated SVG remained at zero."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "tools/native-scrollbar-ownership-audit.ts"
                },
                "region": {
                  "startLine": 611,
                  "endLine": 613,
                  "snippet": {
                    "text": "  // Playwright normally adds `--hide-scrollbars`, which would turn every\n  // screenshot into a false negative for the exact thing this probe audits.\n  const browser = await chromium.launch({ headless: true, ignoreDefaultArgs: [\"--hide-scrollbars\"] });"
                  }
                }
              }
            }
          ],
