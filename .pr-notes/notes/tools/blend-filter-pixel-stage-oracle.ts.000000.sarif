          "guid": "mt4kdq17cipe1mn0",
          "message": {
            "text": "The constants are source-stage contracts, not calibration knobs. Chromium and its DEPS-owned Skia pin define the arithmetic; four 8-bit codes cover named-pixel quantization, while an eight-code mutation floor keeps every destructive control independently observable.",
            "markdown": "The constants are source-stage contracts, not calibration knobs. Chromium and its DEPS-owned Skia pin define the arithmetic; four 8-bit codes cover named-pixel quantization, while an eight-code mutation floor keeps every destructive control independently observable."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "tools/blend-filter-pixel-stage-oracle.ts"
                },
                "region": {
                  "startLine": 21,
                  "endLine": 29,
                  "snippet": {
                    "text": "export const BLEND_FILTER_SOURCE_PINS = {\n  chromium: \"7d859f271cbda744098ac69f44978d4edfa62be3\",\n  skiaPinnedByChromium: \"62efacd37737505732dbe3d8daa62abd679626a1\",\n} as const;\n\nexport const BLUR_IDENTITY_SIGMA = 0.03;\nexport const BLUR_KERNEL_RADIUS_MULTIPLIER = 3;\nexport const STAGE_CHANNEL_TOLERANCE = 4;\nexport const MUTATION_MIN_CHANNEL_DISTANCE = 8;"
                  }
                }
              }
            }
          ],
