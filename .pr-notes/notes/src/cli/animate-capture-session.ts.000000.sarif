          "message": {
            "text": "The HAR belongs to the one persistent animation BrowserContext, not to individual frames. Continued frames share browser state and network history, and explicit context.close is the Playwright flush boundary; the browser-level finally remains a separate outer lifecycle.",
            "markdown": "The HAR belongs to the one persistent animation BrowserContext, not to individual frames. Continued frames share browser state and network history, and explicit context.close is the Playwright flush boundary; the browser-level finally remains a separate outer lifecycle."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/cli/animate-capture-session.ts"
                },
                "region": {
                  "startLine": 34,
                  "endLine": 60,
                  "snippet": {
                    "text": "  const context = await browser.newContext({\n    viewport: { width: options.width, height: options.height },\n    isMobile: options.mobile,\n    ...(options.mobile ? { userAgent: \"Mozilla/5.0 (iPhone; CPU iPhone OS 17_0 like Mac OS X)\" } : {}),\n    ...(options.colorScheme != null ? { colorScheme: options.colorScheme } : {}),\n    ...(options.recordHarPath != null\n      ? { recordHar: { path: options.recordHarPath, mode: \"minimal\" as const } }\n      : {}),\n  });\n  if (options.brand != null) await injectBrandVariables(context, options.brand);\n  const page = await context.newPage();\n  page.setDefaultTimeout(90_000);\n  page.setDefaultNavigationTimeout(90_000);\n\n  clearWebfonts();\n  clearEmbeddedFonts();\n  clearGlyphDefs();\n  const tracker = attachWebfontTracker(page);\n  let closed = false;\n  return {\n    page,\n    tracker,\n    async close(): Promise<void> {\n      if (closed) return;\n      closed = true;\n      tracker.detach();\n      await context.close();"
                  }
                }
              }
            }
          ],
