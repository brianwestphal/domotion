          "message": {
            "text": "Automatic interaction recording snapshots the effective cursor keyword alongside the target coordinates before actions execute. Carrying that value forward is necessary because the captured frame tree represents post-action DOM and may no longer contain the clicked element.",
            "markdown": "Automatic interaction recording snapshots the effective cursor keyword alongside the target coordinates before actions execute. Carrying that value forward is necessary because the captured frame tree represents post-action DOM and may no longer contain the clicked element."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/cli/animate.ts"
                },
                "region": {
                  "startLine": 1589,
                  "endLine": 1601,
                  "snippet": {
                    "text": "  // DM-851 §6: for `cursor: \"auto\"`, record each interaction target's\n  // aim point BEFORE the action runs (that's where the pointer clicks).\n  // DM-1742: the action's optional `cursorAt` / `cursorOffset` aim the\n  // pointer at a named border-box anchor + px nudge instead of the center.\n  if (cursorAuto && fc.actions != null) {\n    for (const a of fc.actions) {\n      if (a.type === \"click\" || a.type === \"hover\" || a.type === \"fill\") {\n        const c = await queryCursorBox(page, a.selector, a.cursorAt, a.cursorOffset);\n        if (c != null) autoCursorTargets.push({ frame: i, cx: c.cx, cy: c.cy, cursor: c.cursor });\n      }\n    }\n  }\n  if (fc.actions != null) await runActions(page, fc.actions, log);"
                  }
                }
              }
            }
          ],
