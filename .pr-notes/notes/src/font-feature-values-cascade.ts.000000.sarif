          "guid": "mt5qjen7pgixmg0m",
          "message": {
            "text": "The merge stores priority per alias, not per family or whole rule. Blink FontFeatureValuesStorage::FuseUpdate independently unions all six alias maps and replaces only a colliding key at greater-or-equal layer order; that preserves lower-layer sibling aliases while equality implements later source order within one layer. The document collector supplies the canonical postorders.",
            "markdown": "The merge stores priority per alias, not per family or whole rule. Blink FontFeatureValuesStorage::FuseUpdate independently unions all six alias maps and replaces only a colliding key at greater-or-equal layer order; that preserves lower-layer sibling aliases while equality implements later source order within one layer. The document collector supplies the canonical postorders."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/font-feature-values-cascade.ts"
                },
                "region": {
                  "startLine": 55,
                  "endLine": 72,
                  "snippet": {
                    "text": "  for (const record of records) {\n    const families = parseCssFontFamilyEntries(record.fontFamily)\n      .map((entry) => entry.name.toLowerCase());\n    for (const family of families) {\n      const familyTable = prioritized[family] ?? (prioritized[family] = {});\n      for (const category of Object.keys(record.table) as FontFeatureValueCategory[]) {\n        const aliases = record.table[category];\n        if (aliases == null) continue;\n        const categoryTable = familyTable[category] ?? (familyTable[category] = {});\n        for (const [alias, values] of Object.entries(aliases)) {\n          const existing = categoryTable[alias];\n          if (existing == null || record.layerOrder >= existing.layerOrder) {\n            categoryTable[alias] = {\n              layerOrder: record.layerOrder,\n              values: [...values],\n            };\n          }\n        }"
                  }
                }
              }
            }
          ],
