          "guid": "mtviz9um0acrmm52",
          "message": {
            "text": "The first real public paged capture failed because tsx/esbuild's serialized fingerprint callback referenced its out-of-scope __name helper. The isolated CDP expression now supplies only that identity helper locally; a direct regression test evaluates a decorated callback, and the packaged-helper 15-page public capture subsequently passed.",
            "markdown": "The first real public paged capture failed because tsx/esbuild's serialized fingerprint callback referenced its out-of-scope __name helper. The isolated CDP expression now supplies only that identity helper locally; a direct regression test evaluates a decorated callback, and the packaged-helper 15-page public capture subsequently passed."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/capture/paged-page-record.ts"
                },
                "region": {
                  "startLine": 543,
                  "endLine": 545,
                  "snippet": {
                    "text": "/** @internal Preserve the esbuild name helper when a callback crosses into CDP. */\nexport function wrapIsolatedPageStateFingerprintSource(source: string): string {\n  return `(() => { const __name = (target) => target; return (${source})(); })()`;"
                  }
                }
              }
            }
          ],
