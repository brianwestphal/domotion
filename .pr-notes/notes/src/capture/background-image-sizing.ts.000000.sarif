          "guid": "mth5ewmnlm57ydbz",
          "message": {
            "text": "Local SVG sizing crosses the Node/page boundary because file: documents cannot reliably fetch their own SVG source through page JavaScript. Byte-sniffing avoids extension guesses, and carrying the verified source text lets the existing DOMParser path reconstruct Blink NaturalSizingInfo without treating SVG as a fixed bitmap.",
            "markdown": "Local SVG sizing crosses the Node/page boundary because file: documents cannot reliably fetch their own SVG source through page JavaScript. Byte-sniffing avoids extension guesses, and carrying the verified source text lets the existing DOMParser path reconstruct Blink NaturalSizingInfo without treating SVG as a fixed bitmap."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/capture/background-image-sizing.ts"
                },
                "region": {
                  "startLine": 93,
                  "endLine": 102,
                  "snippet": {
                    "text": "async function locallyObservedImage(\n  url: string | null,\n): Promise<{ kind: \"bitmap\" | \"svg\"; svgText?: string } | null> {\n  if (url == null || !url.startsWith(\"file:\")) return null;\n  try {\n    const bytes = await readFile(fileURLToPath(url));\n    const kind = sniffLocalImageKind(bytes);\n    if (kind === \"svg\") return { kind, svgText: bytes.toString(\"utf8\") };\n    return kind === \"bitmap\" ? { kind } : null;\n  } catch { return null; }"
                  }
                }
              }
            }
          ],
