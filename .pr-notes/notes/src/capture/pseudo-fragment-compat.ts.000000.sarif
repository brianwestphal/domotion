          "guid": "mt4a26qot0czbnzd",
          "message": {
            "text": "The legacy fields are a one-way compatibility projection from the source-owned record, not a second layout authority. Skipping them outright would regress the renderer before DM-2468, while retaining pseudo-content.ts would preserve the forbidden clone and host-anchor decisions. This bridge keeps old serialized trees readable and derives new live text/image/box fields only from exact protocol geometry or the terminal raster.",
            "markdown": "The legacy fields are a one-way compatibility projection from the source-owned record, not a second layout authority. Skipping them outright would regress the renderer before DM-2468, while retaining pseudo-content.ts would preserve the forbidden clone and host-anchor decisions. This bridge keeps old serialized trees readable and derives new live text/image/box fields only from exact protocol geometry or the terminal raster."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/capture/pseudo-fragment-compat.ts"
                },
                "region": {
                  "startLine": 139,
                  "endLine": 149,
                  "snippet": {
                    "text": "export function projectPseudoFragmentCompatibility(tree: CapturedElement[]): void {\n  const visit = (elements: CapturedElement[]): void => {\n    for (const element of elements) {\n      const records = element.pseudoFragments ?? [];\n      for (const record of records.filter((row) => row.pseudo === \"::before\")) projectRecord(element, record);\n      for (const record of records.filter((row) => row.pseudo === \"::after\")) projectRecord(element, record);\n      visit(element.children ?? []);\n    }\n  };\n  visit(tree);\n}"
                  }
                }
              }
            }
          ],
          "properties": {
