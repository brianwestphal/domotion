          "guid": "mt6r6yethvt7206v",
          "message": {
            "text": "The shadow behavior is intentionally asymmetric because pinned Blink registers document palette rules globally but skips rules declared inside shadow trees. Reading document adopted sheets while excluding shadow sheets preserves that upstream limitation exactly.",
            "markdown": "The shadow behavior is intentionally asymmetric because pinned Blink registers document palette rules globally but skips rules declared inside shadow trees. Reading document adopted sheets while excluding shadow sheets preserves that upstream limitation exactly."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/capture/script/font-palette.ts"
                },
                "region": {
                  "startLine": 14,
                  "endLine": 18,
                  "snippet": {
                    "text": " * Blink deliberately does not register @font-palette-values from shadow\n * trees yet (style_engine.cc:3159-3167). Accordingly this resolver reads the\n * document sheets (including document.adoptedStyleSheets), never a shadow\n * root's sheets. The selected document rule is the last matching rule, exactly\n * like StyleEngine's map Set() in style_engine.cc:3577-3586."
                  }
                }
              }
            }
          ],
