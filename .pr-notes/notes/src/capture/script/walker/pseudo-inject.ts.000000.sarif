                  "uri": "src/capture/script/walker/pseudo-inject.ts"
                },
                "region": {
                  "startLine": 308,
                  "endLine": 316,
                  "snippet": {
                    "text": "      if (p.boxStyles != null) {\n        const bs = p.boxStyles;\n        const lineCenter = p.seg.y + bs.fontSize / 2;\n        const boxTop = lineCenter - bs.lineH / 2 - bs.padT - bs.borT;\n        const bx = p.seg.x - bs.padL - bs.borL;\n        // DM-2191: prefer Blink's measured generated-content border box. The\n        // arithmetic fallback exists only for older captured trees.\n        const bw = bs.measuredWidth || (p.seg.width + bs.padL + bs.padR + bs.borL + bs.borR);\n        const bh = bs.measuredHeight || (bs.lineH + bs.padT + bs.padB + bs.borT + bs.borB);"
                  }
                }
              }
            }
