          "guid": "mt5fankl9jibksqk",
          "message": {
            "text": "The raster cache identity now includes every paint-selecting dimension: resolved CPAL base/valid overrides plus the selected physical face path/member, glyph IDs, and representation. The pinned COLR/CPAL browser audit passes in both forward and reverse DOM order with two distinct captured PNGs, each byte-equal to its corresponding Chromium screenshot; no raster tolerance participates.",
            "markdown": "The raster cache identity now includes every paint-selecting dimension: resolved CPAL base/valid overrides plus the selected physical face path/member, glyph IDs, and representation. The pinned COLR/CPAL browser audit passes in both forward and reverse DOM order with two distinct captured PNGs, each byte-equal to its corresponding Chromium screenshot; no raster tolerance participates."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/capture/emoji.ts"
                },
                "region": {
                  "startLine": 198,
                  "endLine": 212,
                  "snippet": {
                    "text": "type ColorSpanIdentity = { fontKey: string; glyphIds: number[]; representation: string; paletteEntryCount?: number; paletteCount?: number; paletteTypes?: number[] };\nexport function resolvedPaletteIdentity(styles: Pick<CapturedElement[\"styles\"], \"fontPalette\" | \"fontPaletteIdentity\">, span: ColorSpanIdentity) {\n  const source = styles.fontPaletteIdentity ?? { token: styles.fontPalette ?? \"normal\", ruleFamily: null, basePalette: styles.fontPalette ?? \"normal\", overrides: [] };\n  const requested = source.basePalette;\n  const themed = requested === \"light\" ? span.paletteTypes?.findIndex((type) => type === 1) : requested === \"dark\" ? span.paletteTypes?.findIndex((type) => type === 2) : -1;\n  const numeric = /^\\d+$/.test(requested) ? Number(requested) : 0;\n  const resolvedBasePalette = themed != null && themed >= 0 ? themed : numeric < (span.paletteCount ?? Infinity) ? numeric : 0;\n  return { ...source, resolvedBasePalette, overrides: source.overrides.filter((item) => span.paletteEntryCount == null || item.index < span.paletteEntryCount) };\n}\nexport function colorGlyphRasterIdentity(\n  styles: Pick<CapturedElement[\"styles\"], \"fontPalette\" | \"fontPaletteIdentity\">,\n  spans: ColorSpanIdentity[],\n): string {\n  if (spans.length === 0) return JSON.stringify(styles.fontPaletteIdentity ?? { token: styles.fontPalette ?? \"normal\" });\n  return spans.map((span) => `${JSON.stringify(resolvedPaletteIdentity(styles, span))}|${span.fontKey}:${span.glyphIds.join(\",\")}:${span.representation}`).join(\";\");"
                  }
                }
              }
            }
          ],
