        {
          "ruleId": "review-note",
          "ruleIndex": 0,
          "kind": "informational",
          "level": "none",
          "guid": "mt3fkqj44aqprwr9",
          "message": {
            "text": "Ancestor overflow/clip/mask paint nodes are temporarily suppressed because Blink maps the replaced local surface through its transform tree before clip-tree intersection. The code first records the neutral-transform output quad, then samples without the ancestor clip; any scroll/layout movement must remain a same-size translation, and authored declarations, priorities, and scroll offsets are restored. The captured SVG already owns the clip, so transform then clip occurs exactly once. The related DPR-2 discriminator loses roughly 50 device pixels from the blue edge if pre-transform clipping returns.",
            "markdown": "Ancestor overflow/clip/mask paint nodes are temporarily suppressed because Blink maps the replaced local surface through its transform tree before clip-tree intersection. The code first records the neutral-transform output quad, then samples without the ancestor clip; any scroll/layout movement must remain a same-size translation, and authored declarations, priorities, and scroll offsets are restored. The captured SVG already owns the clip, so transform then clip occurs exactly once. The related DPR-2 discriminator loses roughly 50 device pixels from the blue edge if pre-transform clipping returns."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/capture/index.ts"
                },
                "region": {
                  "startLine": 1743,
                  "endLine": 1803,
                  "snippet": {
                    "text": "          // The bitmap is the replaced element's local source surface. Blink\n          // maps that surface through descendant/ancestor transforms before\n          // intersecting ancestor clip nodes; retaining an ancestor overflow\n          // clip while those transforms are neutralized clips the wrong local\n          // edge. The SVG tree already owns these clips, so remove only hard,\n          // non-scrollbar clip/mask properties while sampling and restore them\n          // before the next target. An `auto`/`scroll`-only ancestor is retained\n          // because removing its scrollbar changes layout rather than only\n          // paint; when CSS couples one such axis to a hard-clipped axis, both\n          // computed axes must be suppressed together.\n          for (let ancestor = next.parentElement;\n            ancestor != null && ancestor !== document.documentElement;\n            ancestor = ancestor.parentElement) {\n            const style = getComputedStyle(ancestor);\n            const properties: SavedProperty[] = [];\n            if ([style.overflowX, style.overflowY].some((value) => value === \"hidden\" || value === \"clip\")) {\n              for (const name of [\"overflow\", \"overflow-x\", \"overflow-y\"]) {\n                properties.push({\n                  name,\n                  value: ancestor.style.getPropertyValue(name),\n                  priority: ancestor.style.getPropertyPriority(name),\n                });\n              }\n              ancestor.style.setProperty(\"overflow\", \"visible\", \"important\");\n              ancestor.style.setProperty(\"overflow-x\", \"visible\", \"important\");\n              ancestor.style.setProperty(\"overflow-y\", \"visible\", \"important\");\n            }\n            if (style.clip !== \"auto\") {\n              properties.push({\n                name: \"clip\",\n                value: ancestor.style.getPropertyValue(\"clip\"),\n                priority: ancestor.style.getPropertyPriority(\"clip\"),\n              });\n              ancestor.style.setProperty(\"clip\", \"auto\", \"important\");\n            }\n            if (style.clipPath !== \"none\") {\n              properties.push({\n                name: \"clip-path\",\n                value: ancestor.style.getPropertyValue(\"clip-path\"),\n                priority: ancestor.style.getPropertyPriority(\"clip-path\"),\n              });\n              ancestor.style.setProperty(\"clip-path\", \"none\", \"important\");\n            }\n            if (style.maskImage !== \"none\") {\n              properties.push({\n                name: \"mask-image\",\n                value: ancestor.style.getPropertyValue(\"mask-image\"),\n                priority: ancestor.style.getPropertyPriority(\"mask-image\"),\n              });\n              ancestor.style.setProperty(\"mask-image\", \"none\", \"important\");\n            }\n            if (style.webkitMaskImage != null && style.webkitMaskImage !== \"none\") {\n              properties.push({\n                name: \"-webkit-mask-image\",\n                value: ancestor.style.getPropertyValue(\"-webkit-mask-image\"),\n                priority: ancestor.style.getPropertyPriority(\"-webkit-mask-image\"),\n              });\n              ancestor.style.setProperty(\"-webkit-mask-image\", \"none\", \"important\");\n            }\n            if (properties.length > 0) saved.push({ element: ancestor, properties });\n          }"
                  }
                }
              }
            }
          ],
