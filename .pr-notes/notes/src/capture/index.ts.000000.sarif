                  "endLine": 1583,
                  "snippet": {
                    "text": "  let animationFrameState: StableAnimationFrameState | undefined;\n  if (opts?.animationTimeMs != null) {\n    animationFrameState = await seekAnimationsToFrame(page, opts.animationTimeMs, {\n      strict: true,\n      includeChildFrames: true,\n    });"
                  }
                }
              }
