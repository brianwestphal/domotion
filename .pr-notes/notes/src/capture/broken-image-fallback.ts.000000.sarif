          "guid": "mt492o2wpn5nsoga",
          "message": {
            "text": "Required-fact failure is deliberately fail-closed and observable. The terminal-raster record preserves the already-classified source/load state and exact host bounds while the warning prevents DM-372's known-inexact mountain/text heuristic from silently becoming authority again; DM-2464 can materialize this explicit terminal request.",
            "markdown": "Required-fact failure is deliberately fail-closed and observable. The terminal-raster record preserves the already-classified source/load state and exact host bounds while the warning prevents DM-372's known-inexact mountain/text heuristic from silently becoming authority again; DM-2464 can materialize this explicit terminal request."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/capture/broken-image-fallback.ts"
                },
                "region": {
                  "startLine": 412,
                  "endLine": 430,
                  "snippet": {
                    "text": "function warningFor(target: CapturedElement, probe: ProbeRecord, warnings: CaptureWarning[], reason: string): void {\n  const selector = probe.selector ?? \"img\";\n  if (!warnings.some((warning) => warning.feature === FEATURE && warning.selector === selector)) {\n    warnings.push({ selector, feature: FEATURE, detail: `${reason}; terminal Chromium raster required` });\n  }\n  const hostRect = probe.hostRect ?? { x: target.x, y: target.y, width: target.width, height: target.height };\n  target.brokenImageFallback = {\n    schemaVersion: 1,\n    authority: \"chromium-ua-shadow-v1\",\n    disposition: classifyBrokenImageDisposition({ source: probe.source, uaShadowPresent: false }),\n    captureStatus: \"terminal-raster\",\n    paintOwnership: \"terminal-raster\",\n    loadState: loadState(probe.source),\n    source: probe.source,\n    hostBox: boxFromRect(hostRect),\n    accessibility: { unavailableReason: reason },\n    terminalRaster: { rect: hostRect, reason },\n  };\n}"
                  }
                }
              }
            }
          ],
