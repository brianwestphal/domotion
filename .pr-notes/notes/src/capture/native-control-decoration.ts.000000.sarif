          "guid": "mt44ibdzdnpqmqyt",
          "message": {
            "text": "File inputs must route from the closed-shadow child, not the host. Pinned FileInputType creates a real input button under a host whose appearance is none; LayoutTheme resolves that child independently, so only a positively CSS-owned child re-enters structural synthesis and missing facts stay conservatively source-owned.",
            "markdown": "File inputs must route from the closed-shadow child, not the host. Pinned FileInputType creates a real input button under a host whose appearance is none; LayoutTheme resolves that child independently, so only a positively CSS-owned child re-enters structural synthesis and missing facts stay conservatively source-owned."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/capture/native-control-decoration.ts"
                },
                "region": {
                  "startLine": 47,
                  "endLine": 55,
                  "snippet": {
                    "text": "  // FileInputType's host is deliberately `appearance:none`; Blink creates a\n  // real closed-shadow <input type=button> whose own EffectiveAppearance is\n  // the source of paint ownership. Unknown/missing child facts reserve the\n  // source route and fail closed later. A positively CSS-owned child is the\n  // only state which leaves the existing structural pseudo renderer active.\n  if (tag === \"input\" && type === \"file\") {\n    if (fileSelectorButtonAppearance === \"none\"\n        || fileSelectorButtonAppearance === \"base\"\n        || fileSelectorButtonAppearance === \"base-select\") return [];"
                  }
                }
              }
            }
          ],
