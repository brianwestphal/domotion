          "message": {
            "text": "Use the URL parser's platform mode because file URLs are not string-prefix paths. On Windows, manually stripping file:// leaves /C:/..., so resolveSvgSource cannot read the SVG and object-fit silently falls back to the intrinsic-ratio image path; drive and UNC tests exercise the same conversion from macOS.",
            "markdown": "Use the URL parser's platform mode because file URLs are not string-prefix paths. On Windows, manually stripping file:// leaves /C:/..., so resolveSvgSource cannot read the SVG and object-fit silently falls back to the intrinsic-ratio image path; drive and UNC tests exercise the same conversion from macOS."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/capture/embed.ts"
                },
                "region": {
                  "startLine": 73,
                  "endLine": 100,
                  "snippet": {
                    "text": "  if (path.startsWith(\"file://\")) {\n    try {\n      path = fileUrlToLocalPath(path);\n    } catch {\n      _dataUriCache.set(url, url);\n      return url;\n    }\n  }\n  if (!existsSync(path)) {\n    _dataUriCache.set(url, url);\n    return url;\n  }\n  try {\n    const buf = readFileSync(path);\n    const mime = mimeFromExtension(path) ?? \"application/octet-stream\";\n    const dataUri = `data:${mime};base64,${buf.toString(\"base64\")}`;\n    _dataUriCache.set(url, dataUri);\n    return dataUri;\n  } catch {\n    _dataUriCache.set(url, url);\n    return url;\n  }\n}\n\n/** Convert a captured file URL using the platform that will read it. */\nexport function fileUrlToLocalPath(url: string, platform: NodeJS.Platform = process.platform): string {\n  return fileURLToPath(url, { windows: platform === \"win32\" });\n}"
                  }
                }
              }
            }
          ],
