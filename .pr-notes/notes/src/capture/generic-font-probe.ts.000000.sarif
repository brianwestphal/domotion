          "guid": "msmzk2a7vbmupvse",
          "message": {
            "text": "The live probe requires two consecutive identical paints because Playwright’s asynchronous Page.setFontFamilies update can lose the first-layout race to Blink’s constructor defaults. A third bounded reading allows a transient first answer to settle; continued disagreement returns null so the calibrated static routes remain authoritative instead of caching a coin flip.",
            "markdown": "The live probe requires two consecutive identical paints because Playwright’s asynchronous `Page.setFontFamilies` update can lose the first-layout race to Blink’s constructor defaults. A third bounded reading allows a transient first answer to settle; continued disagreement returns null so the calibrated static routes remain authoritative instead of caching a coin flip."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/capture/generic-font-probe.ts"
                },
                "region": {
                  "startLine": 149,
                  "endLine": 156,
                  "snippet": {
                    "text": "    // Playwright's Page.setFontFamilies update can race the first layout on a\n    // loaded runner. Require two consecutive identical paints; a third pass\n    // lets the settled Playwright values win over a constructor-default first.\n    const first = await read();\n    const second = await read();\n    if (probeResultsEqual(first, second)) return second;\n    const third = await read();\n    return probeResultsEqual(second, third) ? third : null;"
                  }
                }
              }
            }
          ],
