        {
          "ruleId": "review-note",
          "ruleIndex": 0,
          "kind": "informational",
          "level": "warning",
          "guid": "mtp5vyqu5zklvo6w",
          "message": {
            "text": "The v1 static compiler fails closed when semantic events or scene hook bindings are active. Silently ignoring either would create a visually plausible but behaviorally false demo. Later interactive compilation should lower these intents first, leaving this boundary explicit and safe.",
            "markdown": "The v1 static compiler fails closed when semantic events or scene hook bindings are active. Silently ignoring either would create a visually plausible but behaviorally false demo. Later interactive compilation should lower these intents first, leaving this boundary explicit and safe."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/studio/compile.ts"
                },
                "region": {
                  "startLine": 81,
                  "endLine": 96,
                  "snippet": {
                    "text": "function assertStaticCompilerInputs(project: StudioProject): void {\n  project.scenes.forEach((scene, sceneIndex) => {\n    const trackIndex = scene.tracks?.findIndex((track) => track.events.length > 0) ?? -1;\n    if (trackIndex >= 0) {\n      throw new StudioProjectCompileError(\n        `$.scenes[${sceneIndex}].tracks[${trackIndex}]`,\n        \"the static compiler does not execute semantic interaction events; compile an already-generated scene recipe or use the interactive Studio compiler\",\n      );\n    }\n    if ((scene.scriptHooks?.length ?? 0) > 0) {\n      throw new StudioProjectCompileError(\n        `$.scenes[${sceneIndex}].scriptHooks`,\n        \"the static compiler never executes script hooks; lower the hook to a generated scene before compiling\",\n      );\n    }\n  });"
                  }
                }
              }
            }
          ],
