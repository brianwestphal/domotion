        {
          "ruleId": "review-note",
          "ruleIndex": 0,
          "kind": "informational",
          "level": "warning",
          "guid": "mtpgyc097c52t0bb",
          "message": {
            "text": "Logo reveal deliberately rejects remote URLs. Local, inline-SVG, and data-URL assets are embedded into the output; accepting HTTP here would make an apparently valid Studio export depend on network availability and violate the self-contained SVG contract.",
            "markdown": "Logo reveal deliberately rejects remote URLs. Local, inline-SVG, and data-URL assets are embedded into the output; accepting HTTP here would make an apparently valid Studio export depend on network availability and violate the self-contained SVG contract."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/studio/treatments.ts"
                },
                "region": {
                  "startLine": 110,
                  "endLine": 130,
                  "snippet": {
                    "text": "function embedLogo(source: string, assetDir: string): string {\n  if (source.startsWith(\"data:\")) return source;\n  if (/^https?:\\/\\//i.test(source)) {\n    throw new StudioTreatmentError(\"logo-reveal requires an inline data URL or local asset so the output stays self-contained\");\n  }\n  if (source.trimStart().startsWith(\"<svg\")) {\n    return `data:image/svg+xml;base64,${Buffer.from(source).toString(\"base64\")}`;\n  }\n  const path = resolve(assetDir, source);\n  let bytes: Buffer;\n  try {\n    bytes = readFileSync(path);\n  } catch (error) {\n    throw new StudioTreatmentError(`logo-reveal could not read ${path}`, { cause: error });\n  }\n  const mime = extname(path).toLowerCase() === \".svg\" ? \"image/svg+xml\"\n    : extname(path).toLowerCase() === \".png\" ? \"image/png\"\n      : extname(path).toLowerCase() === \".webp\" ? \"image/webp\"\n        : extname(path).toLowerCase() === \".jpg\" || extname(path).toLowerCase() === \".jpeg\" ? \"image/jpeg\"\n          : \"application/octet-stream\";\n  return `data:${mime};base64,${bytes.toString(\"base64\")}`;"
                  }
                }
              }
            }
          ],
