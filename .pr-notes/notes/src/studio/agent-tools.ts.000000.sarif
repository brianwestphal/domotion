          "message": {
            "text": "Mutations use a project SHA-256 compare-and-swap token, stable-identity removals require both request intent and a separate host capability, and every artifact path is reconciled against the host workspace. Generation adapters receive mandatory AI healing/review policy, while ambiguity is returned as a typed clarification rather than guessed.",
            "markdown": "Mutations use a project SHA-256 compare-and-swap token, stable-identity removals require both request intent and a separate host capability, and every artifact path is reconciled against the host workspace. Generation adapters receive mandatory AI healing/review policy, while ambiguity is returned as a typed clarification rather than guessed."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
