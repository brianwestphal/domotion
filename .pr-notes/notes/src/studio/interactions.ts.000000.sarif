          "guid": "mtqgd7k7ond7azxf",
          "message": {
            "text": "Attachment lifecycle waits deliberately use a private cardinality exception and bypass temporary DOM marking. A missing node cannot be marked before attached, and a removed marker cannot identify detached; the authored Playwright locator owns the wait while the public resolver and locator strictness continue to reject ambiguity.",
            "markdown": "Attachment lifecycle waits deliberately use a private cardinality exception and bypass temporary DOM marking. A missing node cannot be marked before attached, and a removed marker cannot identify detached; the authored Playwright locator owns the wait while the public resolver and locator strictness continue to reject ambiguity."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
