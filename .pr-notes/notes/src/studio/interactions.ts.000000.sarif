          "kind": "informational",
          "level": "none",
          "guid": "mtp8mdxea802i54c",
          "message": {
            "text": "Keep scene timing anchored to one execution start so action latency does not accumulate into later authored timestamps. Script-hook events cross an explicit caller-owned runHook boundary and fail when no handler is supplied; the project model never imports or evaluates arbitrary source.",
            "markdown": "Keep scene timing anchored to one execution start so action latency does not accumulate into later authored timestamps. Script-hook events cross an explicit caller-owned runHook boundary and fail when no handler is supplied; the project model never imports or evaluates arbitrary source."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/studio/interactions.ts"
                },
                "region": {
                  "startLine": 230,
                  "endLine": 250,
                  "snippet": {
                    "text": "/** Execute a compiled scene-relative plan against one live page, in timeline order. */\nexport async function runStudioSemanticPlan(\n  page: Page,\n  plan: StudioSemanticPlan,\n  options: RunStudioSemanticPlanOptions = {},\n): Promise<void> {\n  const log = options.log ?? (() => {});\n  const now = options.now ?? Date.now;\n  const startedAt = now();\n  for (const step of plan.steps) {\n    const remaining = step.event.atMs - (now() - startedAt);\n    if (remaining > 0) await runActions(page, [{ type: \"wait\", ms: remaining }], log);\n    log(`Studio interaction ${step.event.id}: ${step.event.kind} at ${step.event.atMs}ms`);\n    try {\n      if (step.event.kind === \"scriptHook\") {\n        if (options.runHook == null) {\n          throw new StudioInteractionError(step.path, `script hook \"${step.event.hookId}\" requires an explicit runHook handler`, step.event.id);\n        }\n        await options.runHook({ page, hookId: step.event.hookId, input: step.event.input, event: step.event, path: step.path });\n      } else if (step.event.kind === \"scrollTo\" && step.event.position != null) {\n        await runActions(page, [{ type: \"scroll\", x: step.event.position.x, y: step.event.position.y }], log);"
                  }
                }
              }
            }
          ],
