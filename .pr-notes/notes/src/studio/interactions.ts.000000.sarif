                },
                "region": {
                  "startLine": 212,
                  "endLine": 221,
                  "snippet": {
                    "text": "  if (event.kind === \"waitForState\" && (event.state === \"attached\" || event.state === \"detached\")) {\n    const targetPath = `${step.path}.target`;\n    const locator = await resolveStudioSemanticTargetWithCardinality(page, eventTarget, targetPath, event.id, { allowMissing: true });\n    try {\n      await locator.waitFor({ state: event.state, timeout: event.timeoutMs ?? 5_000 });\n    } catch (error) {\n      throw new StudioInteractionError(targetPath, error instanceof Error ? error.message : String(error), event.id, { cause: error });\n    }\n    return;\n  }"
                  }
                }
              }
            }
