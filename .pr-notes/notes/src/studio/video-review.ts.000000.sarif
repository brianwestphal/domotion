          "guid": "mtpfvdixgv1uu22o",
          "message": {
            "text": "The general visual-quality rubric remains authoritative even during revision comparison. Requiring at least one finding for every dimension prevents a favorable delta from hiding a current pacing, readability, narrative, brand, cursor, transition, or polish defect; duplicate finding IDs are rejected before queue insertion.",
            "markdown": "The general visual-quality rubric remains authoritative even during revision comparison. Requiring at least one finding for every dimension prevents a favorable delta from hiding a current pacing, readability, narrative, brand, cursor, transition, or polish defect; duplicate finding IDs are rejected before queue insertion."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/studio/video-review.ts"
                },
                "region": {
                  "startLine": 46,
                  "endLine": 68,
                  "snippet": {
                    "text": "export const studioVideoReviewReportSchema = z\n  .strictObject({\n    kind: z.literal(\"report\"),\n    summary: nonEmpty,\n    findings: z.array(studioVideoReviewFindingSchema).min(STUDIO_VIDEO_REVIEW_DIMENSIONS.length),\n    comparison: z.strictObject({\n      summary: nonEmpty,\n      improvements: z.array(nonEmpty),\n      regressions: z.array(nonEmpty),\n    }).optional(),\n  })\n  .superRefine((report, ctx) => {\n    const ids = new Set<string>();\n    report.findings.forEach((finding, index) => {\n      if (ids.has(finding.id)) ctx.addIssue({ code: \"custom\", path: [\"findings\", index, \"id\"], message: `duplicate finding id \"${finding.id}\"` });\n      ids.add(finding.id);\n    });\n    for (const dimension of STUDIO_VIDEO_REVIEW_DIMENSIONS) {\n      if (!report.findings.some((finding) => finding.dimension === dimension)) {\n        ctx.addIssue({ code: \"custom\", path: [\"findings\"], message: `missing authoritative rubric dimension \"${dimension}\"` });\n      }\n    }\n  });"
                  }
                }
              }
            }
          ],
          "properties": {
            "tags": [
