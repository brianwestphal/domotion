          "message": {
            "text": "Generation always delegates through the configured AI healing and review adapter, may return a clarification without mutating disk, preserves authored intent and provenance, and proves the requested current SVG can be previewed before saving.",
            "markdown": "Generation always delegates through the configured AI healing and review adapter, may return a clarification without mutating disk, preserves authored intent and provenance, and proves the requested current SVG can be previewed before saving."
          },
          "locations": [
            {
              "physicalLocation": {
