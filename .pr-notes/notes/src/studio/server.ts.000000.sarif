            "text": "Preview bytes are selected only from project provenance, constrained lexically and by real path, size-checked before read, and SHA-256 verified so a persisted path, symlink, or stale artifact cannot escape or silently misrepresent the project.",
            "markdown": "Preview bytes are selected only from project provenance, constrained lexically and by real path, size-checked before read, and SHA-256 verified so a persisted path, symlink, or stale artifact cannot escape or silently misrepresent the project."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
