          "message": {
            "text": "The generator now prefixes indentation only when an optional CSS rule exists, so absent reduced-motion clauses cannot leave whitespace-only lines. The same principle removes unconditional indentation before the keyframe block; the related regression test exercises a wipe transition and the regenerated storyboard passes git diff --check.",
            "markdown": "The generator now prefixes indentation only when an optional CSS rule exists, so absent reduced-motion clauses cannot leave whitespace-only lines. The same principle removes unconditional indentation before the keyframe block; the related regression test exercises a wipe transition and the regenerated storyboard passes git diff --check."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/animation/svg-generator.ts"
                },
                "region": {
                  "startLine": 1153,
                  "endLine": 1158,
                  "snippet": {
                    "text": "  const motionClasses = [needSlide ? `.fp-${i}` : \"\", needScale ? `.fz-${i}` : \"\", needExitScale ? `.fzo-${i}` : \"\", needReveal ? `.fr-${i}` : \"\"].filter(Boolean).join(\", \");\n  if (motionClasses !== \"\") {\n    keyframe += `\n    @media (prefers-reduced-motion: reduce) {\n      ${motionClasses} { animation: none; transform: none; clip-path: none; }\n${reducedMotion === \"cut\" ? `      .f-${i} { animation-timing-function: step-end; }\\n` : \"\"}    }`;"
                  }
                }
              }
            }
          ],
