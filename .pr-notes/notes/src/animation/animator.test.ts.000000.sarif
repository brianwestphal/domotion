          "message": {
            "text": "The unit contract proves three independent properties: zero and full-turn angles preserve the old output byte-for-byte, arbitrary angles emit more than ten fixed-eight-vertex samples, and a 90-degree half-progress clip reaches exactly half the viewport height.",
            "markdown": "The unit contract proves three independent properties: zero and full-turn angles preserve the old output byte-for-byte, arbitrary angles emit more than ten fixed-eight-vertex samples, and a 90-degree half-progress clip reaches exactly half the viewport height."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/animation/animator.test.ts"
                },
                "region": {
                  "startLine": 2010,
                  "endLine": 2045,
                  "snippet": {
                    "text": "  it(\"emits fixed-vertex polygon samples for an arbitrary angle\", () => {\n    const svg = render(35);\n    const block = svg.match(/@keyframes fr-1\\s*\\{((?:[^{}]|\\{[^{}]*\\})*)\\}/)?.[1] ?? \"\";\n    const polygons = [...block.matchAll(/polygon\\(([^)]*)\\)/g)].map((m) => m[1]);\n    expect(polygons.length).toBeGreaterThan(10);\n    expect(new Set(polygons.map((polygon) => polygon.split(\",\").length))).toEqual(new Set([8]));\n  });\n\n  it(\"maps 90 degrees to a top-to-bottom half-plane\", () => {\n    const clip = linearWipeClip(0.5, 400, 200, 90);\n    const ys = [...clip.matchAll(/[-\\d.]+px ([-\\d.]+)px/g)].map((m) => Number(m[1]));\n    expect(Math.min(...ys)).toBe(0);\n    expect(Math.max(...ys)).toBe(100);\n  });\n});\n"
                  }
                }
              }
            }
          ],
