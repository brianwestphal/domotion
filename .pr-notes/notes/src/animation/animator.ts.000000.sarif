          "level": "none",
          "guid": "msnwsb644xcvbfgm",
          "message": {
            "text": "Cut windows are half-open at their end: the outgoing frame remains opaque through the last pre-boundary epsilon and becomes transparent exactly when the incoming frame starts. This removes deterministic-but-wrong double compositing at a shared cut boundary while retaining the separate wide visibility track used for Firefox paint culling.",
            "markdown": "Cut windows are half-open at their end: the outgoing frame remains opaque through the last pre-boundary epsilon and becomes transparent exactly when the incoming frame starts. This removes deterministic-but-wrong double compositing at a shared cut boundary while retaining the separate wide visibility track used for Firefox paint culling."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/animation/animator.ts"
                },
                "region": {
                  "startLine": 387,
                  "endLine": 405,
                  "snippet": {
                    "text": "  const isCut = transType === \"cut\" || transDur === 0;\n  if (isCut) {\n    const startNum = parseFloat(startPct);\n    const endNum = parseFloat(transEndPct);\n    const beforeStart = padBefore(startNum, KEYFRAME_EPSILON.cull, 3);\n    const beforeEnd = padBefore(endNum, KEYFRAME_EPSILON.cull, 3);\n    // DM-1511: opacity does the cut (tight overlap, Firefox-safe); `visibility`\n    // is a SEPARATE wide-overlap paint-cull track so Firefox can't flash a\n    // transparent gap at the hand-off. (Previously one combined keyframe.)\n    keyframes.push(`\n    @keyframes fv-${i} {\n      0% { opacity: 0; }\n      ${beforeStart}% { opacity: 0; }\n      ${startNum.toFixed(3)}% { opacity: 1; }\n      ${beforeEnd}% { opacity: 1; }\n      ${endNum.toFixed(3)}% { opacity: 0; }\n      100% { opacity: 0; }\n    }${buildDisplayKeyframes(`fd-${i}`, startPct, transEndPct, totalSec)}\n    .f-${i} { animation: fv-${i} ${totalSec.toFixed(2)}s step-end infinite, fd-${i} ${totalSec.toFixed(2)}s step-end infinite; }`);"
                  }
                }
              }
            }
          ],
