                  "endLine": 636,
                  "snippet": {
                    "text": "  // DM-1996: explicitly bind the basic shape to the nearest SVG viewport.\n  // Leaving the geometry box implicit lets WebKit resolve the px coordinates\n  // against the clipped group's changing object bounds, shifting the apparent\n  // center and temporarily cropping an edge on rectangular scenes.\n  return \"polygon(\" + verts.map(([x, y]) => `${x.toFixed(2)}px ${y.toFixed(2)}px`).join(\", \") + \") view-box\";"
                  }
                }
              }
