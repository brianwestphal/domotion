          "guid": "mspphhjpiu9cn3ig",
          "message": {
            "text": "The VS retry now mirrors Blink’s full sequence decision, not just cmap coverage. It gates explicit pairs through Character::IsVariationSequence, synthesizes VS15/VS16 for every font-variant-emoji mode, uses actual SFNT color-table capability for presentation conflicts, applies segmented-face unicode-range to the base callback argument, leaves valid sequences whole in paths mode, and treats orphan default-ignorables as HarfBuzz-hidden rather than fallback misses. Focused unit tests cover positive/negative cmap-14, orphan selectors, explicit-property precedence, the one-shot ignore-VS reset, and a selector outside a webfont range; same-machine Chromium/Domotion cluster-conformance cells agree for standardized, emoji/text, invalid, orphan, and property-forced cases.",
            "markdown": "The VS retry now mirrors Blink’s full sequence decision, not just cmap coverage. It gates explicit pairs through Character::IsVariationSequence, synthesizes VS15/VS16 for every font-variant-emoji mode, uses actual SFNT color-table capability for presentation conflicts, applies segmented-face unicode-range to the base callback argument, leaves valid sequences whole in paths mode, and treats orphan default-ignorables as HarfBuzz-hidden rather than fallback misses. Focused unit tests cover positive/negative cmap-14, orphan selectors, explicit-property precedence, the one-shot ignore-VS reset, and a selector outside a webfont range; same-machine Chromium/Domotion cluster-conformance cells agree for standardized, emoji/text, invalid, orphan, and property-forced cases."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/render/cluster-fallback.ts"
                },
                "region": {
                  "startLine": 349,
                  "endLine": 370,
                  "snippet": {
                    "text": "/** Blink's `Character::IsVariationSequence` transcription\n * (`character_variation_sequences.cc`, Chromium rev 7d859f27). */\nexport function _isBlinkVariationSequenceForTest(base: number, selector: number): boolean {\n  if ((selector === 0xfe0e || selector === 0xfe0f) && isEmojiCharCp(base)) return true;\n  if (hasStandardizedVariationSequence(base, selector)) return true;\n  if (selector < 0xe0100 || selector > 0xe01ef) return false;\n  const ch = String.fromCodePoint(base);\n  return /\\p{Ideographic}/u.test(ch) && ch.normalize(\"NFD\") === ch && ch.normalize(\"NFKD\") === ch;\n}\n\nfunction collectVsSequences(\n  text: string, start: number, end: number, fve: FontVariantEmojiOverride | undefined,\n): VsSequence[] {\n  const out: VsSequence[] = [];\n  let prevIndex = -1;\n  let prevCp = 0;\n  let i = start;\n  while (i < end) {\n    const cp = text.codePointAt(i)!;\n    const len = cp > 0xffff ? 2 : 1;\n    if (isVariationSelectorCp(cp) && prevIndex >= 0 && !isVariationSelectorCp(prevCp)\n      && _isBlinkVariationSequenceForTest(prevCp, cp)) {"
                  }
                }
              }
            }
