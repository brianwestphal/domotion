              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/render/form-controls.ts"
                },
                "region": {
                  "startLine": 460,
                  "endLine": 467,
                  "snippet": {
                    "text": "export function checkablePseudoFactsOwnIndicator(el: CapturedElement): boolean {\n  const appearance = el.styles.effectiveAppearance ?? el.styles.inputAppearance;\n  return (appearance === \"none\" || appearance === \"base\")\n    && Array.isArray(el.pseudoFragments);\n}\n\nfunction renderCheckbox(el: CapturedElement, indent: string, defCtx?: DefCtx): string {\n  if (checkablePseudoFactsOwnIndicator(el)) return \"\";"
                  }
                }
              }
            }
