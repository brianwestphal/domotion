          "message": {
            "text": "An explicit pseudoFragments array is the modern ownership bit, including an empty array. Only undefined identifies a pre-contract tree eligible for generic tick/dot/switch compatibility; native auto is excluded by the resolved-appearance guard.",
            "markdown": "An explicit pseudoFragments array is the modern ownership bit, including an empty array. Only undefined identifies a pre-contract tree eligible for generic tick/dot/switch compatibility; native auto is excluded by the resolved-appearance guard."
          },
          "locations": [
