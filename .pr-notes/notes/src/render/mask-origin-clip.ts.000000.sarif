          "guid": "mt47p6djag63mnbo",
          "message": {
            "text": "Origin and clip stay separate because pinned Blink contracts NormalPositioningArea from FillLayer::Origin while EffectiveClip independently selects the destination. For no-clip, the capture viewport is a safe SVG superset of Blink visual overflow: the masked group has no ink outside its own overflow, and an explicit region avoids SVG default-mask cropping. Fragment threading is linked below.",
            "markdown": "Origin and clip stay separate because pinned Blink contracts NormalPositioningArea from FillLayer::Origin while EffectiveClip independently selects the destination. For no-clip, the capture viewport is a safe SVG superset of Blink visual overflow: the masked group has no ink outside its own overflow, and an explicit region avoids SVG default-mask cropping. Fragment threading is linked below."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/render/mask-origin-clip.ts"
                },
                "region": {
                  "startLine": 21,
                  "endLine": 36,
                  "snippet": {
                    "text": "export interface MaskOriginClipContext {\n  /** Computed, comma-separated `mask-origin` layer list. */\n  originCss: string;\n  /** Computed, comma-separated `mask-clip` layer list. */\n  clipCss: string;\n  /** Physical border widths, after effective CSS zoom. */\n  border: MaskPhysicalEdges;\n  /** Physical padding widths, after effective CSS zoom. */\n  padding: MaskPhysicalEdges;\n  /**\n   * A safe output-space superset of Blink's visual-overflow painting area.\n   * The masked SVG group cannot contribute ink outside its own visual\n   * overflow, so using the capture viewport is pixel-equivalent while keeping\n   * `mask-clip:no-clip` free from an artificial border-box intersection.\n   */\n  noClipPaintingArea?: MaskImageRect;"
                  }
                }
              }
            }
          ],
