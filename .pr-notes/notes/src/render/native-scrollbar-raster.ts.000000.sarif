          "guid": "mt46fxex598p8o9y",
          "message": {
            "text": "Native paint is an ordered viewport-space image boundary. Horizontal, vertical, and corner crops already contain platform paint, clip, opacity, and overlay backdrop, so this stage applies no theme synthesis, opacity, resampling, or element-local transform before the caller paints the resizer.",
            "markdown": "Native paint is an ordered viewport-space image boundary. Horizontal, vertical, and corner crops already contain platform paint, clip, opacity, and overlay backdrop, so this stage applies no theme synthesis, opacity, resampling, or element-local transform before the caller paints the resizer."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/render/native-scrollbar-raster.ts"
                },
                "region": {
                  "startLine": 42,
                  "endLine": 62,
                  "snippet": {
                    "text": "export function paintNativeScrollbarRasters(el: CapturedElement, indent: string): string[] {\n  const output: string[] = [];\n  for (const set of elementScrollbarSets(el)) {\n    if (set.status === \"absent\" || set.status === \"unavailable\") continue;\n    const horizontal = set.horizontal?.route === \"native-raster\"\n      ? paintRaster(set.horizontal.nativeRaster, \"horizontal\", `${indent}  `)\n      : null;\n    const vertical = set.vertical?.route === \"native-raster\"\n      ? paintRaster(set.vertical.nativeRaster, \"vertical\", `${indent}  `)\n      : null;\n    const corner = paintRaster(set.nativeCornerRaster, \"corner\", `${indent}  `);\n    const parts = [horizontal, vertical, corner].filter((part): part is string => part != null);\n    if (parts.length === 0) continue;\n    output.push(`${indent}<g data-domotion-scrollbar-route=\"native-raster\" data-domotion-scrollbar-phase=\"${set.paintPhase}\">`);\n    output.push(...parts);\n    output.push(`${indent}</g>`);\n  }\n  return output;\n}\n"
                  }
                }
              }
            }
          ],
