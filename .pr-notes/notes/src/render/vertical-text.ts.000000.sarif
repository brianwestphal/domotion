                "region": {
                  "startLine": 219,
                  "endLine": 226,
                  "snippet": {
                    "text": "  for (const seg of el.textSegments) {\n    if (seg.verticalWritingMode == null) continue;\n    const segText = seg.text;\n    const segFontSize = seg.fontSize ?? fontSize;\n    // DM-2193: the baseline belongs to the captured vertical run. New captures\n    // carry it on every column/combine segment; the element metric supports\n    // older captures, and 0.85em remains only for legacy trees with neither.\n    const segAscent = seg.fontAscent ?? el.fontAscent ?? segFontSize * 0.85;"
                  }
                }
              }
            }
