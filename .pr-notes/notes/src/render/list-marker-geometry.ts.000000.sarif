          "guid": "mstnfe6t2rc6lvi0",
          "message": {
            "text": "This preserves Blink integer arithmetic and marker-box accounting instead of fitting ratios to screenshots. The ordinary-symbol branch follows ListMarker::RelativeSymbolMarkerRect and InlineMarginsForOutside evaluation order; disclosure markers retain Blink’s 0.66 specified-font-size rule. Focused unit cases cover three ascent/font-size pairs and all symbol types.",
            "markdown": "This preserves Blink integer arithmetic and marker-box accounting instead of fitting ratios to screenshots. The ordinary-symbol branch follows ListMarker::RelativeSymbolMarkerRect and InlineMarginsForOutside evaluation order; disclosure markers retain Blink’s 0.66 specified-font-size rule. Focused unit cases cover three ascent/font-size pairs and all symbol types."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/render/list-marker-geometry.ts"
                },
                "region": {
                  "startLine": 13,
                  "endLine": 42,
                  "snippet": {
                    "text": "export function blinkSymbolMarkerGeometry(\n  ascent: number,\n  specifiedFontSize: number,\n  type: SymbolMarkerType,\n): SymbolMarkerGeometry {\n  const ascentInt = Math.trunc(ascent);\n  const disclosure = type === \"disclosure-open\" || type === \"disclosure-closed\";\n  if (disclosure) {\n    const size = specifiedFontSize * 0.66;\n    return {\n      markerInlineSize: size,\n      inlineOffset: 0,\n      blockOffset: ascentInt - size,\n      inlineSize: size,\n      blockSize: size,\n      outsideEndMargin: 8,\n    };\n  }\n  // Preserve C++ integer evaluation order from list_marker.cc.\n  const twoThirdsAscent = Math.trunc((ascentInt * 2) / 3);\n  const bulletWidth = Math.trunc((twoThirdsAscent + 1) / 2);\n  const markerInlineSize = bulletWidth + 2;\n  return {\n    markerInlineSize,\n    inlineOffset: 1,\n    blockOffset: Math.trunc((3 * (ascentInt - twoThirdsAscent)) / 2),\n    inlineSize: bulletWidth,\n    blockSize: bulletWidth,\n    outsideEndMargin: twoThirdsAscent + 8 - markerInlineSize,\n  };"
                  }
                }
              }
            }
          ],
          "properties": {
