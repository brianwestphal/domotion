          "guid": "mt3xesp1uhksa4mm",
          "message": {
            "text": "Reference geometry and visual ink are intentionally separate contracts. Blink resolves transform-origin from fill, stroke, or viewport geometry, while paint suppression needs the potentially larger emitted ink surface; merging them would make either the origin wrong or culling unsafe. Exact, empty, and unknown are closed states so no HTML carrier-box fallback can enter the decision.",
            "markdown": "Reference geometry and visual ink are intentionally separate contracts. Blink resolves transform-origin from fill, stroke, or viewport geometry, while paint suppression needs the potentially larger emitted ink surface; merging them would make either the origin wrong or culling unsafe. Exact, empty, and unknown are closed states so no HTML carrier-box fallback can enter the decision."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/render/culling-geometry.ts"
                },
                "region": {
                  "startLine": 40,
                  "endLine": 63,
                  "snippet": {
                    "text": "export type RendererVisualBounds =\n  | { kind: \"bounded\"; box: RendererCullBox }\n  | { kind: \"empty\" }\n  | { kind: \"unknown\"; reason: string };\n\nexport type RendererReferenceBox =\n  | { kind: \"exact\"; box: RendererCullBox }\n  | { kind: \"empty\" }\n  | { kind: \"unknown\"; reason: string };\n\nexport interface RendererOwnedCullGeometry {\n  /** Visual surface in the generated root SVG's user coordinate system. */\n  visualBounds: RendererVisualBounds;\n  /** Geometry of the generated animation wrapper before its own transform. */\n  referenceBoxes: {\n    fillBox: RendererReferenceBox;\n    strokeBox: RendererReferenceBox;\n    viewBox: RendererReferenceBox;\n  };\n  /** Static SVG wrapper exists on this element or an emitted ancestor. */\n  hasStaticTransformPath: boolean;\n  /** A descendant animation can make a container reference box time-varying. */\n  referenceBoxMayAnimate: boolean;\n}"
                  }
                }
              }
            }
          ],
