          "guid": "mt0q1ml8kq5f5r2x",
          "message": {
            "text": "Corner-shape keywords are aliases for Blink’s general curvature rule, not independently tuned SVG paths. This copies Superellipse::Exponent() (2^clamp(parameter,-16,16)) and its named parameter aliases from Chromium 7d859f271c.",
            "markdown": "Corner-shape keywords are aliases for Blink’s general curvature rule, not independently tuned SVG paths. This copies `Superellipse::Exponent()` (`2^clamp(parameter,-16,16)`) and its named parameter aliases from Chromium 7d859f271c."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/render/borders.ts"
                },
                "region": {
                  "startLine": 180,
                  "endLine": 194,
                  "snippet": {
                    "text": "/** Blink `Superellipse::Exponent()` (`2^parameter`, clamped to ±16). */\nexport function parseCornerShapeCurvature(value: string | undefined): number {\n  const keyword: Record<string, number> = {\n    notch: NOTCH_CURVATURE,\n    scoop: 0.5,\n    bevel: 1,\n    round: ROUND_CURVATURE,\n    squircle: 4,\n    square: STRAIGHT_CURVATURE,\n  };\n  const normalized = (value ?? \"round\").trim().toLowerCase();\n  if (keyword[normalized] != null) return keyword[normalized];\n  const match = /^superellipse\\(\\s*([-+]?\\d*\\.?\\d+(?:e[-+]?\\d+)?)\\s*\\)$/i.exec(normalized);\n  if (match == null) return ROUND_CURVATURE;\n  return Math.pow(2, Math.max(-16, Math.min(16, Number(match[1]))));"
                  }
                }
              }
            }
          ],
          "properties": {
