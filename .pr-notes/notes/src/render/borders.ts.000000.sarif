          "guid": "mt0qvq15m9ivurl6",
          "message": {
            "text": "This is a direct vector representation of Chromium PathBuilder::AddContouredRect’s four SkPathOps intersections: the same aligned corner curves and finite equivalents of its infinite half-plane paths, in TR/BR/BL/TL order. No curve sampling or fixture-specific intersection points are introduced.",
            "markdown": "This is a direct vector representation of Chromium `PathBuilder::AddContouredRect`’s four SkPathOps intersections: the same aligned corner curves and finite equivalents of its infinite half-plane paths, in TR/BR/BL/TL order. No curve sampling or fixture-specific intersection points are introduced."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/render/borders.ts"
                },
                "region": {
                  "startLine": 502,
                  "endLine": 521,
                  "snippet": {
                    "text": "\n/**\n * Chromium `PathBuilder::AddContouredRect` represents an inset ContouredRect as\n * `target rect ∩ TR corner ∩ BR corner ∩ BL corner ∩ TL corner`. SVG has no\n * path-intersection command, so callers nest these four vector clip paths in\n * the same order. `null` means this is an origin contour and needs one path.\n */\nexport function contouredRectIntersectionPaths(x: number, y: number, w: number, h: number, c: CornerRadii): string[] | null {\n  if (c.originRadii == null || c.contourInsets == null) return null;\n  const corners = contouredCornerGeometries(x, y, w, h, c);\n  const pad = Math.max(w, h, 1) * 4 + 1;\n  const left = x - pad, top = y - pad, right = x + w + pad, bottom = y + h + pad;\n  const curve = (corner: CornerGeometry) => cornerCommands(corner.start, corner.outer, corner.end, corner.center, corner.curvature);\n  return [\n    [`M${r(left)},${r(top)}`, ...curve(corners.tr), `L${r(right)},${r(bottom)}`, `L${r(left)},${r(bottom)}`, \"Z\"].join(\" \"),\n    [`M${r(right)},${r(top)}`, ...curve(corners.br), `L${r(left)},${r(bottom)}`, `L${r(left)},${r(top)}`, \"Z\"].join(\" \"),\n    [`M${r(right)},${r(bottom)}`, ...curve(corners.bl), `L${r(left)},${r(top)}`, `L${r(right)},${r(top)}`, \"Z\"].join(\" \"),\n    [`M${r(left)},${r(bottom)}`, ...curve(corners.tl), `L${r(right)},${r(top)}`, `L${r(right)},${r(bottom)}`, \"Z\"].join(\" \"),\n  ];\n}"
                  }
                }
              }
            }
          ],
