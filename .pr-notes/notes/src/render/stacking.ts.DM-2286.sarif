  "runs": [{"tool":{"driver":{"name":"glassbox","rules":[{"id":"DM-2286-flex-tree-order","shortDescription":{"text":"Keep ordinary flex items in their tree position"}}]}},"results":[{"ruleId":"DM-2286-flex-tree-order","level":"warning","message":{"text":"Blink paints a flex item atomically within its flex container; it does not promote an ordinary z:auto item into the enclosing stacking context. Domotion's two-phase walk already puts later block backgrounds before step-5 content, so the old hoist was redundant and reordered the item after later siblings' inline content."},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"src/render/stacking.ts"},"region":{"startLine":290}}}]}]}]
