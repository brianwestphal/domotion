          "message": {
            "text": "Synthesized small caps must override the general HarfBuzz run-grouping signal. Blink constructs a separately rounded-size font for synthesized caps; Domotion's per-character branch is where uppercase substitution and that rounded scale are applied, so grouping the run first silently restored full-size glyphs. The dedicated-script checks remain active, limiting this exception to ordinary caps synthesis.",
            "markdown": "Synthesized small caps must override the general HarfBuzz run-grouping signal. Blink constructs a separately rounded-size font for synthesized caps; Domotion's per-character branch is where uppercase substitution and that rounded scale are applied, so grouping the run first silently restored full-size glyphs. The dedicated-script checks remain active, limiting this exception to ordinary caps synthesis."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/render/text-to-path.ts"
                },
                "region": {
                  "startLine": 637,
