          "message": {
            "text": "renderTextAsPath now has a non-null, source-owned terminal: embedded declines enter paths with a recorded reason, successful vector/raster ownership is retained, and total failures become a labeled group containing no visible text or font-family request. This deliberately treats a missing helper outline as degraded source evidence; asking the consumer browser to resolve the authored family would select and shape a new run that Chromium never painted.",
            "markdown": "renderTextAsPath now has a non-null, source-owned terminal: embedded declines enter paths with a recorded reason, successful vector/raster ownership is retained, and total failures become a labeled group containing no visible text or font-family request. This deliberately treats a missing helper outline as degraded source evidence; asking the consumer browser to resolve the authored family would select and shape a new run that Chromium never painted."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/render/text-to-path.ts"
