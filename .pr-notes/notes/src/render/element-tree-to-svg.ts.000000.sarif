          "guid": "mt0unrdfvb1r0017",
          "message": {
            "text": "Integer outline geometry removes the zoom-dependent antialias residual at the same boundary Chromium uses. Blink constructs the outline region from integer gfx::Rects before outsetting; after restoring that boundary, the expanded oracle passes 128 of 128 cases at DSF 1 and 2 under zoom 0.8 and 1.25, with no tolerance change.",
            "markdown": "Integer outline geometry removes the zoom-dependent antialias residual at the same boundary Chromium uses. Blink constructs the outline region from integer gfx::Rects before outsetting; after restoring that boundary, the expanded oracle passes 128 of 128 cases at DSF 1 and 2 under zoom 0.8 and 1.25, with no tolerance change."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/render/element-tree-to-svg.ts"
                },
                "region": {
                  "startLine": 2601,
                  "endLine": 2616,
                  "snippet": {
                    "text": "      // DM-2324: ComplexOutlinePainter builds its right-angle region from\n      // integer gfx::Rects, outsets that region by the integer outline offset\n      // and width, then derives the center path.  getBoundingClientRect() is\n      // fractional, so retaining its edges here put otherwise-crisp 1--3 px\n      // dotted outlines between device pixels under CSS zoom.\n      if (borderRadius === 0) {\n        const width = Math.round(ow);\n        const outset = Math.round(offset) + width;\n        const outerLeft = Math.round(el.x) - outset;\n        const outerTop = Math.round(el.y) - outset;\n        const outerRight = Math.round(el.x + el.width) + outset;\n        const outerBottom = Math.round(el.y + el.height) + outset;\n        ox = outerLeft + width / 2;\n        oy = outerTop + width / 2;\n        owd = outerRight - outerLeft - width;\n        oh = outerBottom - outerTop - width;"
                  }
                }
              }
            }
          ],
