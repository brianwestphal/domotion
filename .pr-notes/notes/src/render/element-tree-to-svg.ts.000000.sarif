          "guid": "mssr1xp23qu6ujso",
          "message": {
            "text": "Backdrop-filter is emitted as a single Chromium-composited image boundary because SVG cannot sample the already-painted page backdrop from captured DOM geometry. Returning here is essential: the image already contains the element and descendants, so continuing the vector walk would double-paint the subtree. Focused fixtures measured 0.00% mismatch for 22-backdrop-filter and 0.01-0.04% for the two deep stacking cases.",
            "markdown": "Backdrop-filter is emitted as a single Chromium-composited image boundary because SVG cannot sample the already-painted page backdrop from captured DOM geometry. Returning here is essential: the image already contains the element and descendants, so continuing the vector walk would double-paint the subtree. Focused fixtures measured 0.00% mismatch for 22-backdrop-filter and 0.01-0.04% for the two deep stacking cases."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
