          "message": {
            "text": "Direct pseudo paint treats the captured fragment record as the sole geometry authority for new trees. Keeping the retired projection would create two independently mutable placements and could silently reintroduce host-first/last, half-leading, or wrap-threshold behavior; legacy serialized fields remain readable without generating those fields during new capture.",
            "markdown": "Direct pseudo paint treats the captured fragment record as the sole geometry authority for new trees. Keeping the retired projection would create two independently mutable placements and could silently reintroduce host-first/last, half-leading, or wrap-threshold behavior; legacy serialized fields remain readable without generating those fields during new capture."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/render/pseudo-fragments.ts"
                },
                "region": {
                  "startLine": 1,
                  "endLine": 8,
                  "snippet": {
                    "text": "/**\n * DM-2468: direct paint consumer for Blink-owned ::before/::after fragments.\n *\n * The capture record already owns anonymous-child boundaries, fragment order,\n * physical baselines/quads, and slice/clone edge ownership.  This module never\n * consults the host text box (or any of the legacy pseudo heuristics).  Invalid\n * records terminate at a non-painting diagnostic marker so stale host anchors\n * cannot silently become geometry again."
                  }
                }
              }
            }
          ],
          "properties": {
