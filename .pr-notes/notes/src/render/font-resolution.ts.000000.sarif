                "region": {
                  "startLine": 2858,
                  "endLine": 2865,
                  "snippet": {
                    "text": "export function stackPrimaryIsSystemUi(fontFamily: string | undefined): boolean {\n  if (fontFamily == null || fontFamily === \"\") return false;\n  for (const raw of fontFamily.split(\",\")) {\n    const family = raw.trim().replace(/^[\"']|[\"']$/g, \"\");\n    if (family === \"-apple-system\") continue;\n    return family === \"system-ui\" || family === \"BlinkMacSystemFont\";\n  }\n  return false;"
                  }
                }
              }
            }
          ],
