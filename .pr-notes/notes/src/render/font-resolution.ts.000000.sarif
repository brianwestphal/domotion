          "guid": "mso770mezqj847wd",
          "message": {
            "text": "Preserving Chromium’s concrete PostScript face eliminates primary and .notdef donor drift caused by rematching a family name. Before this path, the focused 351-stack matrix had 22/702 mismatches, including HiraKakuProN-W3 → HiraginoSans-W4; after registering the exact probed face it reports 0/702 across U+0041 and U+E000.",
            "markdown": "Preserving Chromium’s concrete PostScript face eliminates primary and `.notdef` donor drift caused by rematching a family name. Before this path, the focused 351-stack matrix had 22/702 mismatches, including `HiraKakuProN-W3 → HiraginoSans-W4`; after registering the exact probed face it reports 0/702 across U+0041 and U+E000."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/render/font-resolution.ts"
                },
                "region": {
                  "startLine": 7876,
                  "endLine": 7890,
                  "snippet": {
                    "text": "/** Materialize the concrete face Chromium reported for a session setting.\n * Prefer this over sending a PostScript name back through the curated family\n * table: that table intentionally collapses families, while the browser has\n * already completed style selection and told us the exact cut. */\nfunction sessionProbedFaceKey(faceName: string): string | null {\n  const installed = resolveInstalledFont(faceName);\n  if (installed == null || installed.path === \"\" || installed.postscriptName === \"\") return null;\n  const key = `sysfb:${installed.postscriptName}`;\n  registerDynamicSystemFont(\n    key, installed.path, installed.postscriptName, \"native\", installed.resolvedAxes, installed.ctAxes,\n  );\n  if (installed.familyName !== \"\" && !installed.familyName.startsWith(\".\")) {\n    declaredFamilyForKey.set(key, installed.familyName);\n  }\n  return key;"
                  }
                }
              }
            }
          ],
