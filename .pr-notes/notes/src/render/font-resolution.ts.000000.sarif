          "message": {
            "text": "A color bitmap primary can cover a codepoint without exposing an outline glyph. Primary-family selection therefore uses cmap coverage for supported color-table faces, while ordinary outline fonts retain the stricter glyph-id question; otherwise the emoji generic incorrectly falls out of Noto Color Emoji before Blink’s fallback iterator even begins.",
            "markdown": "A color bitmap primary can cover a codepoint without exposing an outline glyph. Primary-family selection therefore uses cmap coverage for supported color-table faces, while ordinary outline fonts retain the stricter glyph-id question; otherwise the emoji generic incorrectly falls out of Noto Color Emoji before Blink’s fallback iterator even begins."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
