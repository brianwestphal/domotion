          "message": {
            "text": "Preserving canonical spelling fixes the one family-name comparison that cannot survive global lower-casing. Focused CI showed Chromium routes quoted \"system-ui\" through the system font but walks past \"System-ui\"; both previously became the same internal name.",
            "markdown": "Preserving canonical spelling fixes the one family-name comparison that cannot survive global lower-casing. Focused CI showed Chromium routes quoted `\"system-ui\"` through the system font but walks past `\"System-ui\"`; both previously became the same internal name."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/render/font-resolution.ts"
                },
                "region": {
                  "startLine": 7702,
                  "endLine": 7724,
                  "snippet": {
                    "text": "interface FontFamilyStackEntry {\n  name: string;\n  generic: boolean;\n  /** Exact canonical spelling after quote removal. Family lookup is generally\n   * case-insensitive, but Blink's `system-ui` platform intercept is not. */\n  canonicalSystemUiName: boolean;\n}\n\n/** Normalize a computed `font-family` string into its ordered list of\n *  lower-cased, unquoted family names (Chrome's `getComputedStyle().fontFamily`\n *  is the full unresolved comma-separated stack), carrying the\n *  generic-keyword-vs-literal-name bit per entry (see FontFamilyStackEntry). */\nfunction splitFontFamilyNames(fontFamily: string): FontFamilyStackEntry[] {\n  return fontFamily.split(\",\").map((s) => {\n    const trimmed = s.trim();\n    const unquoted = trimmed.replace(/^[\"']|[\"']$/g, \"\");\n    const wasQuoted = unquoted !== trimmed;\n    const name = unquoted.toLowerCase();\n    return {\n      name,\n      generic: !wasQuoted && unquoted === name && BLINK_GENERIC_FAMILY_SPELLINGS.has(name),\n      canonicalSystemUiName: unquoted === \"system-ui\",\n    };"
                  }
                }
              }
            }
          ],
          "properties": {
            "tags": [
              "proof"
            ],
            "ext-ai-tool-confidence": 0.99
          },
          "relatedLocations": [
