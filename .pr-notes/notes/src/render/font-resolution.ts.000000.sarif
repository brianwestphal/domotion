                "region": {
                  "startLine": 7948,
                  "endLine": 7955,
                  "snippet": {
                    "text": "  if (generic && lang != null) {\n    const script = localeToScriptCodeForFontSelection(lang);\n    const probed = sessionGenericFamilyOverrides?.byScript.get(script)?.get(name);\n    if (probed != null) {\n      const key = matchFamilyNameToKey(probed.toLowerCase(), false);\n      if (key != null) return key;\n    }\n    const scriptValue = perScriptGenericFamily(hostPlatform(), lang, name);"
                  }
                }
              }
            }
