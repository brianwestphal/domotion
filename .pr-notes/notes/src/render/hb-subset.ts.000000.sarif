                  "endLine": 480,
                  "snippet": {
                    "text": "const EMBEDDED_KEEP_TABLES = new Set([\n  \"head\", \"hhea\", \"hmtx\", \"maxp\",                   // metrics\n  \"glyf\", \"loca\", \"CFF \", \"CFF2\",                 // outlines\n  \"cvt \", \"fpgm\", \"prep\", \"gasp\",                  // the hinting program\n  \"OS/2\", \"post\", \"name\",                          // identity + line metrics"
                  }
