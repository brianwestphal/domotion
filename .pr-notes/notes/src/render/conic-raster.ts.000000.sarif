          "guid": "mth85j3heffn11xy",
          "message": {
            "text": "DM-2620: exact generated pseudo fragments own background paint separately from their host. Conic fallback collection must use record.paint.backgroundImage and each boxFragments[].localBorderRect, matching renderPseudoFragmentRecord's cache-key geometry; walking only element.styles leaves an empty pseudo group.",
            "markdown": "DM-2620: exact generated pseudo fragments own background paint separately from their host. Conic fallback collection must use record.paint.backgroundImage and each boxFragments[].localBorderRect, matching renderPseudoFragmentRecord's cache-key geometry; walking only element.styles leaves an empty pseudo group."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/render/conic-raster.ts"
                },
                "region": {
                  "startLine": 94,
                  "endLine": 115,
                  "snippet": {
                    "text": "      // Generated pseudo boxes carry their own Blink-owned paint and geometry;\n      // they do not appear in the host element's `backgroundImage`. Collect\n      // each exact box-fragment tuple at the same local-border size consumed by\n      // `renderPseudoFragmentRecord`, so its conic layer cannot miss the cache.\n      for (const record of el.pseudoFragments ?? []) {\n        if (record.status !== \"exact\") continue;\n        const bgImage = record.paint.backgroundImage;\n        if (bgImage == null || bgImage === \"\" || bgImage === \"none\" || !/conic-gradient/i.test(bgImage)) continue;\n        const layers = splitTopLevelCommas(bgImage);\n        const sizes = splitTopLevelCommas(record.paint.backgroundSize || \"auto\");\n        for (const box of record.boxFragments) {\n          const rect = box.localBorderRect;\n          if (rect == null || !(rect.width > 0) || !(rect.height > 0)) continue;\n          for (let li = 0; li < layers.length; li++) {\n            const layer = layers[li].trim();\n            if (!/^(?:repeating-)?conic-gradient\\(/i.test(layer)) continue;\n            const sizeCss = (sizes[li] ?? sizes[0] ?? \"auto\").trim();\n            const tile = computeTileSize(sizeCss, rect.width, rect.height);\n            consider(layer, tile.w, tile.h);\n          }\n        }\n      }"
                  }
                }
              }
            }
          ],
