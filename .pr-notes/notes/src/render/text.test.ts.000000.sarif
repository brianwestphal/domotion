          "guid": "mt245iq0bw37ravd",
          "message": {
            "text": "The exact macOS regression now preserves vector geometry in both output modes while raster overlays own paint only. The focused unit suite passed 348 tests across text, text-to-path, cluster fallback, and run provenance; the exact text-font-variant-emoji feature fixture is pixel-clean at 0 regions / 0.00%; and renderer-font-route oracle v2 reports evidence-complete with both whole-sequence spans selected as Apple Color Emoji plus a disabled-route negative control.",
            "markdown": "The exact macOS regression now preserves vector geometry in both output modes while raster overlays own paint only. The focused unit suite passed 348 tests across text, text-to-path, cluster fallback, and run provenance; the exact text-font-variant-emoji feature fixture is pixel-clean at 0 regions / 0.00%; and renderer-font-route oracle v2 reports evidence-complete with both whole-sequence spans selected as Apple Color Emoji plus a disabled-route negative control."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/render/text.test.ts"
                },
                "region": {
                  "startLine": 118,
                  "endLine": 147,
                  "snippet": {
                    "text": "  it.skipIf(!MACOS_FONTS)(\"keeps the original whole sequence in vector shaping while overlays own only paint\", () => {\n    const render = (el: CapturedElement) => renderSingleLineText({\n      el, idPrefix: \"dm2410\", clipId: \"dm2410-clip\", fillColor: styles.color,\n    });\n    const overlays = [\n      {\n        charIndex: 0, charLength: 2, suppressGlyph: true,\n        rect: { x: 16, y: 20, width: 24, height: 24 },\n        dataUri: \"data:image/png;base64,AA==\",\n      },\n      {\n        charIndex: 3, charLength: 2, suppressGlyph: true,\n        rect: { x: 46, y: 20, width: 25, height: 25 },\n        dataUri: \"data:image/png;base64,BB==\",\n      },\n    ];\n\n    for (const mode of [\"paths\", \"embedded-font\"] as const) {\n      setRenderTextMode(mode);\n      const vectorOnly = render(element());\n      const withOverlays = render(element(overlays));\n\n      // Removing the two paint overlays must leave the byte-identical vector\n      // body. Before DM-2410, `suppressGlyphChars` rewrote the selected clusters\n      // to U+200B before shaping; the suffix then started at the zero-width-space\n      // advance instead of Chrome's captured xOffset, and this comparison failed.\n      expect(withOverlays.replace(/<image\\b[^>]*\\/>/g, \"\"), mode).toBe(vectorOnly);\n      expect(withOverlays, mode).toContain(`aria-label=\"${text}\"`);\n      expect(withOverlays.match(/<image\\b/g), mode).toHaveLength(2);\n    }"
                  }
                }
              }
            }
          ],
          "properties": {
