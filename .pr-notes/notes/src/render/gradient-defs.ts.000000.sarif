          "guid": "mszdmhkfdbo8kmmd",
          "message": {
            "text": "Opaque sRGB and linear-sRGB remain vector-native because SVG has exact interpolation selectors for those two spaces. Consuming the CSS interpolation clause before direction parsing prevents it from being mistaken for a color stop, and maps only the exactly representable pair; all other spaces are handled by the Chromium boundary.",
            "markdown": "Opaque sRGB and linear-sRGB remain vector-native because SVG has exact interpolation selectors for those two spaces. Consuming the CSS interpolation clause before direction parsing prevents it from being mistaken for a color stop, and maps only the exactly representable pair; all other spaces are handled by the Chromium boundary."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/render/gradient-defs.ts"
                },
                "region": {
                  "startLine": 15,
                  "endLine": 21,
                  "snippet": {
                    "text": "function consumeNativeInterpolationClause(value: string): { value: string; attribute: string } {\n  const match = /\\s+in\\s+(srgb-linear|srgb)\\b/i.exec(value);\n  if (match == null) return { value, attribute: \"\" };\n  return {\n    value: `${value.slice(0, match.index)}${value.slice(match.index + match[0].length)}`.trim(),\n    attribute: ` color-interpolation=\"${match[1].toLowerCase() === \"srgb-linear\" ? \"linearRGB\" : \"sRGB\"}\"`,\n  };"
                  }
                }
              }
            }
          ],
