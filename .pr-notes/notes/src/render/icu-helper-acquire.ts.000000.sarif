                  "endLine": 11,
                  "snippet": {
                    "text": "export const ICU_COMPANION_VERSION = \"78.2-domotion.1\";\nconst RELEASE_BASE = `https://github.com/brianwestphal/domotion/releases/download/icu-v${ICU_COMPANION_VERSION}`;"
