                  "uri": "src/render/icu-helper.ts"
                },
                "region": {
                  "startLine": 38,
                  "endLine": 42,
                  "snippet": {
                    "text": "// Routing normally asks about adjacent Unicode cells. A full structural scan\n// must not turn that into one helper launch per tiny page: 4K rows keep the\n// synchronous API practical while remaining well below the explicit buffer.\nconst PAGE_SIZE = 16_384;\nconst MAX_MEMO_ROWS = 65_536;"
                  }
                }
              }
            }
