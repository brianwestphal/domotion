                "region": {
                  "startLine": 328,
                  "endLine": 336,
                  "snippet": {
                    "text": "  // Capture entry point for this run: self-contained (inlines remote image\n  // bytes) unless the caller embeds the segments itself.\n  const capture = opts.embedImages === false ? captureElementTree : captureElementTreeSelfContained;\n  const captureSelector = opts.captureSelector ?? \"body\";\n  const captureViewport = opts.captureViewport ?? {\n    x: 0, y: 0, width: opts.viewportW, height: opts.viewportH,\n  };\n  const captureCurrentTree = (): Promise<CapturedElement[]> =>\n    capture(page, captureSelector, captureViewport);"
                  }
                }
              }
            }
          ],
