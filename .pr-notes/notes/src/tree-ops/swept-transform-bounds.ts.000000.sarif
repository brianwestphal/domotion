          "guid": "mt3vnrvqt4kkkabe",
          "message": {
            "text": "Independently timed fused tracks are deliberately over-bounded across each active partition. The animator currently bakes all fused tracks to piecewise linear stops when any track owns timing; an exact continuous easing subrange can exclude a chord emitted from neighboring stops. Using the whole active progress range loses correlation and culling opportunities, but contains every emitted chord until the renderer exposes its piecewise timeline directly.",
            "markdown": "Independently timed fused tracks are deliberately over-bounded across each active partition. The animator currently bakes all fused tracks to piecewise linear stops when any track owns timing; an exact continuous easing subrange can exclude a chord emitted from neighboring stops. Using the whole active progress range loses correlation and culling opportunities, but contains every emitted chord until the renderer exposes its piecewise timeline directly."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/tree-ops/swept-transform-bounds.ts"
                },
                "region": {
                  "startLine": 62,
                  "endLine": 68,
                  "snippet": {
                    "text": "  /**\n   * The animator bakes independently timed fused tracks to linear keyframe\n   * stops. Until that emitted piecewise curve is represented directly, use\n   * the track's whole active progress range in each overlapping partition.\n   * This loses correlation but contains every baked chord.\n   */\n  wholeActiveRange: boolean;"
                  }
                }
              }
            }
          ],
