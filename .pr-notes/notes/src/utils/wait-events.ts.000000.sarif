{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [{
    "tool": { "driver": { "name": "glassbox", "rules": [{
      "id": "DM-2275-font-readiness",
      "shortDescription": { "text": "Demand embedded fonts before awaiting FontFaceSet.ready" }
    }] } },
    "results": [{
      "ruleId": "DM-2275-font-readiness",
      "level": "warning",
      "message": {
        "text": "A top-level SVG can be navigated before its first text layout requests data-URL fonts. FontFaceSet.ready is already resolved in that state, so explicitly load every declared FontFace, await ready, force SVG text layout, and allow the activated face to cross the browser's paint pipeline before capture. This fixes a readiness race; it does not alter font routing or glyph geometry."
      },
      "locations": [{ "physicalLocation": { "artifactLocation": { "uri": "src/utils/wait-events.ts" }, "region": { "startLine": 20 } } }]
    }]
  }]
}
