          "message": {
            "text": "Roll comparison deliberately removes only revision identity fields. Host, flags, fonts, locale, helper, viewport, corpus, and cache isolation remain in the canonical fingerprint so browser drift cannot be confused with an environment change.",
            "markdown": "Roll comparison deliberately removes only revision identity fields. Host, flags, fonts, locale, helper, viewport, corpus, and cache isolation remain in the canonical fingerprint so browser drift cannot be confused with an environment change."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/review/roll-differential.ts"
                },
                "region": {
                  "startLine": 8,
                  "endLine": 18,
                  "snippet": {
                    "text": "  const environmentComparable=digest(comparable(oldRun.environmentFingerprint))===digest(comparable(newRun.environmentFingerprint));\n  const areas=[...new Set([...oldRun.reports.map(r=>r.area),...newRun.reports.map(r=>r.area)])].sort();\n  const stageChanges=areas.flatMap(area=>{const a=oldRun.reportPayloads?.[area]??oldRun.reports.find(r=>r.area===area);const b=newRun.reportPayloads?.[area]??newRun.reports.find(r=>r.area===area);return digest(a)===digest(b)?[]:[{area,oldDigest:digest(a),newDigest:digest(b)}]});\n  const ids=[...new Set([...Object.keys(oldRun.visuals??{}),...Object.keys(newRun.visuals??{})])].sort();\n  const visualChanges=ids.filter(id=>oldRun.visuals?.[id]?.digest!==newRun.visuals?.[id]?.digest).map(id=>({id,oldDigest:oldRun.visuals?.[id]?.digest,newDigest:newRun.visuals?.[id]?.digest}));\n  const missingReviews=stageChanges.map(x=>x.area).filter(area=>{const x=review?.reviewedAreas[area];return !x||x.sourceRefs.length===0||(x.classification!==\"no-semantic-change\"&&x.updatedRows.length===0)});\n  return {schemaVersion:1,environmentComparable,stageChanges,visualChanges,missingReviews,pass:environmentComparable&&missingReviews.length===0};\n}\n"
                  }
                }
              }
            }
          ],
