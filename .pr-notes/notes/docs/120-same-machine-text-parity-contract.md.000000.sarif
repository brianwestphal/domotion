          "guid": "msph0qb4pp5llysz",
          "message": {
            "text": "Logical parity is deliberately evaluated before pixels and scoped to one environment. A lucky raster match cannot validate a wrong face, while requiring identical faces across different font inventories would reject correct host-native Chromium behavior.",
            "markdown": "Logical parity is deliberately evaluated before pixels and scoped to one environment. A lucky raster match cannot validate a wrong face, while requiring identical faces across different font inventories would reject correct host-native Chromium behavior."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "docs/120-same-machine-text-parity-contract.md"
                },
                "region": {
                  "startLine": 17,
                  "endLine": 25,
                  "snippet": {
                    "text": "A different face or glyph sequence is a conformance failure even when its pixels\nhappen to score better. Pixel equality is not the logical oracle: after logical\nequality is established, minor differences caused solely by rasterization,\nhinting, or antialiasing are accepted and must be labeled as such.\n\nThis is a **same-machine** contract. Two hosts with different font inventories\nor preferences may legitimately choose different faces. Each host must agree\nwith Chromium running in that exact environment; cross-machine face equality is\nnot required."
                  }
                }
              }
            }
          ],
          "properties": {
            "tags": [
              "rationale"
            ],
            "ext-ai-tool-confidence": 0.99
          },
