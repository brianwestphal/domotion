{
  "$schema": "https://raw.githubusercontent.com/brianwestphal/domotion/main/schemas/animate-config.schema.json",
  "width": 700,
  "height": 200,
  "frames": [
    {
      "input": "./install.html",
      "duration": 1400,
      "transition": { "type": "cut", "duration": 0 },
      "overlays": [
        { "kind": "typing", "text": "npm install domotion-svg", "x": 34, "y": 67, "fontSize": 14, "color": "#c9d1d9", "speed": 55, "caret": true }
      ]
    },
    {
      "continue": true,
      "duration": 3300,
      "transition": { "type": "cut", "duration": 0 },
      "states": [
        { "actions": [{ "type": "evaluate", "script": "step(0)" }], "duration": 550 },
        { "actions": [{ "type": "evaluate", "script": "step(1)" }], "duration": 450 },
        { "actions": [{ "type": "evaluate", "script": "step(2)" }], "duration": 400 },
        { "actions": [{ "type": "evaluate", "script": "step(3)" }], "duration": 400 },
        { "actions": [{ "type": "evaluate", "script": "step(4)" }], "duration": 500 },
        { "actions": [{ "type": "evaluate", "script": "step(5)" }], "duration": 1000 }
      ]
    }
  ]
}
