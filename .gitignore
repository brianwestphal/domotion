tests/output/*
# DM-1802: a container run (scripts/test-linux-docker.sh) redirects its
# artifacts here so it cannot overwrite the host platform's tests/output.
tests/output-*/
# DM-987: the Windows DirectWrite font-routing sweep is committed (unlike the
# macOS/Linux sweeps, which regenerate locally) because a Windows box is the
# friction point — keeping the JSON in-tree lets contributors re-run
# tools/probe-983-genroutes-win32.mjs without one. (`tests/output/*` still
# ignores every other entry, including subdirectories, wholesale.)
!tests/output/unicode-fonts.win32.json
tests/cache/
examples/output/*.mp4
examples/output/*.webm
# Intermediate capture HTML the example scripts write next to their SVG output —
# scratch artifacts, regenerated on every run (DM-1334).
examples/output/*.html
node_modules/
external/
dist/
# ...except the vendored harfbuzzjs, which is a committed third-party artifact
# rather than a build output. Its wasm is rebuilt with Chromium's HarfBuzz
# configuration; `packages/text-engine/vendor/harfbuzzjs/README.md` has the reproduction recipe.
!packages/text-engine/vendor/harfbuzzjs/dist/
.release-state.json
*.map
.DS_Store
coverage/
scheduled_tasks.lock
test-results/
.env
.env.local
data/
*.tsbuildinfo
.tmp/
.chromium-build/
tools/unicode-fixtures/
packages/text-engine/tools/icu-helper/domotion-icu
packages/text-engine/tools/icu-helper/domotion-icu.exe
packages/text-engine/tools/icu-helper/icudtl.dat
packages/text-engine/tools/icu-helper/icuuc78.dll
packages/text-engine/tools/icu-helper/icudt78.dll

# Pre-workspace helper build artifacts may remain in an existing checkout after
# the tracked helper sources move into packages/text-engine/.
tools/icu-helper/domotion-icu
tools/icu-helper/domotion-icu.exe
tools/icu-helper/icudtl.dat
tools/icu-helper/icuuc78.dll
tools/icu-helper/icudt78.dll
tools/linux-glyph-extractor/build/
tools/linux-glyph-extractor/domotion-glyph-paths
tools/macos-glyph-extractor/.build/
tools/macos-glyph-extractor/domotion-glyph-paths
tools/win32-glyph-extractor/domotion-glyph-paths.exe

# Reusable-but-uncommitted scratch probes/tools (DM-1216 cleanup).
# The underscore-prefixed one-off debug scripts live here so they persist
# locally without cluttering `git status` or risking an accidental commit.
tools/scratch/

# The SYNTHETIC font-conformance stack corpus is a pure function of the rule in
# `tools/font-conformance-synthetic-stacks.ts` — regenerating it is
# byte-identical, identity string included. Committing it would create a second,
# hand-editable copy, and a hand-edited "synthetic" corpus is just a curated list
# with a misleading name. Regenerate with:
#   npx tsx tools/font-conformance-synthetic-stacks.ts
tools/font-conformance-stacks.synthetic.json

.mcp.json
.claude/settings.local.json
/.hotsheet/*
!/.hotsheet/settings.json
/.glassbox/*
!/.glassbox/settings.json
.hotsheet2/settings.local.json
.hotsheet2/store
