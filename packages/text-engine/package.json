{
  "name": "@domotion/text-engine",
  "version": "0.30.1",
  "private": true,
  "description": "Domotion's browser-faithful font resolution, shaping, and SVG text emission engine.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./font-resolution": {
      "types": "./dist/font-resolution.d.ts",
      "default": "./dist/font-resolution.js"
    },
    "./text": {
      "types": "./dist/text.d.ts",
      "default": "./dist/text.js"
    },
    "./capture": {
      "types": "./dist/capture.d.ts",
      "default": "./dist/capture.js"
    },
    "./helpers": {
      "types": "./dist/helpers.d.ts",
      "default": "./dist/helpers.js"
    },
    "./format": {
      "types": "./dist/format.d.ts",
      "default": "./dist/format.js"
    },
    "./diagnostics": {
      "types": "./dist/diagnostics.d.ts",
      "default": "./dist/diagnostics.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "files": [
    "dist",
    "assets",
    "tools",
    "vendor",
    "README.md"
  ],
  "scripts": {
    "clean": "tsc -b tsconfig.build.json --clean",
    "build": "npm run clean && tsc -p tsconfig.build.json && node tools/check-runtime-import.mjs",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && npm run test:unit && npm run test:transport-performance",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:transport-performance": "vitest run --config vitest.performance.config.ts",
    "conformance": "npm run build && npm run text-engine:conformance --prefix ../.."
  },
  "dependencies": {
    "bidi-js": "^1.0.3",
    "fontkit": "^2.0.4",
    "svg2ttf": "^6.1.0",
    "unicode-properties": "^1.4.1"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "typescript": "^5.8.3",
    "vitest": "^5.0.1"
  }
}
