    "fonts:paths-raster:linux-mathml:collect": "tsx tools/linux-mathml-greek-raster-collector.ts",
    "fonts:paths-raster:linux-mathml:gate": "tsx tools/linux-mathml-greek-raster-gate.ts",
    "fonts:sfns-mask-baseline": "npm run build:capture-script && tsx tools/sfns-mask-baseline-oracle.ts",
    "fonts:sfns-outline:adjudicate": "node --import tsx tools/sfns-outline-parity-gate.ts",
    "fonts:sfns-pinned-ots:build": "node tools/build-sfns-pinned-ots-sanitizer.mjs",
    "fonts:sfns-pinned-skia:build": "node tools/build-sfns-pinned-skia-collector.mjs",
    "fonts:sfns-pinned-skia:collect": "node --import tsx tools/sfns-pinned-skia-mask-collector.ts",
    "fonts:sfns-pinned-skia:validate": "vitest run tests/sfns-terminal-mask-manifest.test.ts tests/sfns-pinned-skia-mask-schema.test.ts",
    "fonts:sfns-pinned-chromium:build": "node tools/build-sfns-pinned-chromium-validator.mjs",
    "fonts:sfns-pinned-chromium:collect": "node --import tsx tools/sfns-pinned-chromium-validation-collector.ts",
    "fonts:sfns-pinned-chromium:validate": "vitest run tests/sfns-pinned-chromium-validation-schema.test.ts",
    "fonts:sfns-terminal-mask:adjudicate": "node --import tsx tools/sfns-terminal-mask-adjudicator.ts",
    "fonts:sfns-terminal-mask:validate": "vitest run tests/sfns-terminal-mask-manifest.test.ts tests/sfns-pinned-skia-mask-schema.test.ts tests/sfns-pinned-chromium-validation-schema.test.ts tests/sfns-terminal-mask-adjudicator.test.ts",
    "stage:evidence:collect": "tsx tools/collect-stage-evidence.ts",
    "stage:evidence:build": "tsx tools/build-stage-evidence.ts",
    "stage:evidence:compare-roll": "tsx tools/compare-roll-evidence.ts",
    "stage:evidence:source-drift": "tsx tools/source-drift-evidence.ts",
    "demos:examples": "npm run build:capture-script && tsx examples/terminal-demo.ts && tsx examples/terminal-onboarding.ts && tsx examples/progress-install.ts && tsx examples/hero-product-demo.ts && tsx examples/showcase-rendering.ts && tsx examples/showcase-transitions.ts && tsx examples/transition-tour.ts && tsx examples/transition-mixed.ts && tsx examples/svg-to-video-demo.ts && tsx examples/templates-demo.ts && tsx examples/brand-capture-demo.ts && tsx examples/kinetic-over-capture.ts && tsx examples/format-capture-demo.ts && tsx examples/terminal-window-scroll.ts && tsx examples/storyboard-demo.ts",
    "check:features": "tsx tools/check-feature-coverage.ts",
    "check:parity-program": "node tools/check-parity-program.mjs",
    "check:semantic-coverage": "tsx tools/check-semantic-coverage.ts",
    "check:activation-coverage": "tsx tools/check-activation-coverage.ts",
    "gate:parity-release": "tsx tools/check-parity-release.ts",
    "site:dev": "cd site && npm install && npm run dev",
    "site:build": "cd site && npm install && npm run build",
    "site:preview": "cd site && npm install && npm run preview"
