{
  "name": "domotion-svg",
  "version": "0.24.0",
  "description": "DOM-to-animated-SVG renderer. Captures HTML/CSS via Playwright Chromium and converts it to self-contained SVG with CSS animations — pixel-faithful demos that scale crisply and load lazily.",
  "license": "MIT",
  "author": "Brian Westphal",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brianwestphal/domotion.git"
  },
  "homepage": "https://github.com/brianwestphal/domotion#readme",
  "bugs": {
    "url": "https://github.com/brianwestphal/domotion/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "domotion": "dist/cli/index.js",
    "svg-to-video": "dist/cli/svg-to-video.js",
    "svg-to-image": "dist/cli/svg-to-image.js",
    "svg-review": "dist/cli/review.js",
    "svg-scrubber": "dist/cli/scrubber.js"
  },
  "files": [
    "dist",
    "vendor",
    "assets",
    "schemas",
    "FEATURES.md",
    "LICENSE",
    "README.md",
    "llms.txt"
  ],
  "scripts": {
    "build:capture-script": "node scripts/build-capture-script.mjs",
    "build:review-client": "node scripts/build-review-client.mjs",
    "build:scrubber-client": "node scripts/build-scrubber-client.mjs",
    "docs:index:generate": "node scripts/documentation-index.mjs --write",
    "docs:index:check": "node scripts/documentation-index.mjs",
    "build:animate-schema": "tsx scripts/generate-animate-schema.ts",
    "build:composite-schema": "tsx scripts/generate-composite-schema.ts",
    "build:storyboard-schema": "tsx scripts/generate-storyboard-schema.ts",
    "mathml:operator-dictionary:generate": "node tools/generate-mathml-operator-dictionary.mjs",
    "mathml:operator-dictionary:check": "node tools/generate-mathml-operator-dictionary.mjs --check",
    "unicode:cjk-property:generate": "node tools/generate-cjk-ideograph-or-symbol-ranges.mjs",
    "unicode:cjk-property:check": "node tools/generate-cjk-ideograph-or-symbol-ranges.mjs --check",
    "unicode:vertical-orientation:generate": "node tools/generate-vertical-orientation-ranges.mjs",
    "unicode:vertical-orientation:check": "node tools/generate-vertical-orientation-ranges.mjs --check",
    "unicode:vertical-orientation:oracle": "node --import tsx tools/vertical-orientation-oracle.ts",
    "build": "npm run build:capture-script && npm run build:review-client && npm run build:scrubber-client && npm run build:animate-schema && npm run build:composite-schema && npm run build:storyboard-schema && tsc -p tsconfig.build.json",
    "typecheck": "npm run build:capture-script && npm run build:review-client && npm run build:scrubber-client && tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "capture": "npm run build:capture-script && tsx src/cli/index.ts",
    "test": "npm run build:capture-script && vitest run",
    "test:e2e": "npm run build:capture-script && vitest run --config vitest.e2e.config.ts",
    "test:coverage": "npm run build:capture-script && vitest run --coverage",
    "test:coverage:all": "npm run build:capture-script && node tools/coverage-all.mjs",
    "test:coverage:full": "npm run build:capture-script && node tools/coverage-all.mjs --full",
    "release": "bash scripts/release.sh",
    "release:beta": "bash scripts/release.sh --beta",
    "commit-msg": "gitgist --staged --commit-message",
    "test:watch": "npm run build:capture-script && vitest",
    "test:linux-docker": "bash scripts/test-linux-docker.sh",
    "test:linux-system-ui-alternate": "FONTCONFIG_FILE=/work/tests/fontconfig/alternate-system-ui.conf CMD='apt-get update && apt-get install -y --no-install-recommends fonts-dejavu-core build-essential cmake pkg-config libfreetype-dev libfontconfig-dev && bash tools/linux-glyph-extractor/build.sh && npx tsx tools/assert-linux-system-ui-profile.ts && npm run fonts:conformance -- --stack-filter system-ui --range 0020-007f,0600-06ff,4e00-4e7f --max-rows 2000 --reset-every 1 --out tests/output/font-conformance-system-ui-alternate' bash scripts/test-linux-docker.sh",
    "test:linux-fallback-diagnostics": "CMD='apt-get update && apt-get install -y --no-install-recommends build-essential cmake pkg-config libfreetype-dev libfontconfig-dev && bash tools/linux-glyph-extractor/build.sh && npx tsx tools/probe-linux-fallback-diagnostics.ts' bash scripts/test-linux-docker.sh",
    "demos:test": "npm run build:capture-script && tsx tests/features.ts",
    "demos:test:showcase": "npm run build:capture-script && tsx tests/showcase.tsx",
    "demos:test:html": "npm run build:capture-script && tsx tests/html-test-suite.tsx",
    "demos:test:unicode": "npm run build:capture-script && HTML_TEST_DIR=${HTML_TEST_DIR:-../html-test/unicode} HTML_TEST_OUTPUT_DIR=${HTML_TEST_OUTPUT_DIR:-tests/output/html-test-unicode} tsx tests/html-test-suite.tsx",
    "demos:test:real-world": "npm run build:capture-script && tsx tests/real-world.tsx",
    "demos:test:snapshot-isolation": "npm run build:capture-script && tsx tests/snapshot-isolation.tsx",
    "demos:test:animate": "npm run build:capture-script && tsx tests/animate-examples.tsx",
    "demos:test:ci-fast": "node scripts/ci-run-fast-visuals.mjs",
    "parity:composed-corpus": "node scripts/run-composed-parity.mjs",
    "demos:test:all": "npm run build:capture-script && (tsx tests/features.ts ; tsx tests/snapshot-isolation.tsx ; tsx tests/showcase.tsx ; tsx tests/animate-examples.tsx ; tsx tests/html-test-suite.tsx ; tsx tests/real-world.tsx)",
    "demos:review": "tsx tests/review-server.tsx",
    "fonts:conformance": "tsx tools/font-conformance.ts",
    "fonts:icu-conformance": "tsx tools/icu-conformance.ts",
    "fonts:linux-arm64-release": "node --import tsx tools/linux-arm64-release-evidence.ts",
    "fonts:generic-preferences": "node --import tsx tools/generic-family-preference-oracle.ts",
    "fonts:generic-profile-target": "node --import tsx tools/generic-profile-target-oracle.ts",
    "fonts:system-ui-preferences": "node --import tsx tools/system-ui-preference-route-oracle.ts",
    "fonts:generic-family-semantics": "node --import tsx tools/generic-family-semantics-audit.ts",
    "fonts:emoji-presentation-ownership-audit": "node --import tsx tools/emoji-presentation-ownership-audit.ts",
    "fonts:palette-ownership-audit": "node --import tsx tools/font-palette-ownership-audit.ts",
    "fonts:palette-paint-gate": "node --import tsx tools/font-palette-paint-gate.ts",
    "fonts:conformance:iterate": "node scripts/font-conformance-iterate.mjs",
    "fonts:conformance:stacks": "tsx tools/font-conformance.ts --extract-stacks",
    "fonts:cluster-conformance": "tsx tools/cluster-conformance.ts",
    "fonts:inventory": "node tools/font-inventory.mjs",
    "fonts:shaping": "tsx tools/shaping-conformance.ts",
    "fonts:shaping:runs": "tsx tools/shaping-conformance.ts --extract-runs",
    "fonts:shaping:unicode": "tsx tools/shaping-unicode-corpus.ts",
    "fonts:shaper-ab": "tsx tools/shape-agreement.ts",
    "fonts:shaping:exact": "tsx tools/exact-shaping-oracle.ts",
    "fonts:shaping:unified": "tsx tools/unified-shaping-oracle.ts",
    "fonts:browser-harfbuzz-substitutions": "node --import tsx tools/browser-harfbuzz-substitution-oracle.ts",
    "fonts:renderer-route": "tsx tools/renderer-font-route-oracle.ts",
    "fonts:shaped-origin": "tsx tools/shaped-origin-oracle.ts",
    "fonts:mixed-bidi-logical": "node --import tsx tools/mixed-bidi-logical-oracle.ts",
    "fonts:synthetic-bold-paint": "node --import tsx tools/synthetic-bold-paint-oracle.ts",
    "fonts:mathml-italic": "npm run build:capture-script && vitest run --config vitest.e2e.config.ts tests/mathml-italic-token.e2e.test.ts",
    "fonts:layout:oracle": "tsx tools/layout-stage-oracle.ts",
    "fonts:ideograph-cache:oracle": "tsx tools/ideograph-fallback-cache-oracle.ts",
    "fonts:family-match": "tsx tools/family-match-conformance.ts",
    "fonts:family-match:linux": "tsx tools/family-match-conformance-linux.ts",
    "fonts:family-match:win32": "tsx tools/family-match-conformance-win32.ts",
    "decorations:oracle": "tsx tools/decoration-oracle.ts",
    "decorations:vertical-oracle": "vitest run tests/vertical-decoration-oracle.test.ts tests/vertical-decoration-browser-oracle.test.ts",
    "borders:phase-oracle": "tsx tools/border-phase-oracle.ts",
    "borders:phase-ratify": "tsx tools/border-phase-ratifier.ts",
    "borders:collapsed-fragmentation-audit": "node --import tsx tools/collapsed-border-fragmentation-oracle.ts",
    "borders:paged-collapsed-ownership-audit": "node --import tsx tools/paged-collapsed-table-ownership-audit.ts",
    "borders:paged-table-renderer:build": "node tools/build-paged-table-pinned-chromium-helper.mjs",
    "borders:paged-table-renderer:collect": "node --import tsx tools/paged-table-renderer-evidence-collector.ts",
    "borders:paged-table-renderer:validate": "vitest run tests/paged-table-renderer-evidence-schema.test.ts tests/paged-collapsed-table-ownership-audit.test.ts",
    "borders:fragmented-release-gate": "node --import tsx tools/fragmented-collapsed-table-release-gate.ts",
    "paint:geometry-oracle": "tsx tools/paint-geometry-oracle.ts",
    "paint:geometry-browser-oracle": "tsx tools/paint-geometry-browser-oracle.ts",
    "paint:svg-effect-combinations": "node --import tsx tools/svg-effect-combination-oracle.ts",
    "transform:geometry-oracle": "tsx tools/transform-geometry-oracle.ts",
    "culling:animated-geometry-oracle": "tsx tools/animated-culling-geometry-oracle.ts",
    "transform:text-geometry-audit": "tsx tools/text-transform-geometry-audit.ts",
    "transform:text-parity-gate": "tsx tools/text-transform-geometry-audit.ts",
    "transform:text-baseline-protocol": "node --import tsx tools/text-affine-baseline-protocol-oracle.ts",
    "animation:raf-clock-ownership": "vitest run --config vitest.e2e.config.ts tests/raf-clock.e2e.test.ts tests/raf-clock-workflow.test.ts",
    "transform:text-fragment-spans": "npm run build:capture-script && node --import tsx tools/text-fragment-span-oracle.ts",
    "transform:text-fragment-protocol": "npm run build:capture-script && vitest run src/capture/text-fragment-geometry.test.ts && vitest run --config vitest.e2e.config.ts tests/text-paint-geometry.e2e.test.ts",
    "transform:inline-svg-3d-audit": "tsx tools/inline-svg-3d-audit.ts",
    "transform:animated-3d-frame-gate": "tsx tools/animated-projective-frame-oracle.ts",
    "transform:nested-projective-owner-audit": "node --import tsx tools/nested-projective-ownership-audit.ts",
    "transform:projective-owner-producer": "node --import tsx tools/projective-owner-release-producer.ts",
    "transform:projective-owner-release": "node --import tsx tools/check-projective-owner-release.ts",
    "pseudo:fragment-geometry-oracle": "node --import tsx tools/pseudo-fragment-geometry-oracle.ts",
    "pseudo:fragment-render-oracle": "node --import tsx tools/pseudo-fragment-render-oracle.ts",
    "pseudo:backdrop-source-oracle": "node --import tsx tools/pseudo-backdrop-source-oracle.ts",
    "paint:summary-marker-oracle": "npm run build:capture-script && vitest run --config vitest.e2e.config.ts tests/summary-disclosure-marker.e2e.test.ts",
    "forms:native-fallback-gate": "node --import tsx tools/native-control-fallback-gate.ts",
    "forms:native-fallback-browser": "npm run build:capture-script && vitest run --config vitest.e2e.config.ts tests/native-control-fallback-activation.e2e.test.ts tests/effective-appearance.e2e.test.ts tests/native-control-decoration.e2e.test.ts tests/native-control-source-frame.e2e.test.ts tests/checkable-pseudo-indicators.e2e.test.ts tests/summary-disclosure-marker.e2e.test.ts",
    "background:url-geometry-audit": "tsx tools/url-background-geometry-audit.ts",
    "background:clip-text-oracle": "node --import tsx tools/background-clip-text-oracle.ts",
    "media:frame-ownership-audit": "node --import tsx tools/live-replaced-media-ownership-audit.ts",
    "media:animated-image-frame-audit": "node --import tsx tools/animated-image-frame-selection-audit-cli.ts",
    "media:animated-image-production-release": "node --import tsx tools/animated-image-production-release-gate-cli.ts",
    "mask:origin-clip-oracle": "npm run build:capture-script && vitest run --config vitest.e2e.config.ts tests/mask-origin-clip.e2e.test.ts tests/mask-url-repeat-geometry.e2e.test.ts",
    "scrollbars:ownership-audit": "tsx tools/native-scrollbar-ownership-audit.ts",
    "scrollbars:parity-gate": "tsx tools/check-native-scrollbar-release.ts",
    "paint:order-oracle": "tsx tools/paint-order-oracle.ts",
    "paint:blend-filter-stage": "node --import tsx tools/blend-filter-pixel-stage-oracle.ts",
    "paint:mixed-color-space-stage": "node --import tsx tools/mixed-reference-color-space-oracle.ts",
    "paint:backdrop-source-audit": "node --import tsx tools/backdrop-source-surface-audit.ts --strict",
    "replaced:geometry-oracle": "node --import tsx tools/replaced-geometry-oracle.ts",
    "replaced:ownership-gate": "node --import tsx tools/replaced-geometry-oracle.ts --dpr 1,2",
    "raster:boundary-oracle": "tsx tools/raster-boundary-oracle.ts",
    "broken-image:hybrid-e2e": "vitest run --config vitest.e2e.config.ts src/capture/broken-image-fallback.e2e.test.ts tests/broken-image-fallback-render.e2e.test.ts",
    "broken-image:parity-gate": "tsx tools/broken-image-fallback-oracle.ts",
    "fonts:macos-terminal-raster": "tsx tools/macos-terminal-raster-oracle.ts",
    "fonts:paths-raster:collect": "tsx tools/paths-native-raster-collector.ts",
    "fonts:paths-raster:produce": "tsx tools/paths-native-raster-producer.ts",
